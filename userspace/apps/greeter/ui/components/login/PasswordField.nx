//
// The password capsule: a secure field bound to `SessionStore.secret` and the arrow that
// submits it (`Submit` → `svc.session.login`; the store clears the secret on every answer, and
// nothing logs it). A failed attempt shakes the capsule (`lastError` changes) and turns its
// outline `danger` while the failure shows (`phase == 2`). The design has no reveal button
// (decision Q4). The capsule is two arms because a border colour is a role literal, not data;
// the field and the arrow are `PasswordRow`'s.
Component PasswordField {
    if $state.phase == 2 {
        Stack {
            PasswordRow { }
        }
        .height(44)
        .paddingLeading(16)
        .paddingTrailing(16)
        .material(panel)
        .rounded(full)
        .border(hairline)
        .borderColor(danger)
        .shadow(shadow1, shadow3)
        .effect(wiggle, trigger: $state.lastError)
    } else {
        Stack {
            PasswordRow { }
        }
        .height(44)
        .paddingLeading(16)
        .paddingTrailing(16)
        .material(panel)
        .rounded(full)
        .shadow(shadow1, shadow3)
        .effect(wiggle, trigger: $state.lastError)
    }
}

// The inside of the capsule: the bare capsule-shaped field (so its placeholder reads
// `labelSecondary` on the wallpaper; size `lg` = headline 15 medium) and the submit arrow.
Component PasswordRow {
    Stack {
        TextField {
            placeholder: @t("greeter.secret"),
            value: $state.secret,
            secure: true,
            variant: "bare",
            shape: "capsule",
            size: "lg",
        }
        .grow(1)
        .label(@t("greeter.secret"))
        Circle {
            size: 30,
            Icon {
                symbol: "arrow.right",
                size: 17,
            }
            .fg(label)
        }
        .bg(glassCard)
        .border(hairline)
        .borderColor(glassEdge)
        .shadow(shadow1, edgeHighlight)
        .label(@t("greeter.login"))
        on Tap -> dispatch(Submit)
    }
    .direction(row)
    .align(center)
    .gap(8)
}
