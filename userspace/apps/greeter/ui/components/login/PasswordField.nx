//
// The password capsule: a secure field bound to `SessionStore.secret` and the arrow that
// submits it (`Submit` → `svc.session.login`; the store clears the secret on every answer, and
// nothing logs it). A failed attempt shakes the capsule (`lastError` changes). The design has
// no reveal button (decision Q4).
Component PasswordField {
    Stack {
        TextField {
            placeholder: @t("greeter.secret"),
            value: $state.secret,
            secure: true,
            variant: "bare",
        }
        .grow(1)
        .label(@t("greeter.secret"))
        Circle {
            size: 30,
            Icon {
                symbol: "arrow.right",
                size: 17,
            }
            .fg(label)
        }
        .bg(fill)
        .label(@t("greeter.login"))
        on Tap -> dispatch(Submit)
    }
    .direction(row)
    .align(center)
    .gap(8)
    .height(44)
    .paddingLeading(20)
    .paddingTrailing(8)
    .material(panel)
    .rounded(full)
    .shadow(shadow3)
    .effect(wiggle, trigger: $state.lastError)
}
