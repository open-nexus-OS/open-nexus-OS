Window {
    style: plain,
    mode: auto,
    level: desktop,
    resizable: false,
}

Page GreeterPage {
    Stack {
        Stack {
            Stack {
                Text($state.date).textSize(lg).fontWeight(semibold).fg(onGlassMuted).textShadow(strong)
                if device.sizeClass == "compact" {
                    Text($state.clock).textSize(display).fontWeight(light).leading(flat).fg(onGlass).textShadow(soft)
                } else {
                    Text($state.clock).textSize(hero).fontWeight(light).leading(flat).fg(onGlass).textShadow(soft)
                }
            }
            .align(center)
            .gap(1)
            .paddingY(4)
            .transition(fade)
            Spacer
            Stack {
                List($state.users) { user in
                    Stack {
                        if user.id == $state.selected {
                            Stack {
                                Avatar {
                                    name: user.label,
                                    size: 88,
                                }
                                .material(card)
                                .textSize(display)
                                .fg(onGlass)
                                .shadow(xl)
                                Text(user.label).textSize(xl).fontWeight(semibold).fg(onGlass).textShadow(soft)
                            }
                            .align(center)
                            .gap(3)
                        } else {
                            Stack
                        }
                    }
                    .key(user.id)
                }
                .align(center)
                Stack {
                    TextField {
                        placeholder: @t("greeter.secret"),
                        value: $state.secret,
                        secure: true,
                        variant: "bare",
                    }
                    .grow(1)
                    .label(@t("greeter.secret"))
                    Circle {
                        size: 30,
                        Icon {
                            symbol: "arrow.right",
                            size: 17,
                        }
                        .fg(glassIcon)
                    }
                    .bg(glassFill)
                    .label(@t("greeter.login"))
                    on Tap -> dispatch(Submit)
                }
                .direction(row)
                .align(center)
                .gap(2)
                .height(44)
                .paddingLeading(5)
                .paddingTrailing(2)
                .material(panel)
                .rounded(full)
                .shadow(xl)
                .effect(wiggle, trigger: $state.lastError)
                if $state.phase == 1 {
                    Text(@t("greeter.authenticating")).textSize(sm).fg(onGlassMuted).textShadow(strong)
                } else {
                    if $state.phase == 2 {
                        Text(@t("greeter.failed")).textSize(sm).fg(danger).textShadow(strong)
                    } else {
                        Text(@t("greeter.hint")).textSize(sm).fg(onGlassMuted).textShadow(strong)
                    }
                }
            }
            .align(center)
            .gap(4)
            .width(340)
            .transition(slideUp)
            Spacer
            Stack {
                Stack {
                    List($state.users) { user in
                        Stack {
                            if user.id == $state.selected {
                                Stack
                            } else {
                                Stack {
                                    Avatar {
                                        name: user.label,
                                        size: 44,
                                    }
                                    .material(card)
                                    .fg(onGlass)
                                    .shadow(lg)
                                    Text(user.label).textSize(xs).fontWeight(semibold).fg(onGlassMuted).textShadow(strong)
                                }
                                .align(center)
                                .gap(1)
                            }
                        }
                        .key(user.id)
                        on Tap -> dispatch(Pick(user.id))
                    }
                    .direction(row)
                    .gap(4)
                }
                Spacer
                Stack {
                    Circle {
                        size: 44,
                        Icon {
                            symbol: "moon",
                            size: 17,
                        }
                        .fg(glassIcon)
                    }
                    .material(panel)
                    .shadow(lg)
                    .label(@t("greeter.sleep"))
                    Circle {
                        size: 44,
                        Icon {
                            symbol: "arrow.counterclockwise",
                            size: 17,
                        }
                        .fg(glassIcon)
                    }
                    .material(panel)
                    .shadow(lg)
                    .label(@t("greeter.restart"))
                    Circle {
                        size: 44,
                        Icon {
                            symbol: "power",
                            size: 17,
                        }
                        .fg(glassIcon)
                    }
                    .material(panel)
                    .shadow(lg)
                    .label(@t("greeter.shutdown"))
                }
                .direction(row)
                .align(center)
                .gap(3)
            }
            .direction(row)
            .align(end)
            .paddingX(6)
            .paddingY(4)
        }
        .grow(1)
        .bg(wallpaperTint)
    }
    .bgFade(transparent, wallpaperVignette)
}
