//
// The lock screen (design artifacts: lock screen) — the greeter's one page: the clock at the top,
// the selected user with the password capsule in the middle, the other users and the power
// buttons at the bottom, on the wallpaper with its tint. Authority stays in sessiond: the page
// asks through `SessionStore` (`ui/composables/session.store.nx`) and shows the answer.
//
// The desktop band, full screen, never resized: the greeter is the session's first surface.
Window {
    style: plain,
    mode: auto,
    level: desktop,
    resizable: false,
}

Page GreeterPage {
    Stack {
        Stack {
            LockClock { }
            Spacer
            Stack {
                SelectedUser { }
                PasswordField { }
                LoginStatus { }
            }
            .align(center)
            .gap(16)
            .width(340)
            .transition(slideUp)
            Spacer
            Stack {
                UserSwitcher { }
                Spacer
                PowerButtons { }
            }
            .direction(row)
            .align(end)
            .paddingX(24)
            .paddingY(16)
        }
        .grow(1)
        .bg(wallpaperTint)
    }
    .bgFade(transparent, scrim)
}
