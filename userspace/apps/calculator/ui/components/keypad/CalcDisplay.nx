//
// The display (design artifacts: calculator): NO surface — the expression line and the number
// sit on the pane, bottom-right, gap 4, padding 8 (top/bottom) 4 (left/right).
//
// The number's style follows the length of the formatted string, as in the artifact:
// up to 8 characters display (64 Light), up to 12 largeTitle (30 Bold), longer title1 (24 Bold).
// `len` counts characters (separators and the sign included). Digits are tabular, so a
// number never shifts as it changes.
//
// HEIGHT: the artifact's display is 104 tall and leaves 20.5 px free above the keypad's first
// row; the free space belongs to the display here (min 124, content bottom-aligned, so it looks
// the same), which makes the keypad's cells exactly square at the window's minimum (340x600) —
// circles there, pills in a wider window (`CalcKey`).
//
// MOTION: none (the artifact has no display motion). The card itself must never carry an
// `.animate(…, value:)` either: a present/absent binding rests at opacity 0 when its value
// folds to 0, which once blanked this display for a day.
Component CalcDisplay {
    // Live values are read from the store (`$state.x`, store fields are program-global); props
    // are for static per-instance data.
    Stack {
        // The expression line ("1.234 + 8 ="): kept 18 tall when empty so the number never jumps.
        Stack {
            Spacer
            Text($state.history)
                .textStyle(subheadline)
                .figures(tabular)
                .fg(labelSecondary)
        }
        .direction(row)
        .minHeight(18)
        Stack {
            Spacer
            if len($state.disp) > 12 {
                Text($state.disp)
                    .textStyle(title1)
                    .figures(tabular)
                    .fg(label)
            } else {
                if len($state.disp) > 8 {
                    Text($state.disp)
                        .textStyle(largeTitle)
                        .figures(tabular)
                        .fg(label)
                } else {
                    Text($state.disp)
                        .textStyle(display)
                        .figures(tabular)
                        .fg(label)
                }
            }
        }
        .direction(row)
    }
    .minHeight(124)
    .justify(end)
    .paddingX(4)
    .paddingTop(8)
    .paddingBottom(8)
    .gap(4)
}
