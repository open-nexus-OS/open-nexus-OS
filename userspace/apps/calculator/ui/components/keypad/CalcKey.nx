//
// One key of the keypad (design artifacts: calculator, the 4x5 grid of circles).
//
// THE SHAPE FOLLOWS THE CELL, like the reference desktop calculator: every key is
// `.rounded(full)` on a flex-grown cell. At the window's minimum (340x600, RFC-0117) a cell is
// square, so the key is the artifact's 63.5 px circle; a wider window widens the cells and the
// circles become pills; the zero key (two tracks + the gap) is a capsule at every size. The
// label tracks the key (`.textFit`, % of the key's height) and lands on the artifact's styles at
// the minimum: digits, operators and "=" title1 24 (38 %), ± and % title2 20 (31 %), AC title3
// 17 medium (27 %), capped at the largest face of the style's weight (30).
//
// NOT a `Button`: the caller owns the OUTER flex (`.basis(0).grow(n)`) and the `on Tap`, because
// a handler binds to a NODE and components are not nodes. The key's own `.grow(1)` is
// load-bearing: inside a row wrapper, cross-axis stretch gives the key its height, but its width
// only follows the allocation if it grows.
//
// `kind` picks the look (modifier arguments are literal tokens, so the choice is a branch):
//   digit    glass: glassCard (= fill at half alpha inside the pane) + glassEdge + shadow1
//   clear    secondary: fill + separator hairline, title3 medium (AC)
//   function secondary: fill + separator hairline, title2 (± %)
//   operator tinted accent: accent @16 %, accent label, no border
//   equals   filled accent: accent + onAccent label + shadow2
Component CalcKey {
    props: {
        label: Str,
        kind: Str,
    }
    if $props.kind == "equals" {
        Stack {
            Text($props.label)
                .textStyle(title1)
                .fg(onAccent)
        }
        .direction(row)
        .align(center)
        .justify(center)
        .grow(1)
        .rounded(full)
        .bg(accent)
        .shadow(shadow2)
        .textFit(38, 17, 30)
    } else {
        if $props.kind == "operator" {
            Stack {
                Text($props.label)
                    .textStyle(title1)
                    .fg(accent)
            }
            .direction(row)
            .align(center)
            .justify(center)
            .grow(1)
            .rounded(full)
            .tint(accent)
            .textFit(38, 17, 30)
        } else {
            if $props.kind == "clear" {
                Stack {
                    Text($props.label)
                        .textStyle(title3)
                        .fontWeight(medium)
                        .fg(label)
                }
                .direction(row)
                .align(center)
                .justify(center)
                .grow(1)
                .rounded(full)
                .bg(fill)
                .border(hairline)
                .borderColor(separator)
                .textFit(27, 13, 24)
            } else {
                if $props.kind == "function" {
                    Stack {
                        Text($props.label)
                            .textStyle(title2)
                            .fg(label)
                    }
                    .direction(row)
                    .align(center)
                    .justify(center)
                    .grow(1)
                    .rounded(full)
                    .bg(fill)
                    .border(hairline)
                    .borderColor(separator)
                    .textFit(31, 15, 30)
                } else {
                    Stack {
                        Text($props.label)
                            .textStyle(title1)
                            .fg(label)
                    }
                    .direction(row)
                    .align(center)
                    .justify(center)
                    .grow(1)
                    .rounded(full)
                    .bg(glassCard)
                    .border(hairline)
                    .borderColor(glassEdge)
                    .shadow(shadow1, edgeHighlight)
                    .textFit(38, 17, 30)
                }
            }
        }
    }
}
