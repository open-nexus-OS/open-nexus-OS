//
// The calculator, rebuilt to the design artifacts (calculator). The window is never smaller
// than the artifact's phone-sized 340x600 (RFC-0117: the window manager enforces the minimum)
// and grows like the reference desktop calculator: the keypad divides on both axes
// (`.basis(0).grow(1)`), the circles become pills as the window widens and every label sizes
// itself from its own key (`.textFit`) — no breakpoints anywhere.
//
// The page is a thin composition; state lives in `composables/calc.store.nx` (the arithmetic)
// and `composables/menu.store.nx` (the ⋮ menu), the surfaces in `components/keypad/` and
// `components/menu/`.
// ONE window path (TASK-0337): the chrome is window-kit's, inside this surface —
// `style: plain` leaves windowd no title bar to draw; the keypad's pane is the OPAQUE content
// layer (the materials rules), the top bar the window's functional layer.
Window {
    style: plain,
    mode: auto,
    resizable: true,
    width: 340,
    height: 600,
    minWidth: 340,
    minHeight: 600,
}

Page CalculatorPage {
    Stack {
        WinTopBar {
            icon: "calculator",
            tool1: "",
            tool2: "",
            tool3: "",
            tool1Active: false,
            tool2Active: false,
            tool3Active: false,
            tool4: "",
            tool4Active: false,
            tool1Disabled: false,
            tool2Disabled: false,
            tool3Disabled: false,
            tool4Disabled: false,
            navBack: "",
            navFwd: "",
            navRefresh: "",
            sideLeft: "",
            sideRight: "",
            more: "ellipsis.vertical",
            appId: "calculator",
        }
        WinAppWindow {
            showSidebar: false,
            showProps: false,
            sidebarOverlay: false,
            propsOverlay: false,
            appMenuOpen: $state.menu == "more",
            menuFullscreen: @t("win.fullscreen"),
            menuMoveDevice: @t("win.moveDevice"),
            menuMinimize: @t("win.minimize"),
            menuClose: @t("win.close"),
            menuMoveLabel: @t("win.moveLabel"),
            menuArrangeLabel: @t("win.arrangeLabel"),
            menuSoon: @t("win.soon"),
        } {
            sidebarLeft {
                Stack { }
            }
            contentArea {
                Stack {
                    CalcDisplay { }
                    CalcKeypad { }
                }
                .material(pane)
                .rounded(16)
                // Spacing is px on the 4-pt grid (RFC-0116): padding 16, display ↔ keypad 16.
                .paddingTop(16)
                .paddingX(16)
                .paddingBottom(16)
                .gap(16)
                .grow(1)
            }
            sidebarRight {
                Stack { }
            }
            appMenu {
                CalcMenu { }
            }
        }
    }
    .gap(0)
}
