// A pane zone's hairline (`WinPane`): `separator`, 1 px, or an empty slot with `noDividers`.

Component WinPaneRule {
    props: {
        hidden: Bool,
    }
    if $props.hidden {
        Stack { }
    } else {
        Stack { }
            .height(1)
            .bg(separator)
    }
}
