//
// A tiling glyph (TASK-0066; design artifacts `WindowMenu` Glyph): a 28×20
// mini screen — a 1 px frame in `labelTertiary` (the design's label at 45 %),
// radius 4 — with the window(s) a zone fills drawn as `accent` rects (radius
// 2, inset 2 from the frame); in a multi-window arrangement every window after
// the first is `accent` at 55 % (`.tint(accent, line)`). No icon asset, no
// text: the glyph IS the label of its tile.
//   move & resize   left-half · right-half · top-half · bottom-half ·
//                   top-left · top-right · bottom-left · bottom-right
//   fill & arrange  fill · left-right · top-bottom · quarters · return
//                   (`return` = "Frei": two overlapping free windows)
// Presentational only; the tile around it dispatches the action.

Component WinTileGlyph {
    props: {
        zone: Str,
    }
    Stack {
        if $props.zone == "left-half" {
            Stack {
                Stack { }.grow(1).bg(accent).rounded(2)
                Stack { }.grow(1)
            }
            .direction(row)
            .gap(4)
            .grow(1)
        } else if $props.zone == "right-half" {
            Stack {
                Stack { }.grow(1)
                Stack { }.grow(1).bg(accent).rounded(2)
            }
            .direction(row)
            .gap(4)
            .grow(1)
        } else if $props.zone == "top-half" {
            Stack {
                Stack { }.grow(1).bg(accent).rounded(2)
                Stack { }.grow(1)
            }
            .gap(4)
            .grow(1)
        } else if $props.zone == "bottom-half" {
            Stack {
                Stack { }.grow(1)
                Stack { }.grow(1).bg(accent).rounded(2)
            }
            .gap(4)
            .grow(1)
        } else if $props.zone == "top-left" {
            Stack {
                Stack {
                    Stack { }.grow(1).bg(accent).rounded(2)
                    Stack { }.grow(1)
                }
                .direction(row)
                .gap(4)
                .grow(1)
                Stack { }.grow(1)
            }
            .gap(4)
            .grow(1)
        } else if $props.zone == "top-right" {
            Stack {
                Stack {
                    Stack { }.grow(1)
                    Stack { }.grow(1).bg(accent).rounded(2)
                }
                .direction(row)
                .gap(4)
                .grow(1)
                Stack { }.grow(1)
            }
            .gap(4)
            .grow(1)
        } else if $props.zone == "bottom-left" {
            Stack {
                Stack { }.grow(1)
                Stack {
                    Stack { }.grow(1).bg(accent).rounded(2)
                    Stack { }.grow(1)
                }
                .direction(row)
                .gap(4)
                .grow(1)
            }
            .gap(4)
            .grow(1)
        } else if $props.zone == "bottom-right" {
            Stack {
                Stack { }.grow(1)
                Stack {
                    Stack { }.grow(1)
                    Stack { }.grow(1).bg(accent).rounded(2)
                }
                .direction(row)
                .gap(4)
                .grow(1)
            }
            .gap(4)
            .grow(1)
        } else if $props.zone == "fill" {
            Stack { }.grow(1).bg(accent).rounded(2)
        } else if $props.zone == "left-right" {
            Stack {
                Stack { }.grow(1).bg(accent).rounded(2)
                Stack { }.grow(1).tint(accent, line).rounded(2)
            }
            .direction(row)
            .gap(4)
            .grow(1)
        } else if $props.zone == "top-bottom" {
            Stack {
                Stack { }.grow(1).bg(accent).rounded(2)
                Stack { }.grow(1).tint(accent, line).rounded(2)
            }
            .gap(4)
            .grow(1)
        } else if $props.zone == "return" {
            // Two overlapping windows (the design's "Frei"): each one an
            // out-of-flow layer over the screen, placed by its padding.
            Stack {
                Stack {
                    Stack { }.width(10).height(6).bg(accent).rounded(2)
                }
                .align(start)
                .paddingLeading(4)
                .paddingTop(4)
                .overlay()
                Stack {
                    Stack { }.width(10).height(6).tint(accent, line).rounded(2)
                }
                .align(start)
                .paddingLeading(12)
                .paddingTop(8)
                .overlay()
            }
            .grow(1)
        } else {
            Stack {
                Stack {
                    Stack { }.grow(1).bg(accent).rounded(2)
                    Stack { }.grow(1).tint(accent, line).rounded(2)
                }
                .direction(row)
                .gap(4)
                .grow(1)
                Stack {
                    Stack { }.grow(1).tint(accent, line).rounded(2)
                    Stack { }.grow(1).tint(accent, line).rounded(2)
                }
                .direction(row)
                .gap(4)
                .grow(1)
            }
            .gap(4)
            .grow(1)
        }
    }
    .width(28)
    .height(20)
    .padding(2)
    .border(hairline)
    .borderColor(labelTertiary)
    .rounded(4)
}
