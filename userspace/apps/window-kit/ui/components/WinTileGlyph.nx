//
// A tiling glyph (TASK-0066): the little window frame with the part a zone
// fills — the desktop's "Move & Resize" / "Fill & Arrange" pictograms, drawn
// from primitives (a bordered frame, filled cells), no icon asset, no text.
//   zone: left-half · right-half · top-left · top-right · bottom-left ·
//         bottom-right · fill · return · left-right · top-bottom · quarters
// Presentational only; the menu row around it dispatches the action.

Component WinTileGlyph {
    props: {
        zone: Str,
    }
    Stack {
        if $props.zone == "left-half" {
            Stack {
                Stack { }.grow(1).bg(onGlass).rounded(sm)
                Stack { }.grow(1)
            }
            .direction(row)
            .gap(0)
            .grow(1)
        } else if $props.zone == "right-half" {
            Stack {
                Stack { }.grow(1)
                Stack { }.grow(1).bg(onGlass).rounded(sm)
            }
            .direction(row)
            .gap(0)
            .grow(1)
        } else if $props.zone == "top-left" {
            Stack {
                Stack {
                    Stack { }.grow(1).bg(onGlass).rounded(sm)
                    Stack { }.grow(1)
                }
                .direction(row)
                .gap(0)
                .grow(1)
                Stack { }.grow(1)
            }
            .gap(0)
            .grow(1)
        } else if $props.zone == "top-right" {
            Stack {
                Stack {
                    Stack { }.grow(1)
                    Stack { }.grow(1).bg(onGlass).rounded(sm)
                }
                .direction(row)
                .gap(0)
                .grow(1)
                Stack { }.grow(1)
            }
            .gap(0)
            .grow(1)
        } else if $props.zone == "bottom-left" {
            Stack {
                Stack { }.grow(1)
                Stack {
                    Stack { }.grow(1).bg(onGlass).rounded(sm)
                    Stack { }.grow(1)
                }
                .direction(row)
                .gap(0)
                .grow(1)
            }
            .gap(0)
            .grow(1)
        } else if $props.zone == "bottom-right" {
            Stack {
                Stack { }.grow(1)
                Stack {
                    Stack { }.grow(1)
                    Stack { }.grow(1).bg(onGlass).rounded(sm)
                }
                .direction(row)
                .gap(0)
                .grow(1)
            }
            .gap(0)
            .grow(1)
        } else if $props.zone == "fill" {
            Stack { }.grow(1).bg(onGlass).rounded(sm)
        } else if $props.zone == "return" {
            Stack {
                Stack { }.grow(1).bg(onGlass).rounded(sm)
            }
            .padding(1)
            .grow(1)
        } else if $props.zone == "left-right" {
            Stack {
                Stack { }.grow(1).bg(onGlass).rounded(sm)
                Stack { }.grow(1).bg(onGlass).rounded(sm)
            }
            .direction(row)
            .gap(1)
            .grow(1)
        } else if $props.zone == "top-bottom" {
            Stack {
                Stack { }.grow(1).bg(onGlass).rounded(sm)
                Stack { }.grow(1).bg(onGlass).rounded(sm)
            }
            .gap(1)
            .grow(1)
        } else {
            Stack {
                Stack {
                    Stack { }.grow(1).bg(onGlass).rounded(sm)
                    Stack { }.grow(1).bg(onGlass).rounded(sm)
                }
                .direction(row)
                .gap(1)
                .grow(1)
                Stack {
                    Stack { }.grow(1).bg(onGlass).rounded(sm)
                    Stack { }.grow(1).bg(onGlass).rounded(sm)
                }
                .direction(row)
                .gap(1)
                .grow(1)
            }
            .gap(1)
            .grow(1)
        }
    }
    .width(22)
    .height(16)
    .padding(0)
    .border(thin)
    .borderColor(onGlassMuted)
    .rounded(sm)
}
