//
// One floating-action-bar button that dispatches the kit's `WinAct(id)` —
// the window-standard actions (more, share, …). The LOOK lives in
// `WinActionFace`, so an app whose button dispatches its own event
// (`NewFolder`, `CopySel`, …) wraps that face directly instead of
// re-implementing the button:
//
//     Stack { WinActionFace { label: …, icon: …, kind: "" } }
//     on Tap -> dispatch(NewFolder)
//
// The bar's visible item set is the app's SELECTION REACTIVITY — compose
// different items when `$state.selection` changes.

Component WinActionItem {
    props: {
        id: Str,
        label: Str,
        icon: Str,
        kind: Str,
    }
    Stack {
        WinActionFace { label: $props.label, icon: $props.icon, kind: $props.kind }
    }
    on Tap -> dispatch(WinAct($props.id))
}
