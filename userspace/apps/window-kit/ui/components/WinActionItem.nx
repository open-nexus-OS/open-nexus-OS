//
// One action-bar item that dispatches the kit's `WinAct(id)` — the
// window-standard actions (more, share, …). The LOOK lives in
// `WinActionFace`, so an app whose item dispatches its own event
// (`NewFolder`, `CopySel`, …) wraps that face directly instead of
// re-implementing the item:
//
//     Stack { WinActionFace { label: …, icon: …, kind: "", active: false } }
//     on Tap -> dispatch(NewFolder)
//
// The bar's visible item set is the app's SELECTION REACTIVITY — compose
// different items when `$state.selection` changes; `active` marks the item the
// indicator rests on (the last pressed one).

Component WinActionItem {
    props: {
        id: Str,
        label: Str,
        icon: Str,
        kind: Str,
        active: Bool,
    }
    Stack {
        WinActionFace { label: $props.label, icon: $props.icon, kind: $props.kind, active: $props.active }
    }
    on Tap -> dispatch(WinAct($props.id))
}
