//
// The window's three-zone top chrome (design_handoff_open_nexus_os window
// frame): LEADING app chip (window-mode menu) + left-sidebar toggle ·
// CENTER toolbar slots (up to three tool icons; "" hides a slot) ·
// TRAILING ⋯ app menu + properties-sidebar toggle + window controls.
// Dispatches into the consuming app's WindowStore (see window-kit manifest
// for the store contract).
//
// A tool slot can be ACTIVE (`tool1Active` …): the design pins the hover
// surface on the pressed tool, so Suche / Kacheln / Liste show which mode the
// window is in instead of looking identical to the tools that do nothing.

Component WinTopBar {
    props: {
        icon: Str,
        tool1: Str,
        tool2: Str,
        tool3: Str,
        tool1Active: Bool,
        tool2Active: Bool,
        tool3Active: Bool,
        navBack: Str,
        navFwd: Str,
        navRefresh: Str,
        appId: Str,
    }
    Stack {
        // App chip: the app's REAL baked icon (the small colored svg) when an
        // `appId` is given, else the theme glyph. Tap opens the window menu.
        // The chevron marks it as a menu affordance, not decoration.
        if $props.appId != "" {
            Stack {
                Image { source: $props.appId, size: 24 }
                Icon { symbol: "chevron.down", size: 10 }
                    .fg(onGlassMuted)
            }
            .direction(row)
            .align(center)
            .gap(0)
            .height(30)
            on Tap -> dispatch(WinMenu("app"))
        } else {
            Circle { size: 26
                Icon { symbol: $props.icon, size: 14 }
                    .fg(onGlass)
            }
            .material(subtle)
            on Tap -> dispatch(WinMenu("app"))
        }
        Stack {
            Icon { symbol: "sidebar.left", size: 15 }
                .fg(onGlassMuted)
        }
        .width(30)
        .height(30)
        .rounded(md)
        .align(center)
        .justify(center)
        on Tap -> dispatch(WinLeft)
        // Optional navigation group (file-manager back / forward / refresh).
        // Empty symbol = hidden, so apps that don't navigate stay unaffected.
        if $props.navBack != "" {
            Stack {
                Icon { symbol: $props.navBack, size: 15 }
                    .fg(onGlassMuted)
            }
            .width(30)
            .height(30)
            .rounded(md)
            .align(center)
            .justify(center)
            on Tap -> dispatch(WinNav("back"))
        } else {
            Stack { }
        }
        if $props.navFwd != "" {
            Stack {
                Icon { symbol: $props.navFwd, size: 15 }
                    .fg(onGlassMuted)
            }
            .width(30)
            .height(30)
            .rounded(md)
            .align(center)
            .justify(center)
            on Tap -> dispatch(WinNav("fwd"))
        } else {
            Stack { }
        }
        // Divider between the navigation group and the tool cluster.
        if $props.navRefresh != "" {
            Stack {
                Stack {
                    Icon { symbol: $props.navRefresh, size: 15 }
                        .fg(onGlassMuted)
                }
                .width(30)
                .height(30)
                .rounded(md)
                .align(center)
                .justify(center)
                on Tap -> dispatch(WinNav("refresh"))
                Stack { }
                    .width(1)
                    .height(16)
                    .bg(divider)
            }
            .direction(row)
            .align(center)
            .gap(1)
        } else {
            Stack { }
        }
        Spacer
        if $props.tool1 != "" {
            if $props.tool1Active {
                Stack {
                    Icon { symbol: $props.tool1, size: 15 }
                        .fg(onAccent)
                }
                .width(30)
                .height(30)
                .rounded(md)
                .align(center)
                .justify(center)
                .bg(accent)
                on Tap -> dispatch(WinTool($props.tool1))
            } else {
                Stack {
                    Icon { symbol: $props.tool1, size: 15 }
                        .fg(onGlassMuted)
                }
                .width(30)
                .height(30)
                .rounded(md)
                .align(center)
                .justify(center)
                on Tap -> dispatch(WinTool($props.tool1))
            }
        } else {
            Stack { }
        }
        // Divider between the search tool and the view-mode pair.
        if $props.tool2 != "" {
            Stack { }
                .width(1)
                .height(16)
                .bg(divider)
        } else {
            Stack { }
        }
        if $props.tool2 != "" {
            if $props.tool2Active {
                Stack {
                    Icon { symbol: $props.tool2, size: 15 }
                        .fg(onAccent)
                }
                .width(30)
                .height(30)
                .rounded(md)
                .align(center)
                .justify(center)
                .bg(accent)
                on Tap -> dispatch(WinTool($props.tool2))
            } else {
                Stack {
                    Icon { symbol: $props.tool2, size: 15 }
                        .fg(onGlassMuted)
                }
                .width(30)
                .height(30)
                .rounded(md)
                .align(center)
                .justify(center)
                on Tap -> dispatch(WinTool($props.tool2))
            }
        } else {
            Stack { }
        }
        if $props.tool3 != "" {
            if $props.tool3Active {
                Stack {
                    Icon { symbol: $props.tool3, size: 15 }
                        .fg(onAccent)
                }
                .width(30)
                .height(30)
                .rounded(md)
                .align(center)
                .justify(center)
                .bg(accent)
                on Tap -> dispatch(WinTool($props.tool3))
            } else {
                Stack {
                    Icon { symbol: $props.tool3, size: 15 }
                        .fg(onGlassMuted)
                }
                .width(30)
                .height(30)
                .rounded(md)
                .align(center)
                .justify(center)
                on Tap -> dispatch(WinTool($props.tool3))
            }
        } else {
            Stack { }
        }
        Spacer
        // VERTICAL ellipsis: the handoff draws the toolbar's "Mehr" as
        // `circle cx=12 cy=5|12|19` and the action bar's as `cx=5|12|19 cy=12`.
        // Two different glyphs, not one rotated — so two symbols.
        Stack {
            Icon { symbol: "ellipsis.vertical", size: 15 }
                .fg(onGlassMuted)
        }
        .width(30)
        .height(30)
        .rounded(md)
        .align(center)
        .justify(center)
        on Tap -> dispatch(WinMenu("more"))
        Stack {
            Icon { symbol: "sidebar.right", size: 15 }
                .fg(onGlassMuted)
        }
        .width(30)
        .height(30)
        .rounded(md)
        .align(center)
        .justify(center)
        on Tap -> dispatch(WinRight)
        Stack {
            Icon { symbol: "minus", size: 14 }
                .fg(onGlassMuted)
        }
        .width(30)
        .height(30)
        .rounded(md)
        .align(center)
        .justify(center)
        on Tap -> dispatch(WinAct("minimize"))
        Stack {
            Icon { symbol: "square", size: 12 }
                .fg(onGlassMuted)
        }
        .width(30)
        .height(30)
        .rounded(md)
        .align(center)
        .justify(center)
        on Tap -> dispatch(WinAct("zoom"))
        Stack {
            Icon { symbol: "xmark", size: 14 }
                .fg(danger)
        }
        .width(30)
        .height(30)
        .rounded(md)
        .align(center)
        .justify(center)
        on Tap -> dispatch(WinAct("close"))
    }
    .direction(row)
    .align(center)
    .gap(1)
    .paddingX(2)
    .height(40)
    // The chrome row IS the window's grab strip (phone-style windowing: a
    // chromeless window has no WM title bar, so its own top chrome moves it).
    // A press on any EMPTY stretch of the row — the spacers around the
    // toolbar — lands here and asks windowd to start a pointer drag
    // (`window.control = "move"`); every control above wins its own tap
    // first, exactly like the buttons in a WM title bar.
    on Tap -> dispatch(WinAct("move"))
}
