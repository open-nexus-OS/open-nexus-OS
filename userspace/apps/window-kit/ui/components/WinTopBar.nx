//
// The window's title chrome (design artifacts: Window · WindowMenu ·
// WindowButton · WindowControls): one 52 px row (padding 8 12 around 36 px of
// controls) in three zones —
//   LEADING  (gap 4)  the app chip (the app's icon + a chevron, never the app
//                     name) that opens the window menu, then the sidebar toggle;
//   TOOLBAR  (gap 2)  back · forward · refresh | tool1 | tool2 · tool3 · tool4,
//                     centred on the WINDOW (an out-of-flow layer over the row, so
//                     unequal leading/trailing zones cannot push it off-centre); a
//                     `toolNDisabled` tool is drawn dimmed without a tap;
//   TRAILING (gap 2)  the properties toggle, the ⋮ app menu, a 1×16 divider
//                     (margin 0 8, only when one of those two exists) and the
//                     window controls (three 36 px circles).
// Every button is a `WinButtonFace` circle: glyph `labelSecondary`, a pinned
// `fill` layer + `label` glyph while ACTIVE — a tool mode (`tool1Active` …),
// a shown pane (the toggles), an open menu (the chip, the ⋮). A symbol of ""
// hides its button; `navBackDisabled`/`navFwdDisabled` keep the arrow and
// drop its tap (the design always shows Vorwärts, dimmed without a target).
//
// The toggles read the store contract to know whether their pane is shown,
// mirroring `WinAppWindow`'s tiers: the sidebar is inline on `wide` and an
// overlay below it; the properties pane is inline down to `regular` and an
// overlay on `compact`. The chip is open while `menu == "app"`, the ⋮ while
// `menu == "more"` — or whenever the app says so (`moreActive`, for the
// submenu ids only the app knows).
//
// Dispatches into the consuming app's window store (see the window-kit
// manifest for the store contract: fields menu · leftOpen · rightOpen ·
// paneL · paneR, events WinMenu · WinLeft · WinRight · WinTool · WinNav ·
// WinAct). Its parts: `WinAppChip`, `WinNavCell`/`WinToolCell`, `WinBarRule`.

Component WinTopBar {
    props: {
        icon: Str,
        tool1: Str,
        tool2: Str,
        tool3: Str,
        tool4: Str,
        tool1Active: Bool,
        tool2Active: Bool,
        tool3Active: Bool,
        tool4Active: Bool,
        // A tool drawn dimmed without a tap (its function does not exist yet — the house rule:
        // an unfinished control stays visible and disabled). Omitted = enabled.
        tool1Disabled: Bool,
        tool2Disabled: Bool,
        tool3Disabled: Bool,
        tool4Disabled: Bool,
        navBack: Str,
        navFwd: Str,
        navRefresh: Str,
        navBackDisabled: Bool,
        navFwdDisabled: Bool,
        // The sidebar toggles and the app's own "more" menu (TASK-0337: one window path —
        // a window without sidebars or an app menu shows no control for them). The symbol
        // to draw, or "" to hide — the navigation group's rule.
        sideLeft: Str,
        sideRight: Str,
        more: Str,
        moreActive: Bool,
        appId: Str,
    }
    Stack {
        // ── leading: the app chip + the sidebar toggle ──────────────────
        Stack {
            WinAppChip { icon: $props.icon, appId: $props.appId }
            if $props.sideLeft != "" {
                Stack {
                    WinButtonFace {
                        symbol: $props.sideLeft,
                        size: 14,
                        active: (device.sizeClass == "wide" && $state.leftOpen == 1) || (device.sizeClass != "wide" && $state.paneL == 1),
                        danger: false,
                        disabled: false,
                        large: false,
                    }
                }
                on Tap -> dispatch(WinLeft)
            } else {
                Stack { }
            }
        }
        .direction(row)
        .align(center)
        .gap(4)
        Spacer
        // ── trailing: properties toggle · ⋮ · divider · window controls ─
        Stack {
            if $props.sideRight != "" {
                Stack {
                    WinButtonFace {
                        symbol: $props.sideRight,
                        size: 14,
                        active: (device.sizeClass != "compact" && $state.rightOpen == 1) || (device.sizeClass == "compact" && $state.paneR == 1),
                        danger: false,
                        disabled: false,
                        large: false,
                    }
                }
                on Tap -> dispatch(WinRight)
            } else {
                Stack { }
            }
            // VERTICAL ellipsis: the design draws the toolbar's "Mehr" as
            // `circle cx=12 cy=5|12|19` and the action bar's as `cx=5|12|19 cy=12`.
            // Two different glyphs, not one rotated — so two symbols.
            // Two arms, not `moreActive || …`: an `if` reads an omitted prop as false, `||`
            // rejects it — and apps leave `moreActive` out.
            if $props.more != "" {
                if $props.moreActive {
                    Stack {
                        WinButtonFace { symbol: $props.more, size: 16, active: true, danger: false, disabled: false, large: false }
                    }
                    on Tap -> dispatch(WinMenu("more"))
                } else {
                    Stack {
                        WinButtonFace { symbol: $props.more, size: 16, active: $state.menu == "more", danger: false, disabled: false, large: false }
                    }
                    on Tap -> dispatch(WinMenu("more"))
                }
            } else {
                Stack { }
            }
            WinBarRule { show: $props.sideRight != "" || $props.more != "", pad: 8 }
            Stack {
                WinButtonFace { symbol: "minus", size: 14, active: false, danger: false, disabled: false, large: true }
            }
            on Tap -> dispatch(WinAct("minimize"))
            Stack {
                WinButtonFace { symbol: "square", size: 13, active: false, danger: false, disabled: false, large: true }
            }
            on Tap -> dispatch(WinAct("zoom"))
            Stack {
                WinButtonFace { symbol: "xmark", size: 14, active: false, danger: true, disabled: false, large: true }
            }
            on Tap -> dispatch(WinAct("close"))
        }
        .direction(row)
        .align(center)
        .gap(2)
        // ── the toolbar, centred on the window ──────────────────────────
        // An out-of-flow layer over the row's content box (padding 12 on both
        // sides, so its centre IS the window's). It has no handler of its own:
        // a press beside a tool falls through to the row's drag handler, and
        // the zones under it keep their buttons.
        if $props.navBack != "" || $props.navFwd != "" || $props.navRefresh != "" || $props.tool1 != "" || $props.tool2 != "" || $props.tool3 != "" || $props.tool4 != "" {
            Stack {
                Spacer
                Stack {
                    WinNavCell { symbol: $props.navBack, action: "back", disabled: $props.navBackDisabled }
                    WinNavCell { symbol: $props.navFwd, action: "fwd", disabled: $props.navFwdDisabled }
                    WinNavCell { symbol: $props.navRefresh, action: "refresh", disabled: false }
                    // Between the navigation group and the tools; between the search tool and
                    // the view-mode pair.
                    WinBarRule { show: ($props.navBack != "" || $props.navFwd != "" || $props.navRefresh != "") && ($props.tool1 != "" || $props.tool2 != "" || $props.tool3 != "" || $props.tool4 != ""), pad: 4 }
                    WinToolCell { symbol: $props.tool1, active: $props.tool1Active, disabled: $props.tool1Disabled }
                    WinBarRule { show: $props.tool1 != "" && $props.tool2 != "", pad: 4 }
                    WinToolCell { symbol: $props.tool2, active: $props.tool2Active, disabled: $props.tool2Disabled }
                    WinToolCell { symbol: $props.tool3, active: $props.tool3Active, disabled: $props.tool3Disabled }
                    WinToolCell { symbol: $props.tool4, active: $props.tool4Active, disabled: $props.tool4Disabled }
                }
                .direction(row)
                .align(center)
                Spacer
            }
            .direction(row)
            .align(center)
            .overlay()
        } else {
            Stack { }
        }
    }
    .direction(row)
    .align(center)
    .paddingX(12)
    .paddingY(8)
    .height(52)
    // The chrome row IS the window's grab strip (phone-style windowing: a
    // chromeless window has no WM title bar, so its own top chrome moves it).
    // A press on any EMPTY stretch of the row — around the zones and the
    // toolbar — lands here and asks windowd to start a pointer drag
    // (`window.control = "move"`); every control above wins its own tap
    // first, exactly like the buttons in a WM title bar.
    on Tap -> dispatch(WinAct("move"))
}
