//
// The window's three-zone body: sidebarLeft · contentArea · sidebarRight
// (RFC-0084).
//
// THE POINT OF THIS COMPONENT is what it does NOT paint. Every region is a
// transparent container. If a region wants a surface, the APP writes one in the
// slot body:
//
//     contentArea { Panel { … }.material(windowPane).grow(1) }
//
// This used to be three `Bool` props (`sidebarPanel`/`contentPanel`/
// `propsPanel`) with the kit doing the painting, which cost a fully duplicated
// `if` arm per region — `.material($props.x)` does not exist, modifiers take
// tokens and not expressions, so the choice had to be branched. Moving the
// surface into the body deletes those six arms AND buys two things the flags
// could not express: a region can stack SEVERAL panels (the settings pane), and
// a panel can pick its own level (`windowPane` for a content pane, `panel` for
// a nav rail) without the kit growing a prop axis per level.
//
// RESPONSIVE (RFC-0084 Phase 7), tiers 640/1024 via `device.sizeClass`:
// wide keeps all three zones inline; regular keeps the sidebar inline but moves
// the right pane into an OVERLAY; compact moves both. Overlay panes ride the
// proven menu-overlay pattern (`.overlay()`, backdrop tap → `WinPaneClose`,
// pane eats taps via `WinNoop`) over a `scrim` backdrop.
//
// A slot legally appears in BOTH the inline and the overlay arm — rule 12 only
// refuses two placeholders under the same parent, and the arms are exclusive.
//
// CONSEQUENCE OF THE APP OWNING THE SURFACE: an overlay pane is the app's own
// `Panel`, floating. A region whose body has no panel therefore floats
// unframed. If a region can become an overlay pane, give it a panel.

Component WinAppWindow {
    props: {
        showSidebar: Bool,
        showProps: Bool,
        sidebarOverlay: Bool,
        propsOverlay: Bool,
    }
    slot sidebarLeft
    slot contentArea
    slot sidebarRight
    Stack {
        Stack {
            // ── left region (240px, inline on wide + regular) ────────
            if device.sizeClass == "compact" {
                Stack { }
            } else {
                if $props.showSidebar {
                    Stack {
                        Slot sidebarLeft
                    }
                    .width(240)
                    .gap(1)
                    .padding(3)
                } else {
                    Stack { }
                }
            }
            // ── content region (fills the remaining width) ───────────
            Stack {
                Slot contentArea
            }
            .grow(1)
            .gap(1)
            .padding(3)
            // ── right region (260px, inline on wide only) ────────────
            if device.sizeClass == "wide" {
                if $props.showProps {
                    Stack {
                        Slot sidebarRight
                    }
                    .width(260)
                    .gap(1)
                    .padding(3)
                } else {
                    Stack { }
                }
            } else {
                Stack { }
            }
        }
        .direction(row)
        .grow(1)
        // ── overlay panes ────────────────────────────────────────────
        // Backdrop dims with `scrim` and closes on tap (`WinPaneClose`); the
        // pane itself eats its taps (`WinNoop`) — the proven menu pattern.
        if device.sizeClass == "compact" {
            if $props.sidebarOverlay {
                Stack {
                    Stack {
                        Slot sidebarLeft
                    }
                    .width(240)
                    .gap(1)
                    .padding(3)
                    on Tap -> dispatch(WinNoop)
                    Spacer
                }
                .direction(row)
                .grow(1)
                .bg(scrim)
                .overlay()
                .transition(fade)
                on Tap -> dispatch(WinPaneClose)
            } else {
                Stack { }
            }
        } else {
            Stack { }
        }
        if device.sizeClass == "wide" {
            Stack { }
        } else {
            if $props.propsOverlay {
                Stack {
                    Spacer
                    Stack {
                        Slot sidebarRight
                    }
                    .width(260)
                    .gap(1)
                    .padding(3)
                    on Tap -> dispatch(WinNoop)
                }
                .direction(row)
                .grow(1)
                .bg(scrim)
                .overlay()
                .transition(fade)
                on Tap -> dispatch(WinPaneClose)
            } else {
                Stack { }
            }
        }
    }
    .grow(1)
}
