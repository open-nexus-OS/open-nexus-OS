//
// One properties-pane row (design artifacts: the AppWindow / WindowPane
// properties rows): the label left in `labelSecondary`, the value right-aligned
// at weight 500 in `label` — the value is the information, the label only
// names it — footnote 12/16, gap 8, padding 8 12: a 32 px row. A 1 px
// `separator` sits between rows; `last: true` drops it under the final one.
// No icon in v3 (`icon` is still accepted and ignored).
// Pure display: the pane's CONTENT is the app's selection reactivity (render
// different rows for `$state.selection`), inside a `WinPane` body (4 8).

Component WinPropRow {
    props: {
        label: Str,
        value: Str,
        icon: Str,
        last: Bool,
    }
    Stack {
        Stack {
            Text($props.label).textStyle(footnote).fg(labelSecondary).shrink(0)
            Stack { }
                .grow(1)
                .shrink(0)
            Text($props.value).textStyle(footnote).fontWeight(medium).fg(label).textAlign(right)
        }
        .direction(row)
        .align(center)
        .gap(8)
        .paddingY(8)
        .paddingX(12)
        if $props.last {
            Stack { }
        } else {
            Stack { }
                .height(1)
                .bg(separator)
        }
    }
    .gap(0)
}
