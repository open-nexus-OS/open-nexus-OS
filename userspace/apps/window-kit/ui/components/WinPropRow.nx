//
// One properties-pane row (design handoff `ListItem` in the "Eigenschaften"
// pane): leading icon, label, value right-aligned in the STRONG on-glass
// role — the value is the information, the label only names it. 50px row
// height and a hairline between rows come from the design's list metrics.
// Pure display: the pane's CONTENT is the app's selection reactivity (render
// different rows for `$state.selection`).

Component WinPropRow {
    props: {
        label: Str,
        value: Str,
        icon: Str,
    }
    Stack {
        Stack {
            Icon { symbol: $props.icon, size: 15 }
                .fg(onSurfaceVariant)
            Text($props.label).textSize(sm).fg(onSurface)
            Spacer
            Text($props.value).textSize(sm).fg(onGlassStrong)
        }
        .direction(row)
        .align(center)
        .gap(2)
        .paddingX(2)
        .height(50)
        Stack { }
            .height(1)
            .bg(border)
    }
    .gap(0)
}
