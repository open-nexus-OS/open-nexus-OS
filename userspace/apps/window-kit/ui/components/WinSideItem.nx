//
// One navigation-sidebar row (design handoff `Sidebar`): icon + title
// (+ optional subtitle), accent-filled when active. Tap dispatches
// `WinMenuPick(id)` — the app's reducer routes nav ids (by convention
// prefixed "nav.") to its section state.
//
// The icon sits in a PINNED 16px box and the text column takes `.grow(1)`.
// Without both, a long two-line label wins the flex negotiation and squeezes
// the icon to a two-pixel sliver — which is what the settings sidebar looked
// like the first time it shipped twelve German section names.
//
// `sub: ""` = the COMPACT row (36px, one line) — the handoff's "Sidebar
// kompakt" form. Twelve compact rows fit the default 526px frame; the
// two-line 44px form returns wherever the caller has the height for it.

Component WinSideItem {
    props: {
        id: Str,
        label: Str,
        sub: Str,
        icon: Str,
        active: Bool,
    }
    if $props.active && $props.sub != "" {
        Stack {
            Stack {
                Icon { symbol: $props.icon, size: 15 }
                    .fg(onAccent)
            }
            .width(16)
            .align(center)
            .justify(center)
            Stack {
                Text($props.label).textSize(sm).fg(onAccent)
                Text($props.sub).textSize(xs).fg(onAccent)
            }
            .gap(0)
            .grow(1)
        }
        .direction(row)
        .align(center)
        .gap(2)
        .paddingX(2)
        .height(44)
        .rounded(lg)
        .bg(accent)
        on Tap -> dispatch(WinMenuPick($props.id))
    } else if $props.active {
        Stack {
            Stack {
                Icon { symbol: $props.icon, size: 15 }
                    .fg(onAccent)
            }
            .width(16)
            .align(center)
            .justify(center)
            Stack {
                Text($props.label).textSize(sm).fg(onAccent)
            }
            .gap(0)
            .grow(1)
        }
        .direction(row)
        .align(center)
        .gap(2)
        .paddingX(2)
        .height(36)
        .rounded(lg)
        .bg(accent)
        on Tap -> dispatch(WinMenuPick($props.id))
    } else if $props.sub != "" {
        Stack {
            Stack {
                Icon { symbol: $props.icon, size: 15 }
                    .fg(onGlassMuted)
            }
            .width(16)
            .align(center)
            .justify(center)
            Stack {
                Text($props.label).textSize(sm).fg(onGlass)
                Text($props.sub).textSize(xs).fg(onGlassMuted)
            }
            .gap(0)
            .grow(1)
        }
        .direction(row)
        .align(center)
        .gap(2)
        .paddingX(2)
        .height(44)
        .rounded(lg)
        on Tap -> dispatch(WinMenuPick($props.id))
    } else {
        Stack {
            Stack {
                Icon { symbol: $props.icon, size: 15 }
                    .fg(onGlassMuted)
            }
            .width(16)
            .align(center)
            .justify(center)
            Stack {
                Text($props.label).textSize(sm).fg(onGlass)
            }
            .gap(0)
            .grow(1)
        }
        .direction(row)
        .align(center)
        .gap(2)
        .paddingX(2)
        .height(36)
        .rounded(lg)
        on Tap -> dispatch(WinMenuPick($props.id))
    }
}
