//
// One navigation-sidebar row (design artifacts `Sidebar`, variant plain): icon
// + label, padding 8 12, gap 12, radius 12, at least 36 tall; the label body
// 14 at weight 500 in `label`, the icon in the label's colour (the design's
// .85). ACTIVE = an `accent` fill with `onAccent` icon and label at weight 600.
// Tap dispatches `WinMenuPick(id)` — the app's reducer routes nav ids (by
// convention prefixed "nav.") to its section state. Rows sit 2 px apart in a
// list padded 4 8 (the app's `WinPane` body).
//
// `sub` adds a second line (caption 11/400 in `labelSecondary` — `onAccent`
// when active), the settings design's two-line row: 48 tall. `sub: ""` is the
// one-line row. `iconSize` is the glyph in px (16 when omitted; the settings
// design draws 18). `hasBadge` shows `badge` in an 18 px capsule at the end
// (caption 11/700 `onAccent` on `danger`; a 16 % `onAccent` wash when active).
//
// The icon sits in a PINNED box and the text column takes `.grow(1)`. Without
// both, a long label wins the flex negotiation and squeezes the icon to a
// two-pixel sliver — which is what the settings sidebar looked like the first
// time it shipped twelve German section names. `.hitSlop(4)` keeps the input
// target at 44 px over the 36 px rows.
//
// STORE CONTRACT (the consuming app declares these — the kit dispatches):
//   events  WinMenuPick(Str)

Component WinSideItem {
    props: {
        id: Str,
        label: Str,
        sub: Str,
        icon: Str,
        active: Bool,
        iconSize: Int,
        hasBadge: Bool,
        badge: Str,
    }
    if $props.active {
        Stack {
            Stack {
                Icon { symbol: $props.icon, size: $props.iconSize }
                    .fg(onAccent)
            }
            .width(16)
            .minWidth($props.iconSize)
            .maxWidth($props.iconSize)
            .shrink(0)
            .align(center)
            .justify(center)
            if $props.sub != "" {
                Stack {
                    Text($props.label).textStyle(body).fontWeight(semibold).fg(onAccent)
                    Text($props.sub).textStyle(caption).fontWeight(normal).fg(onAccent)
                }
                .gap(0)
                .grow(1)
            } else {
                Stack {
                    Text($props.label).textStyle(body).fontWeight(semibold).fg(onAccent)
                }
                .gap(0)
                .grow(1)
            }
            if $props.hasBadge {
                Stack {
                    Text($props.badge).textStyle(caption).fontWeight(bold).fg(onAccent)
                }
                .minWidth(18)
                .height(18)
                .paddingX(4)
                .rounded(full)
                .shrink(0)
                .align(center)
                .justify(center)
                .tint(onAccent)
            } else {
                Stack { }
                    .shrink(0)
            }
        }
        .direction(row)
        .align(center)
        .gap(12)
        .paddingY(6)
        .paddingX(12)
        .minHeight(36)
        .hitSlop(4)
        .rounded(md)
        .bg(accent)
        on Tap -> dispatch(WinMenuPick($props.id))
    } else {
        Stack {
            Stack {
                Icon { symbol: $props.icon, size: $props.iconSize }
                    .fg(label)
            }
            .width(16)
            .minWidth($props.iconSize)
            .maxWidth($props.iconSize)
            .shrink(0)
            .align(center)
            .justify(center)
            if $props.sub != "" {
                Stack {
                    Text($props.label).textStyle(body).fontWeight(medium).fg(label)
                    Text($props.sub).textStyle(caption).fontWeight(normal).fg(labelSecondary)
                }
                .gap(0)
                .grow(1)
            } else {
                Stack {
                    Text($props.label).textStyle(body).fontWeight(medium).fg(label)
                }
                .gap(0)
                .grow(1)
            }
            if $props.hasBadge {
                Stack {
                    Text($props.badge).textStyle(caption).fontWeight(bold).fg(onAccent)
                }
                .minWidth(18)
                .height(18)
                .paddingX(4)
                .rounded(full)
                .shrink(0)
                .align(center)
                .justify(center)
                .bg(danger)
            } else {
                Stack { }
                    .shrink(0)
            }
        }
        .direction(row)
        .align(center)
        .gap(12)
        .paddingY(6)
        .paddingX(12)
        .minHeight(36)
        .hitSlop(4)
        .rounded(md)
        on Tap -> dispatch(WinMenuPick($props.id))
    }
}
