//
// One navigation-sidebar row (design handoff `Sidebar`): icon + title
// (+ optional subtitle), accent-filled when active. Tap dispatches
// `WinMenuPick(id)` — the app's reducer routes nav ids (by convention
// prefixed "nav.") to its section state.
//
// The icon sits in a PINNED 16px box and the text column takes `.grow(1)`.
// Without both, a long two-line label wins the flex negotiation and squeezes
// the icon to a two-pixel sliver — which is what the settings sidebar looked
// like the first time it shipped twelve German section names.
//
// Two-line rows (title + smaller description, the handoff's DEFAULT sidebar
// form) are 38px with tight leading; `sub: ""` = the compact one-line row
// (32px, the handoff's "Sidebar kompakt"). Both carry `.hitSlop(3)` so the
// input target stays at ~44px even where the visual row is denser — the
// handoff's own sidebar rows are ~35px.

Component WinSideItem {
    props: {
        id: Str,
        label: Str,
        sub: Str,
        icon: Str,
        active: Bool,
    }
    if $props.active && $props.sub != "" {
        Stack {
            Stack {
                Icon { symbol: $props.icon, size: 15 }
                    .fg(onAccent)
            }
            .width(16)
            .align(center)
            .justify(center)
            Stack {
                Text($props.label).textSize(sm).leading(tight).fg(onAccent)
                Text($props.sub).textSize(xs).leading(tight).fg(onAccent)
            }
            .gap(0)
            .grow(1)
        }
        .direction(row)
        .align(center)
        .gap(2)
        .paddingX(2)
        .height(38)
        .hitSlop(3)
        .rounded(lg)
        .bg(accent)
        on Tap -> dispatch(WinMenuPick($props.id))
    } else if $props.active {
        Stack {
            Stack {
                Icon { symbol: $props.icon, size: 15 }
                    .fg(onAccent)
            }
            .width(16)
            .align(center)
            .justify(center)
            Stack {
                Text($props.label).textSize(sm).fg(onAccent)
            }
            .gap(0)
            .grow(1)
        }
        .direction(row)
        .align(center)
        .gap(2)
        .paddingX(2)
        .height(32)
        .hitSlop(3)
        .rounded(lg)
        .bg(accent)
        on Tap -> dispatch(WinMenuPick($props.id))
    } else if $props.sub != "" {
        Stack {
            Stack {
                Icon { symbol: $props.icon, size: 15 }
                    .fg(onGlassMuted)
            }
            .width(16)
            .align(center)
            .justify(center)
            Stack {
                Text($props.label).textSize(sm).leading(tight).fg(onGlass)
                Text($props.sub).textSize(xs).leading(tight).fg(onGlassMuted)
            }
            .gap(0)
            .grow(1)
        }
        .direction(row)
        .align(center)
        .gap(2)
        .paddingX(2)
        .height(38)
        .hitSlop(3)
        .rounded(lg)
        on Tap -> dispatch(WinMenuPick($props.id))
    } else {
        Stack {
            Stack {
                Icon { symbol: $props.icon, size: 15 }
                    .fg(onGlassMuted)
            }
            .width(16)
            .align(center)
            .justify(center)
            Stack {
                Text($props.label).textSize(sm).fg(onGlass)
            }
            .gap(0)
            .grow(1)
        }
        .direction(row)
        .align(center)
        .gap(2)
        .paddingX(2)
        .height(32)
        .hitSlop(3)
        .rounded(lg)
        on Tap -> dispatch(WinMenuPick($props.id))
    }
}
