//
// The VISUAL of one floating-action-bar button (design handoff
// `WindowActionBar`): icon over label, column layout, pill-shaped hit area.
// `kind`: "" default · "primary" filled accent circle behind the icon ·
// "danger" red.
//
// Deliberately handler-free. A bar's items dispatch APP events (`NewFolder`,
// `CopySel`, …) as often as they dispatch the kit's `WinAct(id)`, and a
// dispatch target is a static case name — there is no way to pass one as a
// prop. So the kit owns the look and the app owns the tap: wrap this in a
// `Stack { … } on Tap -> dispatch(YourEvent)`. `WinActionItem` is the thin
// wrapper for the kit-standard `WinAct(id)` case.

Component WinActionFace {
    props: {
        label: Str,
        icon: Str,
        kind: Str,
    }
    Stack {
        if $props.kind == "primary" {
            Circle { size: 26
                Icon { symbol: $props.icon, size: 14 }
                    .fg(onAccent)
            }
            .bg(accent)
        } else {
            if $props.kind == "danger" {
                Icon { symbol: $props.icon, size: 16 }
                    .fg(danger)
            } else {
                Icon { symbol: $props.icon, size: 16 }
                    .fg(onSurface)
            }
        }
        if $props.kind == "danger" {
            Text($props.label).textSize(xs).fg(danger)
        } else {
            Text($props.label).textSize(xs).fg(onSurfaceVariant)
        }
    }
    .align(center)
    .justify(center)
    .gap(1)
    .width(66)
    .height(52)
    .rounded(full)
}
