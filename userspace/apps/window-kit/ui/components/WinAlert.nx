//
// The design artifacts' ALERT: a compact confirmation card on the frosted
// overlay surface (glassOverlay, a 1 px glassEdge, shadow4, radius 24), 300
// wide, over a `scrim` with 24 px around it. Text block, centred, padding 20 16
// 16: the title (title3 17/22, `label`) and one sentence 4 below it
// (subheadline 13/18, `label`). Then two text buttons side by side, edge to
// edge (padding 12 16 → 46 px), title3, `accent`: cancel at weight 400, the
// confirm at 600 — or `danger` at 400 when `destructive`; a hairline above
// them and one between them. An app-modal layer (TASK-0074 / ADR-0068): while
// it is open the runtime confines hit-testing and text focus to it and windowd
// refuses input on the app's other windows.
//
// Like the design's alert it CLOSES ON A BACKDROP TAP: a tap on the layer that
// no handler takes fires `on Dismiss`, which cancels; the card eats its own
// taps (`WinNoop`) so a press on its text never does. ESC, the backdrop and the
// cancel button all dispatch `AlertCancel(id)` — the handler is the ONE way
// out besides the confirm.
//
// It enters as the design artifacts' dialogs do (`fadeScale`): rising 10px and
// growing in from 0.94 on the spring, over its scrim fading in quicker — the
// compositor moves it in front of every window (RFC-0109 §motion layers).
//
// STORE CONTRACT (the consuming app declares these — the kit dispatches):
//   events  AlertConfirm(Str) · AlertCancel(Str) · WinNoop

Component WinAlert {
    props: {
        id: Str,
        title: Str,
        message: Str,
        cancelLabel: Str,
        confirmLabel: Str,
        destructive: Bool,
    }
    Stack {
        Stack {
            Stack { }
                .grow(1)
                .shrink(0)
            Stack {
                Stack {
                    Text($props.title).textStyle(title3).fg(label).textAlign(center)
                    Text($props.message).textStyle(subheadline).fg(label).textAlign(center)
                }
                .gap(4)
                .paddingTop(20)
                .paddingX(16)
                .paddingBottom(16)
                Stack { }
                    .height(1)
                    .bg(separator)
                Stack {
                    Stack {
                        Text($props.cancelLabel).textStyle(title3).fontWeight(normal).fg(accent).textAlign(center)
                    }
                    .basis(0)
                    .grow(1)
                    .paddingY(12)
                    .paddingX(16)
                    on Tap -> dispatch(AlertCancel($props.id))
                    Stack { }
                        .width(1)
                        .bg(separator)
                    if $props.destructive {
                        Stack {
                            Text($props.confirmLabel).textStyle(title3).fontWeight(normal).fg(danger).textAlign(center)
                        }
                        .basis(0)
                        .grow(1)
                        .paddingY(12)
                        .paddingX(16)
                        on Tap -> dispatch(AlertConfirm($props.id))
                    } else {
                        Stack {
                            Text($props.confirmLabel).textStyle(title3).fg(accent).textAlign(center)
                        }
                        .basis(0)
                        .grow(1)
                        .paddingY(12)
                        .paddingX(16)
                        on Tap -> dispatch(AlertConfirm($props.id))
                    }
                }
                .direction(row)
            }
            .basis(300)
            .shrink(1)
            .material(overlay)
            .shadow(shadow4)
            .rounded(xl)
            .overflow(hidden)
            on Tap -> dispatch(WinNoop)
            Stack { }
                .grow(1)
                .shrink(0)
        }
        .direction(row)
    }
    .justify(center)
    .padding(24)
    .overlay(modal)
    .bg(scrim)
    .transition(fadeScale)
    on Dismiss -> dispatch(AlertCancel($props.id))
}
