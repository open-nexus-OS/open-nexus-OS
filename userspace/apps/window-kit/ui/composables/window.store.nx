//
// The window chrome's state (RFC-0084, TASK-0357 P4): what `WinTopBar`, `WinAppChip`,
// `WinAppWindow` and `WinAppMenuLayer` read and dispatch — the open chrome menu, the panes'
// visibility in both senses (inline on the wide tier, as overlays below it), and the last
// refused window control. An app that uses the chrome gets this store with it — the compiler
// adds a library's composable when the app or a component it uses reads a field of its store —
// and declares none of it. An app reacts to a window event with an effect of its own that
// dispatches its own event: `@effect on WinMenuPick(id) { dispatch(NavPick(id)); }`,
// `@effect on WinNav(dir) { … }`, `@effect on WinTool(t) { … }`.
//
// `WinAct(a)` forwards window controls (minimize, zoom, close, move, the tiling zones) to windowd
// through `svc.settings.set("window.control", …)` — the channel every window-kit app uses.

Store WindowStore {
    // The open chrome menu: "" = closed, else "app" | "more" | an app's submenu id.
    menu: Str = "",
    // Inline pane visibility (the wide tier); the properties pane starts hidden.
    leftOpen: Int = 1,
    rightOpen: Int = 0,
    // The overlay twins (regular and compact tiers), CLOSED by default — a phone mount must not
    // boot with a pane over the content. The same top-bar buttons toggle both senses; only the
    // visible one matters per size class.
    paneL: Int = 0,
    paneR: Int = 0,
    // Non-zero when a window-control forward was refused.
    winError: Int = 0,
}

Event WindowEvent {
    WinMenu(Str),
    WinNoop,
    WinPaneClose,
    WinLeft,
    WinRight,
    WinTool(Str),
    WinAct(Str),
    WinNav(Str),
    WinMenuPick(Str),
    WinActApplied(Bool),
    WinActFailed(Int),
}

reduce WindowEvent {
    WinMenu(m) => {
        if state.menu == m {
            state.menu = "";
        } else {
            state.menu = m;
        }
    },
    // Consume-tap for a panel inside an overlay layer: without it the backdrop's own handler
    // would close the layer the user just reached into.
    WinNoop => state.menu = state.menu,
    WinPaneClose => {
        state.paneL = 0;
        state.paneR = 0;
    },
    WinLeft => {
        if state.leftOpen == 1 {
            state.leftOpen = 0;
        } else {
            state.leftOpen = 1;
        }
        if state.paneL == 1 {
            state.paneL = 0;
        } else {
            state.paneL = 1;
        }
    },
    WinRight => {
        if state.rightOpen == 1 {
            state.rightOpen = 0;
        } else {
            state.rightOpen = 1;
        }
        if state.paneR == 1 {
            state.paneR = 0;
        } else {
            state.paneR = 1;
        }
    },
    // A tool, a navigation step, a pick and a window control all close an open chrome menu;
    // what they mean is the app's (its effect on the event).
    WinTool(t) => state.menu = "",
    WinAct(a) => state.menu = "",
    WinNav(dir) => state.menu = "",
    WinMenuPick(id) => state.menu = "",
    WinActApplied(ok) => state.winError = 0,
    WinActFailed(code) => state.winError = code,
}

@effect on WinAct(a) {
    match svc.settings.set("window.control", a) {
        Ok(ok) => dispatch(WinActApplied(ok)),
        Err(e) => dispatch(WinActFailed(e)),
    }
}
