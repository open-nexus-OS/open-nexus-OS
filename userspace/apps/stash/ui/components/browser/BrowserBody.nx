//
// The content pane's body in file mode: the search strip, the list view's
// column header, then — by the
// listing's honest state, in order — the load error, the spinner, the empty
// folder, no search hits, and last the rows or tiles. An empty folder and an
// empty search are different statements and say different things.

Component BrowserBody {
    Stack {
        SearchStrip { }
        if $state.viewMode == "list" {
            ColumnHeader { }
        } else {
            Stack { }
        }
        if $state.filesError != 0 {
            ListingState { icon: "info.circle", title: @t("stash.loadError"), body: "", busy: false, action: false }
        } else if $state.filesLoading == 1 {
            ListingState { icon: "", title: @t("stash.loading"), body: "", busy: true, action: false }
        } else if $state.fileCount == 0 && $state.searchQuery != "" {
            ListingState { icon: "magnifyingglass", title: @t("stash.noResults"), body: @t("stash.noResultsBody"), busy: false, action: false }
        } else if $state.fileCount == 0 {
            ListingState { icon: "folder", title: @t("stash.empty"), body: @t("stash.emptyBody"), busy: false, action: true }
        } else if $state.viewMode == "grid" {
            FileGrid { }
        } else {
            FileList { }
        }
    }
    .gap(0)
    .grow(1)
}
