// Settings mode's one header action: the arrow back to the files.

Component SettingsBack {
    Stack {
        Stack {
            Icon { symbol: "arrow.left", size: 13 }
                .fg(labelSecondary)
        }
        .width(30)
        .height(30)
        .rounded(full)
        .align(center)
        .justify(center)
        .label(@t("stash.backToFiles"))
        on Tap -> dispatch(SettingsClose)
    }
}
