//
// File ▸: New folder is real (NewFolder → svc.files.mkdir); "To trash" acts
// on the selection and is disabled without one. New window, Open and Compress
// have no service behind them yet and are shown disabled.

Component FileMenu {
    WinMenu { width: 220 } {
        items {
            WinMenuRow { label: @t("stash.newWindow"), icon: "app.window", kind: "disabled", shortcut: "", selected: false }
            Stack {
                WinMenuRow { label: @t("stash.newFolder"), icon: "folder.badge.plus", kind: "", shortcut: "", selected: false }
            }
            on Tap -> dispatch(NewFolder)
            WinMenuRow { label: @t("win.open"), icon: "folder", kind: "disabled", shortcut: "", selected: false }
            WinMenuDivider { }
            WinMenuRow { label: @t("stash.compress"), icon: "archivebox", kind: "disabled", shortcut: "", selected: false }
            if $state.selection == "" {
                WinMenuRow { label: @t("stash.toTrash"), icon: "trash", kind: "disabled", shortcut: "", selected: false }
            } else {
                Stack {
                    WinMenuRow { label: @t("stash.toTrash"), icon: "trash", kind: "danger", shortcut: "", selected: false }
                }
                on Tap -> dispatch(TrashSel)
            }
        }
    }
}
