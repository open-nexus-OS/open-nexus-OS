//
// stash — the platform file manager, built on the window kit (RFC-0084). The
// page only composes: the kit's top bar and three-zone body, one feature
// component per zone, and the dialogs. State lives in the stores under
// `ui/composables/` (window, nav, listing, selection, toolbar, view, file
// operations); see the README for the map.

// FREEFORM, not fullscreen — a VISUAL contract: `mode: fullscreen` makes
// app-host paint an OPAQUE page base and makes windowd skip the per-window
// backdrop-blur band, so a fullscreen window can never show the wallpaper. A
// freeform window takes the translucent base and a real `LayerBackdrop`, which
// is what the design draws: a floating glass window over the wallpaper.
// `style: plain` suppresses windowd's own title bar — this page owns its
// chrome through `WinTopBar`.
Window {
    style: plain,
    mode: freeform,
    resizable: true,
}

Page StashPage {
    Stack {
        WinTopBar {
            icon: "folder",
            tool1: "magnifyingglass",
            tool2: "square.grid.2x2",
            tool3: "list.bullet",
            tool1Active: $state.searchOpen == 1,
            tool2Active: $state.viewMode == "grid",
            tool3Active: $state.viewMode == "list",
            navBack: "arrow.left",
            navFwd: "arrow.right",
            navRefresh: "arrow.clockwise",
            sideLeft: "sidebar.left",
            sideRight: "sidebar.right",
            more: "ellipsis.vertical",
            appId: "stash",
        }
        WinAppWindow {
            showSidebar: $state.leftOpen == 1,
            showProps: $state.rightOpen == 1 && $state.settingsOpen == 0,
            sidebarOverlay: $state.paneL == 1,
            propsOverlay: $state.paneR == 1 && $state.settingsOpen == 0,
            sidebarWidth: 248,
            propsWidth: 272,
            appMenuOpen: $state.menu == "more" || $state.menu == "more.datei" || $state.menu == "more.ansicht",
            menuFullscreen: @t("win.fullscreen"),
            menuMoveDevice: @t("win.moveDevice"),
            menuMinimize: @t("win.minimize"),
            menuClose: @t("win.close"),
        } {
            sidebarLeft {
                StashSidebar { }
            }
            contentArea {
                ContentPane { }
            }
            sidebarRight {
                PropsPane { }
            }
            actionBar {
                StashActionBar { }
            }
            appMenu {
                MoreMenu { }
            }
        }
        if $state.moveOpen == 1 {
            MovePicker { }
        } else {
            Stack { }
        }
        if $state.menu == "ctx" {
            SelectionMenu { }
        } else {
            Stack { }
        }
    }
    .grow(1)
}
