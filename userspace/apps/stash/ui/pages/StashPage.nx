// Copyright 2026 Open Nexus OS Contributors
// SPDX-License-Identifier: Apache-2.0
//
// stash — the platform file manager, built on `WinAppWindow` (RFC-0084).
//
// The three-zone body is the KIT's; this page fills the slots AND writes its
// own surfaces. Every region opens with a `Panel` on the `windowPane` level
// (the handoff's `--glass-window-pane-bg`) — the kit paints nothing, so
// "how many panels, at which level, where" is a line of app markup rather than
// a prop axis. The settings mode uses that directly: a second `Panel` stacked
// inside the content pane, which the old Bool flag could only express by
// turning the region's panel off and hand-rolling both.
//
// Everything else is the design handoff (`docs/design_handoff_files_window`):
// window-kit chrome with active tool states, a search field that filters the
// listing, a breadcrumb with the object count and sort controls, real file
// rows (svc.files.list → vfsd ReadDir, TASK-0291) with honest loading/error
// states, the SELECTION REACTIVITY proof (properties pane + action bar both
// swap on selection), and the settings mode that replaces the content.

// FREEFORM, not fullscreen — and that is a VISUAL contract, not a preference.
// `mode: fullscreen` makes app-host paint an OPAQUE page base
// (`probe/mod.rs`: base_alpha 255, the kiosk rule) and makes windowd skip the
// per-window backdrop-blur band (`app_surface.rs`, an atlas-budget decision).
// Together those two mean a fullscreen window can never show the wallpaper —
// the panes then frost an opaque slab instead of the desktop behind it. A
// freeform window takes base_alpha 168 and a real `LayerBackdrop`, which is
// what the handoff draws: a floating glass window over the wallpaper.
//
// `style: plain` still suppresses windowd's own title bar — this page owns its
// chrome through `WinTopBar`.
Window {
    style: plain,
    mode: freeform,
    resizable: true,
}

Page StashPage {
    Stack {
        WinTopBar {
            icon: "folder",
            tool1: "magnifyingglass",
            tool2: "square.grid.2x2",
            tool3: "list.bullet",
            tool1Active: $state.searchOpen == 1,
            tool2Active: $state.viewMode == "grid",
            tool3Active: $state.viewMode == "list",
            navBack: "chevron.left",
            navFwd: "chevron.right",
            navRefresh: "arrow.clockwise",
            appId: "stash",
        }
        WinAppWindow {
            showSidebar: $state.leftOpen == 1,
            showProps: $state.rightOpen == 1 && $state.settingsOpen == 0,
            sidebarOverlay: $state.paneL == 1,
            propsOverlay: $state.paneR == 1 && $state.settingsOpen == 0,
        } {
            sidebarLeft {
              Panel {
                Text(@t("stash.nav")).textSize(xs).fg(onGlassMuted)
                Stack { }
                    .height(1)
                    .bg(divider)
                WinSideItem { id: "nav.recent", label: @t("stash.recent"), sub: "", icon: "star", active: $state.section == "recent" }
                WinSideItem { id: "nav.pictures", label: @t("stash.pictures"), sub: "", icon: "photo", active: $state.section == "pictures" }
                WinSideItem { id: "nav.videos", label: @t("stash.videos"), sub: "", icon: "film", active: $state.section == "videos" }
                WinSideItem { id: "nav.audio", label: @t("stash.audio"), sub: "", icon: "music.note", active: $state.section == "audio" }
                WinSideItem { id: "nav.docs", label: @t("stash.docs"), sub: "", icon: "doc.text", active: $state.section == "docs" }
                WinSideItem { id: "nav.downloads", label: @t("stash.downloads"), sub: "", icon: "arrow.down.circle", active: $state.section == "downloads" }
                WinSideItem { id: "nav.storage", label: @t("stash.storage"), sub: "", icon: "internaldrive", active: $state.section == "storage" }
                WinSideItem { id: "nav.trash", label: @t("stash.trash"), sub: "", icon: "trash", active: $state.section == "trash" }
                Spacer
                Stack { }
                    .height(1)
                    .bg(divider)
                // Account footer (handoff: `Avatar` + name + sub above a
                // `borderTop`). `Avatar` derives its initials from `name`, so
                // the page binds the display name it already has.
                Stack {
                    Avatar { name: @t("stash.userName"), size: 34 }
                    Stack {
                        Text(@t("stash.userName")).textSize(sm).fg(onGlass)
                        Text(@t("stash.userSub")).textSize(xs).fg(onGlassMuted)
                    }
                    .gap(0)
                }
                .direction(row)
                .align(center)
                .gap(2)
                .paddingX(2)
              }
              .material(windowPane)
              .grow(1)
            }
            contentArea {
              Panel {
                // ── SETTINGS MODE ────────────────────────────────────
                // Replaces the file content wholesale; the properties pane
                // and the action bar are gone (the pane via `showProps` on
                // the scaffold, the bar because this arm never draws it).
                if $state.settingsOpen == 1 {
                    Stack {
                        Stack {
                            Icon { symbol: "chevron.left", size: 15 }
                                .fg(onGlassMuted)
                        }
                        .width(28)
                        .height(28)
                        .rounded(md)
                        .align(center)
                        .justify(center)
                        on Tap -> dispatch(SettingsClose)
                        Icon { symbol: "gearshape", size: 15 }
                            .fg(onGlassMuted)
                        Text(@t("stash.settings")).textSize(sm).fg(onGlassStrong)
                        Spacer
                    }
                    .direction(row)
                    .align(center)
                    .gap(2)
                    Stack {
                        Text(@t("stash.setViewSection")).textSize(xs).fg(onGlassMuted)
                        Text(@t("stash.setViewHint")).textSize(xs).fg(onGlassMuted)
                    }
                    .gap(0)
                    .paddingX(2)
                    // The design's settings CARD: a bordered raised surface
                    // inside the content panel — a second panel in the same
                    // region, which the scaffold permits precisely because it
                    // paints none of its own.
                    Panel {
                        Stack {
                            Stack {
                                Text(@t("stash.setHidden")).textSize(sm).fg(onGlass)
                                Text(@t("stash.setHiddenHint")).textSize(xs).fg(onGlassMuted)
                            }
                            .gap(0)
                            .grow(1)
                            Toggle { checked: $state.showHidden, label: @t("stash.setHidden") }
                            on Tap -> dispatch(ToggleHidden)
                        }
                        .direction(row)
                        .align(center)
                        .gap(2)
                        .height(56)
                    }
                    .material(card)
                    Spacer
                } else {
                    // ── FILE CONTENT ─────────────────────────────────
                    // Breadcrumb, three levels like the handoff
                    // (Dieser PC › Bilder › Urlaub 2026). No new state: the
                    // middle crumb is `backLabel`, which every nav arm and the
                    // folder-open in `Pick` already write as "the label we came
                    // from". The leaf is the only STRONG/semibold crumb; the
                    // ancestors are muted and tappable.
                    Stack {
                        Stack {
                            Text(@t("stash.thisPc")).textSize(sm).fg(onGlassMuted)
                        }
                        on Tap -> dispatch(WinMenuPick("nav.storage"))
                        if $state.backLabel != "" {
                            Stack {
                                Icon { symbol: "chevron.right", size: 12 }
                                    .fg(onGlassMuted)
                                Stack {
                                    Text($state.backLabel).textSize(sm).fg(onGlassMuted)
                                }
                                on Tap -> dispatch(WinNav("back"))
                            }
                            .direction(row)
                            .align(center)
                            .gap(1)
                        } else {
                            Stack { }
                        }
                        if $state.folderLabel != "" {
                            Stack {
                                Icon { symbol: "chevron.right", size: 12 }
                                    .fg(onGlassMuted)
                                Text($state.folderLabel).textSize(sm).fg(onGlassStrong).fontWeight(semibold)
                            }
                            .direction(row)
                            .align(center)
                            .gap(1)
                        } else {
                            Stack { }
                        }
                        Spacer
                        // "10 Objekte" — the design puts the COUNT in front of
                        // the noun. `fileCount` starts at its 1 = "unknown,
                        // non-empty" sentinel and is replaced by the real
                        // `svc.files.count` a round-trip later, so this reads
                        // "1" for one frame after a navigation.
                        Text($state.fileCount).textSize(xs).fg(onGlassMuted)
                        Text(@t("stash.objects")).textSize(xs).fg(onGlassMuted)
                        // Sort controls (design: direction · by size · by type)
                        Stack {
                            Icon { symbol: "arrow.up.arrow.down", size: 13 }
                                .fg(onGlassMuted)
                        }
                        .width(26)
                        .height(26)
                        .rounded(md)
                        .align(center)
                        .justify(center)
                        on Tap -> dispatch(SortDir)
                        Stack {
                            Icon { symbol: "shippingbox", size: 13 }
                                .fg(onGlassMuted)
                        }
                        .width(26)
                        .height(26)
                        .rounded(md)
                        .align(center)
                        .justify(center)
                        on Tap -> dispatch(SortBy("size"))
                        Stack {
                            Icon { symbol: "folder", size: 13 }
                                .fg(onGlassMuted)
                        }
                        .width(26)
                        .height(26)
                        .rounded(md)
                        .align(center)
                        .justify(center)
                        on Tap -> dispatch(SortBy("kind"))
                    }
                    .direction(row)
                    .align(center)
                    .gap(1)
                    // ── SEARCH FIELD ─────────────────────────────────
                    // Between the header and the list, exactly where the
                    // design puts it: a RAISED strip (`glassFill` over the
                    // pane + a `divider` hairline, radius sm) rather than a
                    // bare field, and a row-closing hairline underneath —
                    // `OsAppWindow.dc.html:33-41`.
                    //
                    // `TextField { variant: "bare" }`, NOT `SearchBar`.
                    // `SearchBar` renders a `TextInput` but is absent from the
                    // auto-bind list (`lower/views.rs`), so its hit does not
                    // resolve to a `Bind` and `focus_text_at` CLEARS focus —
                    // the field could not be typed into at all. `bare` keeps
                    // the widget from drawing its own box inside this one.
                    //
                    // `.transition(fade)` is enter-only by design
                    // (`probe/anim.rs`): the field fades IN and closes hard.
                    // Stated rather than faked.
                    if $state.searchOpen == 1 {
                        Stack {
                            Stack {
                                Icon { symbol: "magnifyingglass", size: 13 }
                                    .fg(onGlassMuted)
                                // `on Change` on the WRAPPER is the live-filter
                                // contract: the auto-bind writes `searchQuery`,
                                // and the enclosing dispatch re-issues the
                                // listing on every keystroke. Both launchers
                                // use the same shape.
                                Stack {
                                    // `.label(…)` (a11y name, renders nothing),
                                    // NOT the `label:` prop — that one draws a
                                    // visible caption line the design has no
                                    // room for. Same shape as the greeter's
                                    // passphrase field.
                                    // `.grow(1)` has to be on the FIELD and the
                                    // wrapper has to be a ROW, because the hit
                                    // box is the `TextInput` itself and a
                                    // default (column) Stack grows a child's
                                    // HEIGHT while leaving its width intrinsic.
                                    // With either half missing the strip paints
                                    // full width over a ~180px input: a click
                                    // right of the text claims no focus,
                                    // windowd records no text route, and every
                                    // imed commit for this surface is dropped.
                                    TextField {
                                        value: $state.searchQuery,
                                        placeholder: @t("stash.searchHint"),
                                        variant: "bare",
                                    }
                                    .grow(1)
                                    .label(@t("stash.searchHint"))
                                }
                                .direction(row)
                                .align(center)
                                .grow(1)
                                on Change -> dispatch(SearchChanged)
                                Stack {
                                    Icon { symbol: "xmark", size: 12 }
                                        .fg(onGlassMuted)
                                }
                                .width(24)
                                .height(24)
                                .rounded(md)
                                .align(center)
                                .justify(center)
                                on Tap -> dispatch(SearchClear)
                            }
                            .direction(row)
                            .align(center)
                            .gap(2)
                            .paddingX(2)
                            .height(32)
                            .rounded(sm)
                            .bg(glassFill)
                            .border(hairline)
                            .borderColor(divider)
                            Stack { }
                                .height(1)
                                .bg(divider)
                        }
                        .gap(1)
                        .transition(fade)
                    } else {
                        Stack { }
                    }
                    // Column headers, pinned to the row metrics.
                    if $state.viewMode == "list" {
                        Stack {
                            Stack {
                                Text(@t("stash.colName")).textSize(xs).fg(onGlassMuted)
                                Spacer
                                Text(@t("stash.colDate")).textSize(xs).fg(onGlassMuted).width(80).textAlign(right)
                                Text(@t("stash.colSize")).textSize(xs).fg(onGlassMuted).width(68).textAlign(right)
                            }
                            .direction(row)
                            .align(center)
                            .gap(2)
                            .paddingX(2)
                            Stack { }
                                .height(1)
                                .bg(divider)
                        }
                        .gap(1)
                    } else {
                        Stack { }
                    }
                    // REAL listing (svc.files.list → vfsd ReadDir, TASK-0291);
                    // honest loading/error states, never fake rows.
                    if $state.filesError != 0 {
                        Text(@t("stash.loadError")).textSize(sm).fg(onGlassMuted)
                    } else {
                        if $state.filesLoading == 1 {
                            Text(@t("stash.loading")).textSize(sm).fg(onGlassMuted)
                        } else {
                            if $state.fileCount == 0 {
                                // "Keine Objekte gefunden" vs "der Ordner ist
                                // leer" are DIFFERENT statements, and the
                                // handoff makes both. `stash.noResults` shipped
                                // in all five locales and was referenced by no
                                // line of markup; an active query now picks it.
                                if $state.searchQuery != "" {
                                    Text(@t("stash.noResults")).textSize(sm).fg(onGlassMuted)
                                } else {
                                    Text(@t("stash.empty")).textSize(sm).fg(onGlassMuted)
                                }
                            } else {
                                if $state.viewMode == "grid" {
                                    List($state.files) { f in
                                        Stack {
                                            FileTile { id: f.name, name: f.name, kind: f.kind, size: f.sizeText, icon: f.icon, active: $state.selection == f.name }
                                        }
                                        .key(f.name)
                                    }
                                    .direction(row)
                                    .wrap(true)
                                    .gap(3)
                                    .paddingX(2)
                                } else {
                                    List($state.files) { f in
                                        Stack {
                                            FileRow { id: f.name, name: f.name, kind: f.kind, date: f.date, size: f.sizeText, icon: f.icon, active: $state.selection == f.name }
                                        }
                                        .key(f.name)
                                    }
                                }
                            }
                        }
                    }
                    Spacer
                    // ── FLOATING ACTION BAR ──────────────────────────
                    // A glass pill at the bottom of the content region. The
                    // item set IS the selection reactivity — no selection =
                    // create/sort, a selected file = file operations. Hidden
                    // in the Recent aggregation (its entries live in other
                    // folders; ops would target the wrong paths).
                    if $state.path == "recent:" {
                        Stack { }
                    } else {
                        Stack {
                            Spacer
                            Panel {
                                if $state.selection == "" {
                                    Stack {
                                        // Real write: NewFolder → svc.files.mkdir (nxfs /data).
                                        Stack {
                                            WinActionFace { label: @t("stash.actNew"), icon: "plus", kind: "primary" }
                                        }
                                        on Tap -> dispatch(NewFolder)
                                        // Sort cycles name → kind → date (app-host reorders).
                                        Stack {
                                            WinActionFace { label: @t("stash.actSort"), icon: "arrow.up.arrow.down", kind: "" }
                                        }
                                        on Tap -> dispatch(CycleSort)
                                        WinActionItem { id: "more", label: @t("stash.actMore"), icon: "ellipsis", kind: "" }
                                    }
                                    .direction(row)
                                    .align(center)
                                    .gap(1)
                                } else {
                                    Stack {
                                        // Real move: opens the destination picker.
                                        Stack {
                                            WinActionFace { label: @t("stash.actMove"), icon: "move", kind: "primary" }
                                        }
                                        on Tap -> dispatch(MoveStart)
                                        // Real copy: duplicates in place as "Kopie von <name>".
                                        Stack {
                                            WinActionFace { label: @t("stash.actCopy"), icon: "doc.on.doc", kind: "" }
                                        }
                                        on Tap -> dispatch(CopySel)
                                        WinActionItem { id: "share", label: @t("stash.actShare"), icon: "square.and.arrow.up", kind: "" }
                                        // Delete: outside /Papierkorb it SOFT-deletes
                                        // (moves to the trash); inside /Papierkorb it
                                        // hard-removes and offers Wiederherstellen.
                                        if $state.path == "/Papierkorb" {
                                            Stack {
                                                WinActionFace { label: @t("stash.actRestore"), icon: "arrow.uturn.backward", kind: "" }
                                            }
                                            on Tap -> dispatch(RestoreSel)
                                        } else {
                                            Stack { }
                                        }
                                        if $state.path == "/Papierkorb" {
                                            Stack {
                                                WinActionFace { label: @t("stash.actDelete"), icon: "trash", kind: "danger" }
                                            }
                                            on Tap -> dispatch(DeleteSel)
                                        } else {
                                            Stack {
                                                WinActionFace { label: @t("stash.actDelete"), icon: "trash", kind: "danger" }
                                            }
                                            on Tap -> dispatch(TrashSel)
                                        }
                                        // Divider before "Mehr" (design handoff).
                                        Stack { }
                                            .width(1)
                                            .height(34)
                                            .bg(divider)
                                        WinActionItem { id: "more", label: @t("stash.actMore"), icon: "ellipsis", kind: "" }
                                    }
                                    .direction(row)
                                    .align(center)
                                    .gap(1)
                                }
                            }
                            .material(windowBar)
                            .padding(1)
                            .rounded(full)
                            .shadow(lg)
                            Spacer
                        }
                        .direction(row)
                        .align(center)
                    }
                }
              }
              .material(windowPane)
              .grow(1)
            }
            sidebarRight {
              Panel {
                Text(@t("stash.props")).textSize(sm).fg(onGlassStrong).fontWeight(semibold)
                if $state.selection == "" {
                    Text(@t("stash.propsEmpty")).textSize(xs).fg(onGlassMuted)
                } else {
                    Stack {
                        // Handoff property icons: folder · box (size) ·
                        // calendar (created) · square-pen (modified) · lock (id).
                        WinPropRow { label: @t("stash.propKind"), value: $state.selKind, icon: "folder" }
                        WinPropRow { label: @t("stash.propSize"), value: $state.selSize, icon: "shippingbox" }
                        WinPropRow { label: @t("stash.propCreated"), value: $state.selDate, icon: "calendar" }
                        WinPropRow { label: @t("stash.propDate"), value: $state.selDate, icon: "square.pencil" }
                        WinPropRow { label: @t("stash.propId"), value: $state.selName, icon: "lock" }
                    }
                    .gap(0)
                }
              }
              .material(windowPane)
              .grow(1)
            }
        }
        // ── OVERLAYS ─────────────────────────────────────────────────
        // `.overlay()` lifts these out of flow, so they float over the whole
        // window regardless of which region is open.
        //
        // ANCHORING. `.overlay()` has no anchor API — the layer fills the
        // parent's content box and you position INSIDE it with ordinary flex.
        // The menus used to sit at y=0, i.e. ON TOP of the chrome they belong
        // to. A leading spacer of chrome-height + 6 puts them where the handoff
        // draws a dropdown (`top: calc(100% + 6px)`), and the row's `Spacer`
        // keeps the app menu under the app chip (left) while "Mehr" and its
        // submenus stay under the ⋯ (right).
        if $state.menu == "" {
            Stack { }
        } else {
            Stack {
                Stack { }
                    .height(46)
                Stack {
                    if $state.menu == "app" {
                        Stack {
                            Panel {
                                Text(@t("win.mode")).textSize(xs).fg(onGlassMuted)
                                WinMenuItem { id: "mode.split", label: @t("win.split"), icon: "columns.2", kind: "", act: true }
                                WinMenuItem { id: "mode.fullscreen", label: @t("win.fullscreen"), icon: "maximize", kind: "check", act: true }
                                WinMenuItem { id: "mode.freeform", label: @t("win.freeform"), icon: "square", kind: "", act: true }
                                Stack { }
                                    .height(1)
                                    .bg(divider)
                                WinMenuItem { id: "minimize", label: @t("win.minimize"), icon: "minimize", kind: "", act: true }
                                WinMenuItem { id: "close", label: @t("win.close"), icon: "xmark", kind: "danger", act: true }
                            }
                            .material(overlay)
                            .width(230)
                            .gap(0)
                            .padding(1)
                        }
                        on Tap -> dispatch(WinNoop)
                    } else {
                        Stack { }
                    }
                    Spacer
                    if $state.menu == "more.datei" {
                        Stack {
                            Panel {
                                WinMenuItem { id: "new", label: @t("win.new"), icon: "plus", kind: "", act: true }
                                WinMenuItem { id: "share", label: @t("stash.actShare"), icon: "square.and.arrow.up", kind: "", act: true }
                                WinMenuItem { id: "delete", label: @t("stash.actDelete"), icon: "trash", kind: "danger", act: true }
                            }
                            .material(overlay)
                            .width(200)
                            .gap(0)
                            .padding(1)
                        }
                        on Tap -> dispatch(WinNoop)
                    } else {
                        if $state.menu == "more.ansicht" {
                            Stack {
                                Panel {
                                    WinMenuItem { id: "ansicht.liste", label: @t("win.viewList"), icon: "list.bullet", kind: "check", act: false }
                                    WinMenuItem { id: "ansicht.raster", label: @t("win.viewGrid"), icon: "square.grid.3x3", kind: "", act: false }
                                    WinMenuItem { id: "ansicht.props", label: @t("win.viewProps"), icon: "sidebar.right", kind: "", act: false }
                                }
                                .material(overlay)
                                .width(220)
                                .gap(0)
                                .padding(1)
                            }
                            on Tap -> dispatch(WinNoop)
                        } else {
                            Stack { }
                        }
                    }
                    if $state.menu == "more" {
                        Stack {
                            Panel {
                                WinMenuItem { id: "more.datei", label: @t("win.file"), icon: "doc", kind: "sub", act: false }
                                WinMenuItem { id: "more.ansicht", label: @t("win.view"), icon: "eye", kind: "sub", act: false }
                                Stack { }
                                    .height(1)
                                    .bg(divider)
                                WinMenuItem { id: "more.einstellungen", label: @t("stash.settings"), icon: "gearshape", kind: "", act: false }
                                WinMenuItem { id: "help", label: @t("win.help"), icon: "info.circle", kind: "", act: false }
                            }
                            .material(overlay)
                            .width(210)
                            .gap(0)
                            .padding(1)
                        }
                        on Tap -> dispatch(WinNoop)
                    } else {
                        Stack { }
                    }
                }
                .direction(row)
                .align(start)
                .paddingX(2)
                .grow(1)
                .transition(fade)
            }
            .overlay()
            on Tap -> dispatch(WinMenu(""))
        }
        // Move-destination picker: tap a folder to move the selection there
        // (svc.files.rename across directories); tap the backdrop to cancel.
        if $state.moveOpen == 1 {
            Stack {
                Stack {
                    Panel {
                        Text(@t("stash.moveTitle")).textSize(sm).fg(onGlassMuted)
                        MoveDest { path: "/Bilder", label: @t("stash.pictures") }
                        MoveDest { path: "/Videos", label: @t("stash.videos") }
                        MoveDest { path: "/Audio", label: @t("stash.audio") }
                        MoveDest { path: "/Dokumente", label: @t("stash.docs") }
                        MoveDest { path: "/Downloads", label: @t("stash.downloads") }
                        MoveDest { path: "/Papierkorb", label: @t("stash.trash") }
                    }
                    .material(overlay)
                    .width(300)
                    .gap(1)
                    .padding(2)
                }
                .grow(1)
                .align(center)
                .justify(center)
            }
            .overlay()
            on Tap -> dispatch(MoveCancel)
        } else {
            Stack { }
        }
        // Selection context menu (the action bar's "Mehr"): the file ops
        // as menu rows, trash-aware like the bar. Centered overlay (the
        // proven hit-testable pattern); backdrop tap closes.
        if $state.menu == "ctx" {
            Stack {
                Stack {
                    Panel {
                        if $state.selection == "" {
                            Text(@t("stash.propsEmpty")).textSize(xs).fg(onGlassMuted)
                        } else {
                            Text($state.selName).textSize(xs).fg(onGlassMuted)
                        }
                        Stack {
                            Icon { symbol: "move", size: 14 }
                                .fg(onGlass)
                            Text(@t("stash.actMove")).textSize(sm).fg(onGlass)
                        }
                        .direction(row)
                        .align(center)
                        .gap(2)
                        .paddingX(2)
                        .height(40)
                        .rounded(md)
                        on Tap -> dispatch(MoveStart)
                        Stack {
                            Icon { symbol: "doc.on.doc", size: 14 }
                                .fg(onGlass)
                            Text(@t("stash.actCopy")).textSize(sm).fg(onGlass)
                        }
                        .direction(row)
                        .align(center)
                        .gap(2)
                        .paddingX(2)
                        .height(40)
                        .rounded(md)
                        on Tap -> dispatch(CopySel)
                        if $state.path == "/Papierkorb" {
                            Stack {
                                Icon { symbol: "arrow.uturn.backward", size: 14 }
                                    .fg(onGlass)
                                Text(@t("stash.actRestore")).textSize(sm).fg(onGlass)
                            }
                            .direction(row)
                            .align(center)
                            .gap(2)
                            .paddingX(2)
                            .height(40)
                            .rounded(md)
                            on Tap -> dispatch(RestoreSel)
                        } else {
                            Stack { }
                        }
                        Stack { }
                            .height(1)
                            .bg(divider)
                        if $state.path == "/Papierkorb" {
                            Stack {
                                Icon { symbol: "trash", size: 14 }
                                    .fg(danger)
                                Text(@t("stash.actDelete")).textSize(sm).fg(danger)
                            }
                            .direction(row)
                            .align(center)
                            .gap(2)
                            .paddingX(2)
                            .height(40)
                            .rounded(md)
                            on Tap -> dispatch(DeleteSel)
                        } else {
                            Stack {
                                Icon { symbol: "trash", size: 14 }
                                    .fg(danger)
                                Text(@t("stash.actDelete")).textSize(sm).fg(danger)
                            }
                            .direction(row)
                            .align(center)
                            .gap(2)
                            .paddingX(2)
                            .height(40)
                            .rounded(md)
                            on Tap -> dispatch(TrashSel)
                        }
                    }
                    .material(overlay)
                    .width(280)
                    .gap(1)
                    .padding(2)
                }
                .grow(1)
                .align(center)
                .justify(center)
            }
            .overlay()
            on Tap -> dispatch(WinMenu(""))
        } else {
            Stack { }
        }
    }
    .grow(1)
}
