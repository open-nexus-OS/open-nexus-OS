//
// WINDOW domain: the window-kit store contract (RFC-0084) — the chrome state
// `WinTopBar` and `WinAppWindow` dispatch into and read back.
//
// THE RULE THAT SHAPES EVERY STORE IN THIS APP: one `Event` type binds to
// exactly ONE `Store`; a `reduce` covers every case of its event and all its
// arms together touch a single store. So a field lives in the store whose
// event writes it, and a change that crosses domains goes through an
// `@effect` that dispatches the other domain's event. Effects have no `if`,
// so a bridge fires for every case of its event — which is why the events a
// reducer must branch on (`WinMenuPick`, `WinTool`) sit in the store that
// owns every field the branches write.
//
// Menus: `menu` is "" (closed) | "app" | "more" | "more.datei" |
// "more.ansicht" | "ctx" (the selection menu). `WinMenu(m)` toggles it, and
// every other store closes it with `dispatch(WinMenu(""))`.

Store WindowStore {
    menu: Str = "",
    leftOpen: Int = 1,
    // The properties pane is hidden by default (design decision); its toggle
    // in the top bar stays.
    rightOpen: Int = 0,
    // Overlay-pane twins (compact/regular tiers, RFC-0084 P7). Default CLOSED —
    // a phone-profile mount must not boot with a pane over the content.
    paneL: Int = 0,
    paneR: Int = 0,
    // Non-zero when a window-control forward was refused.
    applyError: Int = 0,
}

Event WindowEvent {
    WinMenu(Str),
    WinNoop,
    WinPaneClose,
    WinLeft,
    WinRight,
    WinAct(Str),
    Applied(Bool),
    ApplyFailed(Int),
}

reduce WindowEvent {
    WinMenu(m) => {
        if state.menu == m {
            state.menu = "";
        } else {
            state.menu = m;
        }
    },
    // Consume-tap for a panel inside an overlay layer.
    WinNoop => state.menu = state.menu,
    WinPaneClose => {
        state.paneL = 0;
        state.paneR = 0;
    },
    WinLeft => {
        if state.leftOpen == 1 {
            state.leftOpen = 0;
        } else {
            state.leftOpen = 1;
        }
        if state.paneL == 1 {
            state.paneL = 0;
        } else {
            state.paneL = 1;
        }
    },
    WinRight => {
        if state.rightOpen == 1 {
            state.rightOpen = 0;
        } else {
            state.rightOpen = 1;
        }
        if state.paneR == 1 {
            state.paneR = 0;
        } else {
            state.paneR = 1;
        }
    },
    WinAct(a) => state.menu = "",
    Applied(ok) => state.applyError = 0,
    ApplyFailed(code) => state.applyError = code,
}

// Window controls forward to windowd (the presentation authority).
@effect on WinAct(a) {
    match svc.settings.set("window.control", a) {
        Ok(ok) => dispatch(Applied(ok)),
        Err(e) => dispatch(ApplyFailed(e)),
    }
}
