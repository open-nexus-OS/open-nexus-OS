//
// LISTING domain: the entries of the current folder and their honest
// loading / error / empty states (svc.files.list → vfsd ReadDir → nxfs home).
//
// Every other domain asks for a listing through one of two bridge events:
//   Reload  the list is about to change under the user (navigation, sort,
//           filter) — marks it loading, then lists.
//   Relist  the same folder, no loading flash (a toolbar tool, a clear).
// Both run the one listing effect below, which reads the location, sort mode,
// filter and hidden-file switch from their own stores.
//
// `fileCount` is the folder's entry count (svc.files.count) with the SAME
// filter pair, so "N items" can never disagree with the rows. 1 is the
// "unknown, non-empty" sentinel until the count lands; 0 is a genuinely empty
// folder and drives the empty state.

Store ListingStore {
    files: List<FileEntry> = [],
    filesLoading: Int = 1,
    filesError: Int = 0,
    fileCount: Int = 1,
}

Event ListingEvent {
    LoadFiles,
    Reload,
    Relist,
    FilesLoaded(List<FileEntry>),
    FilesFailed(Int),
    CountLoaded(Int),
}

reduce ListingEvent {
    LoadFiles => state.filesError = 0,
    Reload => {
        state.filesLoading = 1;
        state.filesError = 0;
    },
    Relist => state.filesError = state.filesError,
    FilesLoaded(files) => {
        state.files = files;
        state.filesLoading = 0;
        state.filesError = 0;
        // Re-resolved per load (CountLoaded); sentinel until it lands.
        state.fileCount = 1;
    },
    FilesFailed(code) => {
        state.filesLoading = 0;
        state.filesError = code;
    },
    CountLoaded(n) => state.fileCount = n,
}

// Root effect: LoadFiles is dispatched nowhere, so this fires once at mount
// (the DSL initial-load contract) and fills the list from the real home.
@effect on LoadFiles {
    dispatch(Reload);
}

@effect on Reload {
    match svc.files.list(state.path, 0, state.sortBy, state.searchQuery, state.showHidden) {
        Ok(files) => dispatch(FilesLoaded(files)),
        Err(e) => dispatch(FilesFailed(e)),
    }
}

@effect on Relist {
    match svc.files.list(state.path, 0, state.sortBy, state.searchQuery, state.showHidden) {
        Ok(files) => dispatch(FilesLoaded(files)),
        Err(e) => dispatch(FilesFailed(e)),
    }
}

// Every completed listing resolves the folder's entry count. A count failure
// stays at the nonzero sentinel.
@effect on FilesLoaded(files) {
    match svc.files.count(state.path, state.searchQuery, state.showHidden) {
        Ok(n) => dispatch(CountLoaded(n)),
        Err(e) => dispatch(CountLoaded(1)),
    }
}
