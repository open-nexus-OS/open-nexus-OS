//
// The compact size class's bottom row (see `BottomRow`): [123 1.5] [globe 1.15] [space 4.6,
// no label] [return 1.9], no "." key; every key dips like a key (`.press(key)`).

Component BottomRowCompact {
    Stack {
        Stack {
            Text(@t("osk.num")).textStyle(footnote).fontWeight(medium).fg(labelTertiary)
        }
        .align(center)
        .justify(center)
        .basis(0)
        .grow(30)
        .bg(fill)
        .rounded(md)
        .shadow(shadow1)
        .disabled(true)
        .label(@t("osk.symbols"))
        if $state.preedit != "" {
            Stack {
                OskFnIcon { symbol: "globe", size: 18, fg: "label" }
            }
            .direction(row)
            .basis(0)
            .grow(23)
            .label(@t("osk.globe"))
            .press(key)
            on Tap -> dispatch(CommitCycle)
        } else {
            Stack {
                OskFnIcon { symbol: "globe", size: 18, fg: "label" }
            }
            .direction(row)
            .basis(0)
            .grow(23)
            .label(@t("osk.globe"))
            .press(key)
            on Tap -> dispatch(CycleLayout)
        }
        Stack { }
            .basis(0)
            .grow(92)
            .bg(glassCard)
            .rounded(md)
            .shadow(shadow1)
            .label(@t("osk.space"))
        .press(key)
        on Tap -> dispatch(Key(" "))
        Stack {
            if $state.preedit != "" {
                Text(@t("osk.confirm")).textStyle(footnote).fontWeight(medium).fg(onAccent)
            } else {
                Icon { symbol: "return", size: 18 }
                    .fg(onAccent)
            }
        }
        .align(center)
        .justify(center)
        .basis(0)
        .grow(38)
        .bg(accent)
        .rounded(md)
        .shadow(shadow1)
        .label(@t("osk.enter"))
        .press(key)
        on Tap -> dispatch(Action("enter"))
    }
    .direction(row)
    .gap(8)
    .basis(0)
    .grow(1)
}
