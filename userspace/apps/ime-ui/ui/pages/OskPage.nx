//
// The on-screen keyboard surface (RFC-0075 Phase 8b): a chromeless OVERLAY
// window docked by windowd to the bottom display edge. Top line = the
// TOOLBAR while nothing composes (emoji · clipboard · voice · settings ·
// more, TASK-0067B — the clipboard swaps the keys for CARDS of the history,
// a tap inserts one) and the composition STRIP while the IME composes
// (preedit + up to 8 candidates; tap commits). The key
// rows are pure DATA (`svc.ime.rows` from the keymaps SSOT, reloaded on
// `KeymapEvent::Changed`) — 180 languages are 180 data tables, never an
// `if` tree here. The globe key cycles the SYSTEM layout (order = platform
// data); the change round-trips through settingsd and comes back as the
// next KeymapEvent.

Window {
    style: plain,
    level: overlay,
    resizable: false,
}

Page OskPage {
    Stack {
        // TASK-0067B: while nothing composes, the line above the keys is the
        // toolbar (emoji · clipboard · voice · settings · more); while the IME
        // composes it is the candidate strip.
        if $state.preedit == "" && $state.c1 == "" {
            OskToolbar { }
        } else {
            CandidateStrip { }
        }
        if $state.oskPanel == "clipboard" {
            ClipboardCards { }
        } else {
            KeyRows { }
        }
        Stack {
            Stack {
                Button { label: $state.keymap }
            }
            on Tap -> dispatch(CycleLayout)
            Stack {
                Button { label: @t("osk.space") }
                on Tap -> dispatch(Key(" "))
            }
            .paddingX(8)
            Button { label: @t("osk.enter") }
            on Tap -> dispatch(Action("enter"))
            Stack {
                Button { label: "X" }
            }
            .paddingX(4)
            on Tap -> dispatch(Dismiss)
        }
        .direction(row)
        .gap(1)
        .align(center)
    }
    .gap(1)
    .padding(2)
    .align(center)
}
