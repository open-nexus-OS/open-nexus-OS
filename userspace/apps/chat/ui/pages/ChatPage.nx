//
// Chat: the OVERVIEW of open conversations → picking one shows its transcript (sender-aligned
// bubbles, derived from the sequence parity, never parsed from text). The page composes; the
// pieces are `components/chat/`: ChatHeader, ChatOverview, ChatTranscript (the compositor's
// scroll layer, RFC-0109) with ChatBubble, ChatComposer.

// ONE window path (TASK-0337): window-kit's chrome inside this surface, the
// transcript in an OPAQUE content pane (the materials rules — no glass on the
// content layer), the window freeform and resizable like every other app.
Window {
    style: plain,
    mode: freeform,
    resizable: true,
}

Page ChatPage {
    Stack {
        WinTopBar {
            icon: "message",
            tool1: "",
            tool2: "",
            tool3: "",
            tool1Active: false,
            tool2Active: false,
            tool3Active: false,
            navBack: "",
            navFwd: "",
            navRefresh: "",
            sideLeft: "",
            sideRight: "",
            more: "",
            appId: "chat",
        }
        WinAppWindow {
            showSidebar: false,
            showProps: false,
            sidebarOverlay: false,
            propsOverlay: false,
            menuFullscreen: @t("win.fullscreen"),
            menuMoveDevice: @t("win.moveDevice"),
            menuMinimize: @t("win.minimize"),
            menuClose: @t("win.close"),
        } {
            sidebarLeft {
                Stack { }
            }
            contentArea {
                Stack {
                    ChatHeader { }
                    Stack {
                        ChatOverview { }
                        ChatTranscript { }
                    }
                    .grow(1)
                    ChatComposer { }
                }
                .gap(0)
                .material(pane)
                .grow(1)
            }
            sidebarRight {
                Stack { }
            }
        }
    }
    .gap(0)
}
