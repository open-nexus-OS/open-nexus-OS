//
// The composer, while a thread is open: the message field (bound to the draft) and Send, on
// the pane's surface, padding 8, gap 8.

Component ChatComposer {
    if $state.thread == "" {
        Stack { }
    } else {
        Stack {
            TextField { label: @t("chat.message"), value: $state.draft }
            Button { label: @t("chat.send") }
            on Tap -> dispatch(Send)
        }
        .direction(row)
        .align(center)
        .gap(8)
        .padding(8)
        .bg(surfacePane)
    }
}
