//
// The conversations, in their own scroll layer (padding 8). AUTHORED rows: there is no contacts
// or threads service yet (and the DSL has no record literal to loop over), so each conversation
// is one `ConversationRow` with its data inline — name, initials, last line, time, unread count,
// verified / bridged / merged flags, the space, the address and up to two transports with their
// tint role (matrix success · RCS accent · SMS label · a bridge chart2 or modeTablet · XMPP
// warning · IRC chart1). Unread counts sum to the navigation badge.

Component ConversationList {
    Stack {
        ConversationRow { id: "lena", name: @t("chat.c.lena"), ini: "LV", last: @t("chat.c.lenaLast"), time: "14:32", unread: 2, verified: false, bridge: true, merged: true, space: "family", addr: "@lena:nexus.chat", t1: @t("chat.tr.matrix"), t1Tint: "success", t2: @t("chat.tr.sms"), t2Tint: "label" }
        ConversationRow { id: "papa", name: @t("chat.c.papa"), ini: "PA", last: @t("chat.c.papaLast"), time: "11:04", unread: 0, verified: false, bridge: true, merged: false, space: "family", addr: "+49 151 0000 0001", t1: @t("chat.tr.sms"), t1Tint: "label", t2: @t("chat.tr.rcs"), t2Tint: "accent" }
        ConversationRow { id: "team", name: @t("chat.c.team"), ini: "PT", last: @t("chat.c.teamLast"), time: "14:12", unread: 7, verified: false, bridge: false, merged: false, space: "work", addr: "#produkt-team:nexus.chat", t1: @t("chat.tr.matrix"), t1Tint: "success", t2: "", t2Tint: "accent" }
        ConversationRow { id: "jonas", name: @t("chat.c.jonas"), ini: "JR", last: @t("chat.c.jonasLast"), time: "13:47", unread: 0, verified: false, bridge: true, merged: false, space: "work", addr: "@jonas:nexus.chat", t1: @t("chat.tr.bridge"), t1Tint: "modeTablet", t2: @t("chat.tr.matrix"), t2Tint: "success" }
        ConversationRow { id: "aiva", name: @t("chat.c.aiva"), ini: "AS", last: @t("chat.c.aivaLast"), time: "13:20", unread: 1, verified: true, bridge: false, merged: false, space: "business", addr: "@aiva-store:nexus.chat", t1: @t("chat.tr.matrix"), t1Tint: "success", t2: "", t2Tint: "accent" }
        ConversationRow { id: "nord", name: @t("chat.c.nord"), ini: "NS", last: @t("chat.c.nordLast"), time: "12:58", unread: 0, verified: true, bridge: true, merged: false, space: "business", addr: "support@nordbahn.example", t1: @t("chat.tr.rcs"), t1Tint: "accent", t2: "", t2Tint: "accent" }
        ConversationRow { id: "irc", name: @t("chat.c.irc"), ini: "#N", last: @t("chat.c.ircLast"), time: "12:31", unread: 0, verified: false, bridge: true, merged: false, space: "community", addr: "#nexus-os@irc.example", t1: @t("chat.tr.irc"), t1Tint: "chart1", t2: "", t2Tint: "accent" }
        ConversationRow { id: "oma", name: @t("chat.c.oma"), ini: "OG", last: @t("chat.c.omaLast"), time: @t("chat.yesterday"), unread: 0, verified: false, bridge: true, merged: false, space: "family", addr: "+49 151 0000 0002", t1: @t("chat.tr.bridge"), t1Tint: "chart2", t2: "", t2Tint: "accent" }
        ConversationRow { id: "studio", name: @t("chat.c.studio"), ini: "SK", last: @t("chat.c.studioLast"), time: @t("chat.mon"), unread: 0, verified: false, bridge: true, merged: false, space: "community", addr: "studio@kollektiv.example", t1: @t("chat.tr.xmpp"), t1Tint: "warning", t2: "", t2Tint: "accent" }
    }
    .padding(8)
    .grow(1)
    .scroll(vertical)
}
