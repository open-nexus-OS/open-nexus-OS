// The list column: the header (title, search, chips), a hairline and the scrolling conversations.

Component ListColumn {
    Stack {
        ListHeader { }
        Stack { }
            .height(1)
            .bg(separator)
        ConversationList { }
    }
    .gap(0)
    .grow(1)
}
