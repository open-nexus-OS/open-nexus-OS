//
// Settings — the design artifacts' "OS Settings Window"
// (the design artifacts (settings window)), built on `WinAppWindow`
// (RFC-0084). This page owns the window; everything inside it is a component.
//
// FREEFORM, not fullscreen — a VISUAL contract, not a preference.
// `mode: fullscreen` makes app-host paint an OPAQUE page base and makes
// windowd skip the per-window backdrop-blur band, so a fullscreen window can
// never show the wallpaper and its panes would frost an opaque slab. The
// design draws a floating 900×600 glass window over the desktop, which is
// what freeform gives. `style: plain` suppresses windowd's own title bar —
// this page owns its chrome through `WinTopBar`.
Window {
    style: plain,
    mode: freeform,
    resizable: true,
}

Page SettingsPage {
    Stack {
        WinTopBar {
            icon: "gearshape",
            // Suche (design artifacts S1): drawn, disabled until the search mode exists.
            tool1: "magnifyingglass",
            tool2: "",
            tool3: "",
            tool1Active: false,
            tool2Active: false,
            tool3Active: false,
            tool4: "",
            tool4Active: false,
            tool1Disabled: true,
            tool2Disabled: false,
            tool3Disabled: false,
            tool4Disabled: false,
            navBack: "arrow.left",
            navFwd: "arrow.right",
            navRefresh: "",
            navBackDisabled: $state.mode == "overview",
            navFwdDisabled: true,
            sideLeft: "sidebar.left",
            sideRight: "sidebar.right",
            more: "ellipsis.vertical",
            appId: "settings",
        }
        WinAppWindow {
            showSidebar: $state.leftOpen == 1,
            showProps: $state.rightOpen == 1,
            sidebarOverlay: $state.paneL == 1,
            propsOverlay: $state.paneR == 1,
            appMenuOpen: $state.menu == "more" || $state.menu == "more.jump",
            menuFullscreen: @t("win.fullscreen"),
            menuMoveDevice: @t("win.moveDevice"),
            menuMinimize: @t("win.minimize"),
            menuClose: @t("win.close"),
            menuMoveLabel: @t("win.moveLabel"),
            menuArrangeLabel: @t("win.arrangeLabel"),
            menuSoon: @t("win.soon"),
        } {
            sidebarLeft {
                NavSidebar { }
            }
            contentArea {
                WinPane { title: "", showHeader: true, showFooter: false, bare: false, flush: true, scrolls: true, noDividers: false } {
                    header {
                        CrumbTrail { }
                    }
                    body {
                        Stack {
                            if $state.mode == "overview" {
                                OverviewGrid { }
                            } else {
                                SectionView { }
                            }
                        }
                        .paddingX(20)
                        .paddingTop(16)
                        .paddingBottom(24)
                    }
                }
            }
            sidebarRight {
                PropsPane { }
            }
            appMenu {
                MoreMenu { }
            }
        }
        // ── overlay layers ───────────────────────────────────────────────
        // Siblings of the window, on the PAGE ROOT — full-window layers
        // belong to the page that owns the z-order. Each is gated so a
        // closed layer never swallows a tap. An open one COVERS the scroll
        // layers beneath it (RFC-0109): their content paints under it, at
        // their offsets, until it closes. The ⋯ menu is not one of them: it hangs from the
        // kit's `appMenu` place under the chrome's ⋮ (like Stash's), the app-chip menu is the
        // kit's too.
        // TASK-0346 P3: the keyboard-shortcuts window (`ShortcutsWindow`), app-modal.
        if $state.scOpen {
            ShortcutsWindow { }
        } else {
            Stack { }
        }
        PickerLayers { }
    }
    .grow(1)
}
