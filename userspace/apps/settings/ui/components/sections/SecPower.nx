//
// Energie Sparen. Demo data from the handoff's `_tree()` — the battery
// figures are the mockup's, not a reading: nothing in the OS reports a
// charge level yet.

Component SecPower {
    Stack {
        SetGroup { label: "", note: "" } {
            rows {
                SetRow { title: @t("pwr.battery"), subtitle: @t("pwr.batterySub"), icon: "battery.75", showChevron: false } {
                    trailing { SetValue { value: @t("pwr.batteryV") } }
                }
                SetHairline { }
                SetRow { title: @t("pwr.saver"), subtitle: @t("pwr.saverSub"), icon: "battery.75", showChevron: false } {
                    trailing { Toggle { checked: $state.tgBatterySaver, label: @t("pwr.saver") } }
                }
            }
        }
        SetGroup { label: @t("pwr.gSave"), note: "" } {
            rows {
                SetRow { title: @t("pwr.dim"), subtitle: "", icon: "sun.max", showChevron: false } {
                    trailing { Toggle { checked: $state.tgDimScreen, label: @t("pwr.dim") } }
                }
                SetHairline { }
                SetRow { title: @t("pwr.perApp"), subtitle: "", icon: "cpu", showChevron: false } {
                    trailing { SetValue { value: @t("pwr.perAppV") } }
                }
            }
        }
    }
    .gap(3)
}
