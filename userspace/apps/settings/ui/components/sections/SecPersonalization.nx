//
// Personalisierung — the section that owns the appearance page.
//
// "Erscheinungsbild" is the ONE chevron row that is real in Phase 1: it
// pushes `subPage = "appearance"`, and `SectionView` swaps the row list for
// the custom appearance view, exactly as the design's `view: 'appearance'`
// row does. That is also why the sub-page machinery (`subPage`, the back
// chain, the third breadcrumb) is wired now rather than deferred — the
// functional page needed it.
//
// Its subtitle is the live selection ("Dunkel · Nexus Blau · Icons Standard"), so the row reads
// back what the page below it set — `PerLookRow`.

Component SecPersonalization {
    Stack {
        SetGroup { label: @t("per.gLook"), note: "" } {
            rows {
                SetRow { title: @t("per.wallpaper"), subtitle: "", icon: "photo", showChevron: false } {
                    trailing { SetValue { value: @t("per.wallpaperV") } }
                }
                SetHairline { }
                PerLookRow { }
            }
        }
        SetGroup { label: @t("per.gType"), note: "" } {
            rows {
                SetRow { title: @t("per.font"), subtitle: "", icon: "textformat", showChevron: false } {
                    trailing { SetValue { value: @t("per.fontV") } }
                }
            }
        }
        // Fenster (TASK-0066): the tiling keys windowd applies live — the desktop default
        // model's two switches as toggle rows and the margin as a select row (`ToggleRows`,
        // `SelMargin` + `MarginPicker`).
        SetGroup { label: @t("per.gWindows"), note: @t("per.chordsNote") } {
            rows {
                RowTileEdges { }
                SetHairline { }
                Stack {
                    SetRow { title: @t("per.tileMargin"), subtitle: "", icon: "columns.2", showChevron: false } {
                        trailing {
                            Stack {
                                SelMargin { }
                            }
                            .width(210)
                            on Tap -> dispatch(OpenPicker("margin"))
                        }
                    }
                }
                on Tap -> dispatch(OpenPicker("margin"))
                SetHairline { }
                RowTileChords { }
            }
        }
        SetGroup { label: @t("per.gEffects"), note: "" } {
            rows {
                // The one control of `ui.material` (TASK-0353, reduce transparency): windowd and
                // every app-host switch to the solid theme live — grey panels and windows,
                // lighter cards, nothing blurred. The row dispatches; the toggle shows the state.
                if $state.apMaterial == "solid" {
                    Stack {
                        SetRow { title: @t("per.reduceTransparency"), subtitle: "", icon: "", showChevron: false } {
                            trailing { Toggle { checked: true, label: @t("per.reduceTransparency") } }
                        }
                    }
                    on Tap -> dispatch(SetMaterial("glass"))
                } else {
                    Stack {
                        SetRow { title: @t("per.reduceTransparency"), subtitle: "", icon: "", showChevron: false } {
                            trailing { Toggle { checked: false, label: @t("per.reduceTransparency") } }
                        }
                    }
                    on Tap -> dispatch(SetMaterial("solid"))
                }
                SetHairline { plain: true }
                SetRow { title: @t("per.reduceMotion"), subtitle: "", icon: "", showChevron: false } {
                    trailing { Toggle { checked: $state.tgReduceMotion, label: @t("per.reduceMotion") } }
                }
            }
        }
    }
    .gap(24)
}
