// Benachrichtigungen. Demo data from the design's `_tree()`.

Component SecNotifications {
    Stack {
        SetGroup { label: "", note: "" } {
            rows {
                // "An bis 18:00" while on, "Aus" while off — the subtitle reads the switch it sits under.
                if $state.tgDnd {
                    SetRow { title: @t("ntf.dnd"), subtitle: @t("ntf.dndOn"), icon: "bell.slash", showChevron: false } {
                        trailing { Toggle { checked: $state.tgDnd, label: @t("ntf.dnd") } }
                    }
                } else {
                    SetRow { title: @t("ntf.dnd"), subtitle: @t("set.off"), icon: "bell.slash", showChevron: false } {
                        trailing { Toggle { checked: $state.tgDnd, label: @t("ntf.dnd") } }
                    }
                }
                SetHairline { }
                SetRow { title: @t("ntf.schedule"), subtitle: "", icon: "clock", showChevron: false } {
                    trailing { SetValue { value: @t("ntf.scheduleV") } }
                }
            }
        }
        SetGroup { label: @t("ntf.gShow"), note: "" } {
            rows {
                SetRow { title: @t("ntf.lockPreview"), subtitle: "", icon: "", showChevron: false } {
                    trailing { Toggle { checked: $state.tgLockPreview, label: @t("ntf.lockPreview") } }
                }
                SetHairline { plain: true }
                SetRow { title: @t("ntf.badges"), subtitle: "", icon: "", showChevron: false } {
                    trailing { Toggle { checked: $state.tgBadges, label: @t("ntf.badges") } }
                }
            }
        }
        SetGroup { label: @t("ntf.gPerApp"), note: "" } {
            rows {
                SetRow { title: @t("ntf.appNotif"), subtitle: "", icon: "square.grid", showChevron: false } {
                    trailing { SetValue { value: @t("ntf.appNotifV") } }
                }
            }
        }
    }
    .gap(24)
}
