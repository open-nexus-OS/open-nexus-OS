//
// Geräte Info. The handoff's demo device with ONE correction: the OS version
// row shows this repo's real version, not the mockup's "3.2". A version
// string is the one value on this screen a reader would take literally.

Component SecInfo {
    Stack {
        SetGroup { label: @t("inf.gDevice"), note: "" } {
            rows {
                SetRow { title: @t("inf.model"), subtitle: "", icon: "cpu", showChevron: false } {
                    trailing { SetValue { value: @t("inf.modelV") } }
                }
                SetHairline { }
                SetRow { title: @t("inf.os"), subtitle: @t("inf.osSub"), icon: "info.circle", showChevron: false } {
                    trailing { SetValue { value: @t("inf.osV") } }
                }
                SetHairline { }
                SetRow { title: @t("inf.storage"), subtitle: "", icon: "internaldrive", showChevron: false } {
                    trailing { SetValue { value: @t("inf.storageV") } }
                }
            }
        }
        SetGroup { label: @t("inf.gSystem"), note: "" } {
            rows {
                // TASK-0140: the one live row on this screen — pushes the
                // System-update sub-page (appearance pattern: OpenSub swaps
                // the row list for UpdatesView).
                Stack {
                    SetRow { title: @t("inf.update"), subtitle: @t("inf.updateSub"), icon: "arrow.clockwise", showChevron: true } {
                        trailing { }
                    }
                }
                on Tap -> dispatch(OpenSub("updates"))
                SetHairline { }
                SetRow { title: @t("inf.legal"), subtitle: "", icon: "doc.text", showChevron: false } {
                    trailing { SetValue { value: @t("inf.legalV") } }
                }
            }
        }
    }
    .gap(3)
}
