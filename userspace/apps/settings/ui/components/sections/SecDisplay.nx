//
// Monitore. Demo data from the design's `_tree()` — the real display mode
// travels fw_cfg → windowd (RFC-0074) and is not settable from here yet, so
// resolution and refresh rate are value rows, not controls. Helligkeit is the design's stacked
// range row (`SetSliderRow`) with a static demo position (`DemoStore.rngBrightness`); HDR draws
// no leading icon, as in the design, so its hairline starts at 16.

Component SecDisplay {
    Stack {
        SetGroup { label: @t("dis.gBuiltin"), note: "" } {
            rows {
                SetRow { title: @t("dis.resolution"), subtitle: @t("dis.resolutionSub"), icon: "desktopcomputer", showChevron: false } {
                    trailing { SetValue { value: @t("dis.resolutionV") } }
                }
                SetHairline { }
                SetRow { title: @t("dis.refresh"), subtitle: "", icon: "arrow.clockwise", showChevron: false } {
                    trailing { SetValue { value: @t("dis.refreshV") } }
                }
                SetHairline { }
                SetSliderRow { title: @t("dis.brightness"), icon: "sun.max", value: @t("set.percent", $state.rngBrightness), iconStart: "sun.min", iconEnd: "sun.max" } {
                    slider { Slider { value: $state.rngBrightness, variant: "thumb" }.label(@t("dis.brightness")) }
                }
            }
        }
        SetGroup { label: @t("dis.gLook"), note: "" } {
            rows {
                SetRow { title: @t("dis.night"), subtitle: @t("dis.nightSub"), icon: "moon", showChevron: false } {
                    trailing { Toggle { checked: $state.tgNight, label: @t("dis.night") } }
                }
                SetHairline { plain: true }
                SetRow { title: @t("dis.hdr"), subtitle: "", icon: "", showChevron: false } {
                    trailing { Toggle { checked: $state.tgHdr, label: @t("dis.hdr") } }
                }
                SetHairline { }
                SetRow { title: @t("dis.scale"), subtitle: "", icon: "plus.magnifyingglass", showChevron: false } {
                    trailing { SetValue { value: @t("dis.scaleV") } }
                }
            }
        }
    }
    .gap(24)
}
