//
// Akzentfarbe (design §2.9): the nine palette swatches in a `glassCard` panel, radius 16, and the
// accent's NAME at the header's trailing edge (so there is no separate "live" row — the swatch
// ring and the name say what is applied), then the apply-failed note.
//
// The panel is padding 12 16 with 16 between swatches in the design, where the selection ring
// sits 4 px OUTSIDE a 28 px swatch. Every swatch cell is therefore its 36 px ring box (the ring
// transparent while unselected) and the panel pays the ring's 4 px out of its padding and the
// gap: padding 8 12, gap 8 — the swatches keep their 12/16 inset and 16 spacing.

Component ApAccentBlock {
    Stack {
        ApHeader { title: @t("ap.accent") } {
            trailing { ApAccentName { } }
        }
        Stack {
            Stack {
                ApSwatch { hex: "#3b82f6", selected: $state.apAccent == "default" }
            }
            on Tap -> dispatch(SetAccent("default"))
            Stack {
                ApSwatch { hex: "#14b8a6", selected: $state.apAccent == "teal" }
            }
            on Tap -> dispatch(SetAccent("teal"))
            Stack {
                ApSwatch { hex: "#22c55e", selected: $state.apAccent == "green" }
            }
            on Tap -> dispatch(SetAccent("green"))
            Stack {
                ApSwatch { hex: "#f59e0b", selected: $state.apAccent == "amber" }
            }
            on Tap -> dispatch(SetAccent("amber"))
            Stack {
                ApSwatch { hex: "#f97316", selected: $state.apAccent == "orange" }
            }
            on Tap -> dispatch(SetAccent("orange"))
            Stack {
                ApSwatch { hex: "#ef4444", selected: $state.apAccent == "red" }
            }
            on Tap -> dispatch(SetAccent("red"))
            Stack {
                ApSwatch { hex: "#ec4899", selected: $state.apAccent == "pink" }
            }
            on Tap -> dispatch(SetAccent("pink"))
            Stack {
                ApSwatch { hex: "#8b5cf6", selected: $state.apAccent == "violet" }
            }
            on Tap -> dispatch(SetAccent("violet"))
            Stack {
                ApSwatch { hex: "#64748b", selected: $state.apAccent == "graphite" }
            }
            on Tap -> dispatch(SetAccent("graphite"))
        }
        .direction(row)
        .wrap(true)
        .align(center)
        .gap(8)
        .paddingX(12)
        .paddingY(8)
        .rounded(lg)
        .material(card)
        if $state.apError != 0 {
            Text(@t("set.applyFailed")).textStyle(caption).fg(danger)
                .paddingX(16)
        } else {
            Stack { }
        }
    }
    .gap(8)
}
