//
// Modus: light / dark / automatic tiles in a Grid of three columns (gap 12), single selection
// (design §2.9). Automatic is local-only, see AppearanceView. The tiles' preview colours are
// content, passed as hex per mode: the preview gradient, the mock window's fill and its bars.

Component ApModeBlock {
    Stack {
        ApHeader { title: @t("ap.mode") } {
            trailing { }
        }
        Grid(3) {
            Stack {
                ApModeTile { label: @t("ap.light"), top: "#eef3fb", bottom: "#cdd9ee", win: "#ffffffd1", bar: "#0f172a2e", selected: $state.apMode == "light" }
            }
            .grow(1)
            on Tap -> dispatch(SetTheme("light"))
            Stack {
                ApModeTile { label: @t("ap.dark"), top: "#0d1117", bottom: "#1a2744", win: "#ffffff1a", bar: "#ffffff42", selected: $state.apMode == "dark" }
            }
            .grow(1)
            on Tap -> dispatch(SetTheme("dark"))
            Stack {
                ApModeTile { label: @t("ap.auto"), top: "#eef3fb", bottom: "#101a2e", win: "#ffffff6b", bar: "#5a698266", selected: $state.apMode == "auto" }
            }
            .grow(1)
            on Tap -> dispatch(SetModeAuto)
        }
        .gap(12)
        if $state.apMode == "auto" {
            Text(@t("ap.autoNote")).textStyle(footnote).fg(labelSecondary)
                .paddingX(16)
        } else {
            Stack { }
        }
    }
    .gap(8)
}
