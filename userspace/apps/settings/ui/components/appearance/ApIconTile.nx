//
// One "App-Icons & Widgets" tile (design §2.9): three sample icon chips (32 px, radius 8, gap 8)
// in the variant's treatment, its name (footnote 12/600 `label`) and its description (caption
// 11/400 `labelSecondary`), centred. A `glassCard` with its `glassEdge`, radius 16, padding 8;
// the selected tile swaps the edge for a `label` ring (the DSL's `ring` is 2 px, the design's
// 1.5; a border is painted inside the box and takes no layout).
// OPEN: the design draws three REAL app icons per style; no component draws an installed app's
// icon inside a view, so the chips carry three glyphs (gearshape, photo, message) instead.
//
// KNOWN NON-PARITY, recorded in docs/dev/ui/design-token-audit.md: the
// design derives Dunkel/Klar/Getönt from ONE source SVG through
// `mix-blend-mode: screen | luminosity` plus grayscale/contrast filters. The
// painter has no blend modes and no filter stage, so each variant is
// approximated by its base fill plus the glyph ink the variant implies. The
// tiles read correctly as four distinct treatments; they are not the same
// pixels the web mock produces.
//
// PURELY VISUAL — no icon pipeline consumes the choice yet.

Component ApIconTile {
    props: {
        name: Str,
        desc: Str,
        top: Str,
        bottom: Str,
        selected: Bool,
    }
    if $props.selected {
        Stack {
            ApIconChips { top: $props.top, bottom: $props.bottom }
            ApIconNames { name: $props.name, desc: $props.desc }
        }
        .gap(8)
        .align(center)
        .paddingX(8)
        .paddingY(12)
        .rounded(lg)
        .material(card)
        .border(ring)
        .borderColor(label)
    } else {
        Stack {
            ApIconChips { top: $props.top, bottom: $props.bottom }
            ApIconNames { name: $props.name, desc: $props.desc }
        }
        .gap(8)
        .align(center)
        .paddingX(8)
        .paddingY(12)
        .rounded(lg)
        .material(card)
    }
}

Component ApIconChips {
    props: {
        top: Str,
        bottom: Str,
    }
    Stack {
        Stack {
            Icon { symbol: "gearshape", size: 17 }
                .fg(label)
        }
        .width(32)
        .height(32)
        .rounded(sm)
        .align(center)
        .justify(center)
        .bgGradient($props.top, $props.bottom)
        Stack {
            Icon { symbol: "photo", size: 17 }
                .fg(label)
        }
        .width(32)
        .height(32)
        .rounded(sm)
        .align(center)
        .justify(center)
        .bgGradient($props.top, $props.bottom)
        Stack {
            Icon { symbol: "message", size: 17 }
                .fg(label)
        }
        .width(32)
        .height(32)
        .rounded(sm)
        .align(center)
        .justify(center)
        .bgGradient($props.top, $props.bottom)
    }
    .direction(row)
    .gap(8)
    .justify(center)
}

Component ApIconNames {
    props: {
        name: Str,
        desc: Str,
    }
    Stack {
        Text($props.name).textStyle(footnote).fontWeight(semibold).fg(label)
        Text($props.desc).textStyle(caption).fontWeight(normal).fg(labelSecondary).textAlign(center)
    }
    .gap(0)
    .align(center)
}
