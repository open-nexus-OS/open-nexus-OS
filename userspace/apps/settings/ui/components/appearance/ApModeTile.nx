//
// One "Modus" tile: a miniature desktop preview, the mode's name and a radio
// dot (design LAYOUT.md §"Content — appearance page", block 1).
//
// The preview gradient arrives as two hex props and paints through
// `.bgGradient`, which takes EXPRESSIONS rather than tokens. That is the one
// sanctioned place for literal colour in this app: a mode preview is content
// (it shows what light and dark look like), not chrome — chrome must re-theme,
// and a preview that re-themed would show the same picture three times.
//
// The design insets the mock window by percentages and sizes its three bars
// at 52/78/64 % of it. Percentages are not expressible in the DSL's box model,
// so the mock is a padded block with fixed bar widths — the proportions hold
// at the tile widths this grid produces.

Component ApModeTile {
    props: {
        label: Str,
        top: Str,
        bottom: Str,
        selected: Bool,
    }
    Stack {
        Stack {
            Stack {
                Stack { }
                    .height(4)
                    .width(46)
                    .rounded(sm)
                    .bg(labelSecondary)
                Stack { }
                    .height(4)
                    .width(68)
                    .rounded(sm)
                    .bg(labelSecondary)
                Stack { }
                    .height(4)
                    .width(56)
                    .rounded(sm)
                    .bg(labelSecondary)
            }
            .gap(8)
            .padding(12)
            .grow(1)
            .rounded(sm)
            .material(card)
        }
        .height(82)
        .padding(12)
        .rounded(md)
        .bgGradient($props.top, $props.bottom)
        Stack {
            Text($props.label).textStyle(caption).fontWeight(semibold).fg(label)
            Spacer
            if $props.selected {
                Circle { size: 17
                    Icon { symbol: "checkmark", size: 11 }
                        .fg(onAccent)
                }
                .bg(accent)
            } else {
                Circle { size: 17 }
                    .border(hairline)
                    .borderColor(separator)
            }
        }
        .direction(row)
        .align(center)
        .gap(8)
    }
    .gap(8)
    .padding(8)
    .rounded(lg)
    .material(card)
}
