//
// Erscheinungsbild — the design's custom appearance page and the one screen
// in this app that changes the running system.
//
// Modus and Akzentfarbe write through `svc.settings` (settingsd validates and
// persists, windowd applies live). "Automatisch" is drawn because the design
// draws it, but it dispatches `SetModeAuto`, which has NO effect attached:
// windowd's `ThemeMode` is `dark|light`, so there is nothing to write yet.
// App-Icons and Ordnerfarbe are local selections for the same reason.
//
// The design stacks the four blocks with gap 18 under group labels; there is
// no `Grid`, so its `3 × 1fr` and `4 × 1fr` rows are wrapping rows whose
// items grow.

Component AppearanceView {
    Stack {
        ApModeBlock { }
        ApAccentBlock { }
        ApIconsBlock { }
        ApFolderBlock { }
    }
    .gap(24)
}
