//
// One accent swatch (design §2.9): a 28 px circle in the palette colour inside a 36 px ring box.
// Selected: a `label` ring (the DSL's `ring` is 2 px, the design's 1.5) 4 px outside the swatch
// and a white check 13 (stroke 3); unselected: the same box with a transparent ring, so
// selecting never moves a neighbour.
//
// The hex is the value `nexus-theme-tokens::ACCENT_PALETTE` actually applies
// in light mode, NOT the design's swatch hex — the two disagree on red
// (#ef4444 vs #d4183d), and a swatch that shows a colour the system will not
// produce is worse than a swatch that is one shade off the mockup.
//
// `.bgGradient(hex, hex)` with the same colour twice is a flat fill: the DSL
// has no literal-colour `.bg`, because colour tokens must re-theme — and a
// palette swatch is exactly the case that must NOT.

Component ApSwatch {
    props: {
        hex: Str,
        selected: Bool,
    }
    if $props.selected {
        Stack {
            Circle { size: 28
                Icon { symbol: "checkmark", size: 13, stroke: 3 }
                    .fg(onAccent)
            }
            .bgGradient($props.hex, $props.hex)
        }
        .width(36)
        .height(36)
        .align(center)
        .justify(center)
        .rounded(full)
        .border(ring)
        .borderColor(label)
    } else {
        Stack {
            Circle { size: 28 }
                .bgGradient($props.hex, $props.hex)
        }
        .width(36)
        .height(36)
        .align(center)
        .justify(center)
        .rounded(full)
        .border(ring)
        .borderColor(transparent)
    }
}
