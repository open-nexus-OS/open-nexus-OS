//
// One card of the overview grid (design LAYOUT.md §"Content — overview
// grid"): a 30×30 icon chip plus title and description on a `card`.
//
// The card carries NO width of its own: the tap wrapper in `OverviewGrid` is
// the flex item, and modifiers on a component reference are rejected
// (RFC-0084 rule 10), so the sizing that answers the design's
// `repeat(auto-fill, minmax(208px, 1fr))` lives on that wrapper.

Component OverviewCard {
    props: {
        title: Str,
        desc: Str,
        icon: Str,
    }
    Stack {
        Stack {
            Icon { symbol: $props.icon, size: 17 }
                .fg(label)
        }
        .width(32)
        .height(32)
        .rounded(sm)
        .align(center)
        .justify(center)
        .bg(fill)
        Stack {
            Text($props.title).textStyle(subheadline).fontWeight(semibold).fg(label)
            Text($props.desc).textStyle(footnote).fg(labelSecondary)
        }
        .gap(2)
        .grow(1)
    }
    .direction(row)
    .align(start)
    .gap(12)
    .padding(12)
    .grow(1)
    .rounded(lg)
    .material(card)
}
