//
// The 1px `separator` between two rows of a group, from the TEXT column to the right edge
// (design LAYOUT.md): 46 px in with a leading icon (16 + 18 + 12), 16 px without — a group whose
// rows draw no icon passes `plain: true`.
//
// The inset is a padded ROW around the line rather than a margin: `.margin`
// parses and type-checks but has no runtime arm (docs/dev/dsl/modifiers.md).

Component SetHairline {
    props: {
        plain: Bool,
    }
    if $props.plain {
        Stack {
            Stack { }
                .height(1)
                .grow(1)
                .bg(separator)
        }
        .direction(row)
        .paddingLeading(16)
    } else {
        Stack {
            Stack { }
                .width(6)
            Stack { }
                .height(1)
                .grow(1)
                .bg(separator)
        }
        .direction(row)
        .paddingLeading(40)
    }
}
