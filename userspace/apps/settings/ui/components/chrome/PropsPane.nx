//
// The right properties pane. Not part of the settings design — it is the
// window-frame design's third zone, and window-kit's `WinAppWindow` reserves
// it — so it carries the device facts a settings window is asked for most
// often instead of duplicating a section.
//
// Hidden by default (`rightOpen = 0`); the top bar's right toggle reveals it.

Component PropsPane {
    WinPane { title: @t("set.props"), showHeader: true, showFooter: false, bare: device.sizeClass == "compact", flush: false, scrolls: false, noDividers: false } {
        body {
            Stack {
                WinPropRow { label: @t("set.propDevice"), value: @t("set.propDeviceV"), icon: "", last: false }
                WinPropRow { label: @t("set.propOs"), value: @t("set.propOsV"), icon: "", last: false }
                WinPropRow { label: @t("set.propDisplay"), value: @t("set.propDisplayV"), icon: "", last: false }
                WinPropRow { label: @t("set.propStorage"), value: @t("set.propStorageV"), icon: "", last: true }
            }
            .gap(0)
        }
    }
}
