//
// The left navigation pane (design `Sidebar`, `variant="plain"`): a clickable
// header that returns to the overview, the twelve sections in the design's
// order, and an account footer that jumps to the Accounts section.
//
// The item ids ARE the section values. window-kit's `WinSideItem` dispatches
// `WinMenuPick(id)`, and `NavStore` routes anything that is not one of the
// few menu-only ids straight into `section` — so adding a section is one line
// here and one arm in `SectionView`, never a translation table.
//
// The pane paints its own `pane` surface: `WinAppWindow` deliberately
// paints nothing, and a region that can become an overlay pane must bring a
// panel or it floats unframed (RFC-0084 P7).
//
// TWO-LINE items (title + the full description `sec.*.d`, single line: a run wider than its box
// gets an ellipsis by itself) while "Sidebar kompakt" is off, one-line items when it is on
// (`ViewStore.sidebarDesc`, via `SideItem`). The account footer carries the online dot on its
// avatar. The section list scrolls on its own (`.scroll(vertical)`): a
// scroll layer beside the content pane's (RFC-0109 — every `.scroll` of a
// page is a layer the compositor moves), so a short window keeps every
// section reachable while the header and the account footer stay put.

Component NavSidebar {
    WinPane { title: "", showHeader: true, showFooter: true, bare: true, flush: false, scrolls: true, noDividers: false } {
        header {
            Stack {
                Text(@t("set.title")).textStyle(body).fontWeight(semibold).fg(label)
            }
            on Tap -> dispatch(GoOverview)
        }
        body {
            Stack {
                SideItem { id: "connections", label: @t("sec.connections"), sub: @t("sec.connections.d"), icon: "wifi", active: $state.mode == "browse" && $state.section == "connections" }
                SideItem { id: "devices", label: @t("sec.devices"), sub: @t("sec.devices.d"), icon: "computermouse", active: $state.mode == "browse" && $state.section == "devices" }
                SideItem { id: "sound", label: @t("sec.sound"), sub: @t("sec.sound.d"), icon: "speaker.wave", active: $state.mode == "browse" && $state.section == "sound" }
                SideItem { id: "display", label: @t("sec.display"), sub: @t("sec.display.d"), icon: "desktopcomputer", active: $state.mode == "browse" && $state.section == "display" }
                SideItem { id: "notif", label: @t("sec.notif"), sub: @t("sec.notif.d"), icon: "bell", active: $state.mode == "browse" && $state.section == "notif" }
                SideItem { id: "personal", label: @t("sec.personal"), sub: @t("sec.personal.d"), icon: "paintpalette", active: $state.mode == "browse" && $state.section == "personal" }
                SideItem { id: "apps", label: @t("sec.apps"), sub: @t("sec.apps.d"), icon: "square.grid", active: $state.mode == "browse" && $state.section == "apps" }
                SideItem { id: "general", label: @t("sec.general"), sub: @t("sec.general.d"), icon: "globe", active: $state.mode == "browse" && $state.section == "general" }
                SideItem { id: "accounts", label: @t("sec.accounts"), sub: @t("sec.accounts.d"), icon: "person", active: $state.mode == "browse" && $state.section == "accounts" }
                SideItem { id: "privacy", label: @t("sec.privacy"), sub: @t("sec.privacy.d"), icon: "shield", active: $state.mode == "browse" && $state.section == "privacy" }
                SideItem { id: "power", label: @t("sec.power"), sub: @t("sec.power.d"), icon: "battery.75", active: $state.mode == "browse" && $state.section == "power" }
                SideItem { id: "info", label: @t("sec.info"), sub: @t("sec.info.d"), icon: "info.circle", active: $state.mode == "browse" && $state.section == "info" }
            }
            .gap(0)
        }
        footer {
            Stack {
                Avatar { name: @t("set.userName"), size: 34, status: "online" }
                Stack {
                    Text(@t("set.userName")).textStyle(subheadline).fontWeight(medium).fg(label)
                    Text(@t("set.userSub")).textStyle(caption).fontWeight(normal).fg(labelSecondary)
                }
                .gap(0)
                .grow(1)
            }
            .direction(row)
            .align(center)
            .gap(12)
            .padding(2)
            on Tap -> dispatch(Goto("accounts"))
        }
    }
}
