//
// The ⋮ app menu (design §2.10), hung under the chrome's ⋮ by `WinAppWindow`'s `appMenu` place
// (which also drops it in on `slideDown` and closes it on a tap beside it). The app-chip window
// menu is the kit's.
//
//   Ansicht (header)   Beschreibungen anzeigen · Sidebar kompakt · Erweiterte Optionen — each a
//                      check bound to `ViewStore` (`MenuCheck`)
//   Alle Einstellungen durchsuchen   DRAWN DISABLED: there is no search mode yet
//   Übersicht                        the overview grid
//   Zu Bereich springen ◂            the submenu (`JumpMenu`) flies out to the LEFT, level with it
//   Hilfe · Einstellungen zurücksetzen   DRAWN DISABLED: no help pages and no reset exist yet
//
// A control whose function does not exist stays drawn and disabled instead of vanishing (house
// rule); the rows with a function dispatch this app's own events, because `WinMenuItem` would
// bake `WinMenuPick(id)`. The shortcut hints are the design's; no key binding backs them yet.

Component MoreMenu {
    Stack {
        if $state.menu == "more.jump" {
            JumpMenu { }
        } else {
            Stack { }
        }
        WinMenu { width: 240 } {
            items {
                WinMenuRow { label: @t("win.view"), icon: "", kind: "header", shortcut: "", selected: false }
                Stack {
                    MenuCheck { label: @t("win.showSubtitles"), checked: $state.showSubtitles }
                }
                on Tap -> dispatch(ToggleSubtitles)
                Stack {
                    MenuCheck { label: @t("win.compactSidebar"), checked: !$state.sidebarDesc }
                }
                on Tap -> dispatch(ToggleSidebarDesc)
                Stack {
                    MenuCheck { label: @t("win.advanced"), checked: $state.advanced }
                }
                on Tap -> dispatch(ToggleAdvanced)
                WinMenuDivider { }
                WinMenuRow { label: @t("win.search"), icon: "magnifyingglass", kind: "disabled", shortcut: @t("win.keySearch"), selected: false }
                Stack {
                    WinMenuRow { label: @t("win.overview"), icon: "square.grid.2x2", kind: "", shortcut: @t("win.keyOverview"), selected: false }
                }
                on Tap -> dispatch(GoOverview)
                Stack {
                    WinMenuRow { label: @t("win.jumpTo"), icon: "plus", kind: "subLeft", shortcut: "", selected: $state.menu == "more.jump" }
                }
                on Tap -> dispatch(WinMenu("more.jump"))
                WinMenuDivider { }
                WinMenuRow { label: @t("win.help"), icon: "info.circle", kind: "disabled", shortcut: "", selected: false }
                WinMenuRow { label: @t("win.reset"), icon: "trash", kind: "disabled", shortcut: "", selected: false }
            }
        }
    }
    .direction(row)
    .align(start)
    .gap(0)
}
