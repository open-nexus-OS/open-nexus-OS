//
// The app's window-chrome menus: the ⋯ menu and its jump-to-section submenu
// (design §"Structure & interactions"). The app-chip window menu (tiling,
// fullscreen, minimize, close) is the kit's — `WinAppWindow` mounts it.
//
// Every entry uses this app's `MenuRow`, because `WinMenuItem` would bake
// `WinMenuPick(id)` and these entries need to dispatch navigation events or
// open a submenu instead.
//
// The design's view options (`Beschreibungen anzeigen`, `Sidebar kompakt`,
// `Erweiterte Optionen`) are NOT here: they belong to Phase 2 together with
// the sub-pages and the `advanced` groups they reveal, and a menu entry that
// toggles nothing would be a control that lies about what it does.

Component MoreMenu {
    Stack {
        Stack {
            Spacer
            if $state.menu == "more.jump" {
                Stack {
                    Panel {
                        WinMenuRow { label: @t("win.jump"), icon: "", kind: "header", shortcut: "", selected: false }
                        Stack {
                            WinMenuRow { label: @t("sec.connections"), icon: "wifi", kind: "", shortcut: "", selected: false }
                        }
                        on Tap -> dispatch(Goto("connections"))
                        Stack {
                            WinMenuRow { label: @t("sec.devices"), icon: "computermouse", kind: "", shortcut: "", selected: false }
                        }
                        on Tap -> dispatch(Goto("devices"))
                        Stack {
                            WinMenuRow { label: @t("sec.sound"), icon: "speaker.wave", kind: "", shortcut: "", selected: false }
                        }
                        on Tap -> dispatch(Goto("sound"))
                        Stack {
                            WinMenuRow { label: @t("sec.display"), icon: "desktopcomputer", kind: "", shortcut: "", selected: false }
                        }
                        on Tap -> dispatch(Goto("display"))
                        Stack {
                            WinMenuRow { label: @t("sec.notif"), icon: "bell", kind: "", shortcut: "", selected: false }
                        }
                        on Tap -> dispatch(Goto("notif"))
                        Stack {
                            WinMenuRow { label: @t("sec.personal"), icon: "paintpalette", kind: "", shortcut: "", selected: false }
                        }
                        on Tap -> dispatch(Goto("personal"))
                        Stack {
                            WinMenuRow { label: @t("sec.apps"), icon: "square.grid", kind: "", shortcut: "", selected: false }
                        }
                        on Tap -> dispatch(Goto("apps"))
                        Stack {
                            WinMenuRow { label: @t("sec.general"), icon: "globe", kind: "", shortcut: "", selected: false }
                        }
                        on Tap -> dispatch(Goto("general"))
                        Stack {
                            WinMenuRow { label: @t("sec.accounts"), icon: "person", kind: "", shortcut: "", selected: false }
                        }
                        on Tap -> dispatch(Goto("accounts"))
                        Stack {
                            WinMenuRow { label: @t("sec.privacy"), icon: "shield", kind: "", shortcut: "", selected: false }
                        }
                        on Tap -> dispatch(Goto("privacy"))
                        Stack {
                            WinMenuRow { label: @t("sec.power"), icon: "battery.75", kind: "", shortcut: "", selected: false }
                        }
                        on Tap -> dispatch(Goto("power"))
                        Stack {
                            WinMenuRow { label: @t("sec.info"), icon: "info.circle", kind: "", shortcut: "", selected: false }
                        }
                        on Tap -> dispatch(Goto("info"))
                    }
                    .material(overlay)
                    .rounded(lg)
                    .width(250)
                    .gap(0)
                    .padding(4)
                }
                on Tap -> dispatch(WinNoop)
            } else {
                Stack { }
            }
            if $state.menu == "more" {
                Stack {
                    Panel {
                        Stack {
                            WinMenuRow { label: @t("win.overview"), icon: "square.grid.2x2", kind: "", shortcut: "", selected: false }
                        }
                        on Tap -> dispatch(GoOverview)
                        Stack {
                            WinMenuRow { label: @t("win.jump"), icon: "list.bullet", kind: "sub", shortcut: "", selected: false }
                        }
                        on Tap -> dispatch(WinMenu("more.jump"))
                        Stack { }
                            .height(1)
                            .bg(separator)
                        Stack {
                            WinMenuRow { label: @t("win.help"), icon: "info.circle", kind: "", shortcut: "", selected: false }
                        }
                        on Tap -> dispatch(WinMenu(""))
                    }
                    .material(overlay)
                    .rounded(lg)
                    .width(230)
                    .gap(0)
                    .padding(4)
                }
                on Tap -> dispatch(WinNoop)
            } else {
                Stack { }
            }
        }
        .direction(row)
        .align(start)
        .paddingX(8)
        .grow(1)
    }
    .overlay()
    on Tap -> dispatch(WinMenu(""))
}
