// A shortcut's chords as the registry names them: the primary one as a key
// pill, the alternates (` · ` between them) small beneath it.

Component ScKeys {
    props: {
        keys: Str,
        alt: Str,
    }
    Stack {
        Stack {
            Text($props.keys).textStyle(footnote).fontWeight(medium).fg(label)
        }
        .paddingX(8)
        .paddingY(4)
        .rounded(sm)
        .bg(fill)
        if $props.alt != "" {
            Text($props.alt).textStyle(caption).fg(labelSecondary)
        } else {
            Stack { }
        }
    }
    .gap(4)
    .align(end)
}
