//
// A shortcut's name by its registry id — `@t` takes literal keys only, so one
// arm per entry of the registry (userspace/shortcuts/src/table.rs). The
// registry's `tests/registry.rs` keeps the arms, the ids and the five
// language files (`sc.<id>`) in step; an id without an arm shows itself.

Component ScName {
    props: {
        id: Str,
    }
    if $props.id == "window.leftHalf" {
        Text(@t("sc.window.leftHalf")).textSize(sm).fontWeight(medium).fg(onGlass)
    } else if $props.id == "window.rightHalf" {
        Text(@t("sc.window.rightHalf")).textSize(sm).fontWeight(medium).fg(onGlass)
    } else if $props.id == "window.topLeft" {
        Text(@t("sc.window.topLeft")).textSize(sm).fontWeight(medium).fg(onGlass)
    } else if $props.id == "window.topRight" {
        Text(@t("sc.window.topRight")).textSize(sm).fontWeight(medium).fg(onGlass)
    } else if $props.id == "window.bottomLeft" {
        Text(@t("sc.window.bottomLeft")).textSize(sm).fontWeight(medium).fg(onGlass)
    } else if $props.id == "window.bottomRight" {
        Text(@t("sc.window.bottomRight")).textSize(sm).fontWeight(medium).fg(onGlass)
    } else if $props.id == "window.fill" {
        Text(@t("sc.window.fill")).textSize(sm).fontWeight(medium).fg(onGlass)
    } else if $props.id == "window.return" {
        Text(@t("sc.window.return")).textSize(sm).fontWeight(medium).fg(onGlass)
    } else if $props.id == "window.minimize" {
        Text(@t("sc.window.minimize")).textSize(sm).fontWeight(medium).fg(onGlass)
    } else if $props.id == "window.close" {
        Text(@t("sc.window.close")).textSize(sm).fontWeight(medium).fg(onGlass)
    } else if $props.id == "capture.ui" {
        Text(@t("sc.capture.ui")).textSize(sm).fontWeight(medium).fg(onGlass)
    } else if $props.id == "capture.screen" {
        Text(@t("sc.capture.screen")).textSize(sm).fontWeight(medium).fg(onGlass)
    } else if $props.id == "capture.window" {
        Text(@t("sc.capture.window")).textSize(sm).fontWeight(medium).fg(onGlass)
    } else if $props.id == "text.left" {
        Text(@t("sc.text.left")).textSize(sm).fontWeight(medium).fg(onGlass)
    } else if $props.id == "text.right" {
        Text(@t("sc.text.right")).textSize(sm).fontWeight(medium).fg(onGlass)
    } else if $props.id == "text.wordLeft" {
        Text(@t("sc.text.wordLeft")).textSize(sm).fontWeight(medium).fg(onGlass)
    } else if $props.id == "text.wordRight" {
        Text(@t("sc.text.wordRight")).textSize(sm).fontWeight(medium).fg(onGlass)
    } else if $props.id == "text.home" {
        Text(@t("sc.text.home")).textSize(sm).fontWeight(medium).fg(onGlass)
    } else if $props.id == "text.end" {
        Text(@t("sc.text.end")).textSize(sm).fontWeight(medium).fg(onGlass)
    } else if $props.id == "text.selectLeft" {
        Text(@t("sc.text.selectLeft")).textSize(sm).fontWeight(medium).fg(onGlass)
    } else if $props.id == "text.selectRight" {
        Text(@t("sc.text.selectRight")).textSize(sm).fontWeight(medium).fg(onGlass)
    } else if $props.id == "text.selectWordLeft" {
        Text(@t("sc.text.selectWordLeft")).textSize(sm).fontWeight(medium).fg(onGlass)
    } else if $props.id == "text.selectWordRight" {
        Text(@t("sc.text.selectWordRight")).textSize(sm).fontWeight(medium).fg(onGlass)
    } else if $props.id == "text.selectHome" {
        Text(@t("sc.text.selectHome")).textSize(sm).fontWeight(medium).fg(onGlass)
    } else if $props.id == "text.selectEnd" {
        Text(@t("sc.text.selectEnd")).textSize(sm).fontWeight(medium).fg(onGlass)
    } else if $props.id == "text.selectAll" {
        Text(@t("sc.text.selectAll")).textSize(sm).fontWeight(medium).fg(onGlass)
    } else if $props.id == "text.delete" {
        Text(@t("sc.text.delete")).textSize(sm).fontWeight(medium).fg(onGlass)
    } else if $props.id == "text.deleteWordBack" {
        Text(@t("sc.text.deleteWordBack")).textSize(sm).fontWeight(medium).fg(onGlass)
    } else if $props.id == "text.deleteWordForward" {
        Text(@t("sc.text.deleteWordForward")).textSize(sm).fontWeight(medium).fg(onGlass)
    } else if $props.id == "text.copy" {
        Text(@t("sc.text.copy")).textSize(sm).fontWeight(medium).fg(onGlass)
    } else if $props.id == "text.cut" {
        Text(@t("sc.text.cut")).textSize(sm).fontWeight(medium).fg(onGlass)
    } else if $props.id == "text.paste" {
        Text(@t("sc.text.paste")).textSize(sm).fontWeight(medium).fg(onGlass)
    } else if $props.id == "text.undo" {
        Text(@t("sc.text.undo")).textSize(sm).fontWeight(medium).fg(onGlass)
    } else if $props.id == "text.redo" {
        Text(@t("sc.text.redo")).textSize(sm).fontWeight(medium).fg(onGlass)
    } else if $props.id == "input.nextSource" {
        Text(@t("sc.input.nextSource")).textSize(sm).fontWeight(medium).fg(onGlass)
    } else {
        Text($props.id).textSize(sm).fontWeight(medium).fg(onGlass)
    }
}
