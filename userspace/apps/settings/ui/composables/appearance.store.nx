//
// APPEARANCE domain — the one page of this app that really changes the
// system. `ui.theme.mode` and `ui.theme.accent` route through `svc.settings`
// to settingsd (validate + persist) and on to windowd, which applies them
// live: exactly the path the Control Center uses.
//
// HONEST SCOPE, stated where it is decided:
//
//   * Modus  — the handoff draws three tiles. windowd's `ThemeMode` is
//     `dark|light` (`windowd/src/theme.rs`), so only those two write.
//     "Automatisch" is a SEPARATE case with NO effect: it moves the local
//     selection so the tile can show as picked, and writes nothing. It is not
//     a broken setting, it is a setting that does not exist yet — recorded in
//     `docs/dev/ui/design-token-audit.md`.
//   * Akzent — all nine handoff swatches write for real. "Nexus Blau" IS the
//     theme's built-in accent, so it travels as `"default"` (palette index 0);
//     the other eight are `nexus-theme-tokens::ACCENT_PALETTE` names.
//   * App-Icon-Stil and Ordnerfarbe are LOCAL selections only — nothing below
//     the UI consumes them yet, so they never leave this store.

Store AppearanceStore {
    // "light" | "dark" | "auto" — "auto" is local-only (see above).
    apMode: Str = "dark",
    // "default" + the eight ACCENT_PALETTE names.
    apAccent: Str = "default",
    // "default" | "dark" | "clear" | "tinted" — local only.
    apIconStyle: Str = "default",
    // "teal" | "accent" | "violet" | "amber" | "rose" | "graphite" — local only.
    apFolder: Str = "teal",
    // "glass" | "solid" — `ui.material` (TASK-0337, reduce transparency): windowd and every
    // app-host apply it live; read back at mount by the root effect below.
    apMaterial: Str = "glass",
    // Non-zero when settingsd refused or the call timed out.
    apError: Int = 0,
}

Event AppearanceEvent {
    SetTheme(Str),
    SetModeAuto,
    SetAccent(Str),
    SetIconStyle(Str),
    SetFolder(Str),
    ApLoad,
    ApMaterialLoaded(Str),
    SetMaterial(Str),
    ApApplied(Bool),
    ApFailed(Int),
}

reduce AppearanceEvent {
    SetTheme(mode) => {
        state.apMode = mode;
        state.apError = 0;
    },
    SetModeAuto => {
        state.apMode = "auto";
        state.apError = 0;
    },
    SetAccent(name) => {
        state.apAccent = name;
        state.apError = 0;
    },
    SetIconStyle(style) => {
        state.apIconStyle = style;
        state.apError = 0;
    },
    SetFolder(color) => {
        state.apFolder = color;
        state.apError = 0;
    },
    ApLoad => state.apError = 0,
    ApMaterialLoaded(v) => state.apMaterial = v,
    SetMaterial(v) => {
        state.apMaterial = v;
        state.apError = 0;
    },
    ApApplied(ok) => state.apError = 0,
    ApFailed(code) => state.apError = code,
}

// Root effect (nothing dispatches `ApLoad`): the material as settingsd holds it, at mount.
@effect on ApLoad {
    match svc.settings.get("ui.material") {
        Ok(v) => dispatch(ApMaterialLoaded(v)),
        Err(e) => dispatch(ApFailed(e)),
    }
}

@effect on SetMaterial(v) {
    match svc.settings.set("ui.material", v) {
        Ok(ok) => dispatch(ApApplied(ok)),
        Err(e) => dispatch(ApFailed(e)),
    }
}

@effect on SetTheme(mode) {
    match svc.settings.set("ui.theme.mode", mode) {
        Ok(ok) => dispatch(ApApplied(ok)),
        Err(e) => dispatch(ApFailed(e)),
    }
}

@effect on SetAccent(name) {
    match svc.settings.set("ui.theme.accent", name) {
        Ok(ok) => dispatch(ApApplied(ok)),
        Err(e) => dispatch(ApFailed(e)),
    }
}
