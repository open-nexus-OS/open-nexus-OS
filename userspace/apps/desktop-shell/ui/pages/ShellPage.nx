//
// The shell home (design_handoff_launcher, TOUCH base — the boot default;
// `ui/platform/desktop/pages/ShellPage.nx` overrides with the desktop
// taskbar). Two independent axes (the handoff's one driving concept):
// desktop MODE is the explicit Control-Center toggle (→ the platform
// override), WIDTH picks between the touch layouts via `device.sizeClass`
// (mobile-first): compact = phone (<640), regular = tablet portrait
// (<1024), wide = landscape (≥1024).
//
// Thin composition only — the pieces live in `ui/components/`:
// topbar/TopBar (36px bar + pills + island), workspace/WorkspaceGrid (the
// 6-column §3.2 icon field), panels/PanelHost (the six drop-downs),
// launcher/LauncherHost (fullscreen launcher overlay), overlays/TilePreview
// (the tiling drop hint windowd pushes, TASK-0066), and the dock family per
// width class (dock/DockWide · DockRegular · DockCompact — §8).

// The shell is the desktop: chromeless, full-screen, desktop z-band, on a
// transparent base over the wallpaper plane (no page-wide `.bg()`).
Window {
    style: plain,
    level: desktop,
    resizable: false,
}

Page ShellPage {
    Stack {
        if $state.capOpen {
            // The screenshot UI is up (TASK-0068): the frozen frame already shows the shell
            // as it was — nothing live is drawn above it but the capture layer.
            Stack { }
                .grow(1)
        } else {
            Stack {
                TopBar { }
                Stack {
                    WorkspaceGrid { }
                    TilePreview { }
                    PanelHost { }
                    LauncherHost { }
                }
                .grow(1)
                .padding(7)
                if device.sizeClass == "wide" {
                    DockWide { }
                } else {
                    if device.sizeClass == "regular" {
                        DockRegular { }
                    } else {
                        DockCompact { }
                    }
                }
            }
            .grow(1)
            .gap(0)
        }
        ShellOverlays { }
    }
    .gap(0)
    on WindowsChanged -> dispatch(WindowsMoved)
    on CaptureOpen -> dispatch(CapOpen)
    on CaptureScreen -> dispatch(CapShotScreen)
    on CaptureWindow -> dispatch(CapShotWindow)
}
