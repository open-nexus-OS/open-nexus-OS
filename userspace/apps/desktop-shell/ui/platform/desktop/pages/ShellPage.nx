//
// Desktop override (design_handoff_launcher desktop MODE — the explicit
// Control-Center toggle, not width): thin composition only — top bar with
// the four separate status pills, the top-left icon COLUMN, the drop-down
// panel layer, the launcher overlay (windowed 720×520 default, fullscreen
// expand), and the 56px taskbar. Same store/events — ONE `.nxir`; the
// compositor's profile push selects this override.

Page ShellPage {
    Stack {
        if $state.capOpen {
            // The screenshot UI is up (TASK-0068): the frozen frame already shows the shell
            // as it was — nothing live is drawn above it but the capture layer.
            Stack { }
                .grow(1)
        } else {
            Stack {
                TopBar { }
                Stack {
                    WorkspaceColumn { }
                    TilePreview { }
                    PanelHost { }
                    LauncherHost { }
                }
                .grow(1)
                Taskbar { }
            }
            .grow(1)
            .gap(0)
        }
        ShellOverlays { }
    }
    .gap(0)
    on WindowsChanged -> dispatch(WindowsMoved)
    on CaptureOpen -> dispatch(CapOpen)
    on CaptureScreen -> dispatch(CapShotScreen)
    on CaptureWindow -> dispatch(CapShotWindow)
}
