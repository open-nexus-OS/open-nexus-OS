//
// One md app tile on a glass or opaque surface (design artifacts: `AppIcon` md): the 56 px icon,
// 8 px, the label — subheadline semibold, one line, 72 px at most, cut with an ellipsis; no
// halo (the surface behind it is not the bare wallpaper) and no running slot. The compact
// launcher's grid and the search results use it; the desktop icon field uses `FieldTile`.
// Tap handlers attach at the use site.

Component AppTile {
    props: {
        label: Str,
        icon: Str,
        iconTop: Str,
        iconBottom: Str,
        iconArt: Str,
    }
    Stack {
        AppIconMd { icon: $props.icon, iconTop: $props.iconTop, iconBottom: $props.iconBottom, iconArt: $props.iconArt }
        Stack {
            Text($props.label).textStyle(subheadline).fontWeight(semibold).fg(label)
        }
        .maxWidth(72)
    }
    .align(center)
    .gap(8)
}
