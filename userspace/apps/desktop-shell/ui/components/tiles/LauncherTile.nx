//
// One full-screen launcher tile (design artifacts: `AppIcon` xl): the 88 px icon, 12 px, the
// label — headline (15/20/600) with the halo (the tint sits over the wallpaper), one line,
// 104 px at most, cut with an ellipsis. No running marker — the launcher is a start board,
// running state lives on the dock and the taskbar. Tap handlers attach at the use site.

Component LauncherTile {
    props: {
        label: Str,
        icon: Str,
        iconTop: Str,
        iconBottom: Str,
        iconArt: Str,
    }
    Stack {
        AppIconXl { icon: $props.icon, iconTop: $props.iconTop, iconBottom: $props.iconBottom, iconArt: $props.iconArt }
        Stack {
            Text($props.label).textStyle(headline).fg(label).shadow(halo)
        }
        .maxWidth(104)
    }
    .align(center)
    .gap(12)
}
