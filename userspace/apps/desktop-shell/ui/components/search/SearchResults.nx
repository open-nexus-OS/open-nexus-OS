//
// The search's result panel (TASK-0067B; design artifacts: launcher-lock §M),
// one overlay surface under the field (radius 24, padding 12; overline section
// titles in `labelSecondary`, clip cards radius 12 — concentric). Clipboard mode shows the history from clipboardd as CARDS, newest
// first (a press = copy-back: the item becomes the newest again); every other
// state shows the apps the registry matched as tiles (a press launches the
// app and closes the search). Both lists were filtered AT the service.

Component SearchResults {
    Panel {
        if $state.searchMode == "clipboard" {
            Stack {
                Text(@t("search.clipboard")).textStyle(overline).fg(labelSecondary)
                Spacer
                if $state.clipCopied {
                    Stack {
                        Icon { symbol: "checkmark", size: 12 }
                            .fg(accent)
                        Text(@t("search.copied")).textStyle(caption).fg(labelSecondary)
                    }
                    .direction(row)
                    .align(center)
                    .gap(4)
                } else {
                    Stack { }
                }
            }
            .direction(row)
            .align(center)
            if $state.clipsDenied {
                Text(@t("search.clipDenied")).textStyle(footnote).fg(labelSecondary)
            } else {
                if len($state.clips) == 0 {
                    if $state.searchQuery != "" {
                        Text(@t("search.clipNoMatch")).textStyle(footnote).fg(labelSecondary)
                    } else {
                        Text(@t("search.clipEmpty")).textStyle(footnote).fg(labelSecondary)
                    }
                } else {
                    List($state.clips) { clip in
                        Stack {
                            Text(clip.text).textStyle(footnote).fg(label)
                        }
                        .key(clip.seq)
                        .grow(1)
                        .height(72)
                        .padding(8)
                        .overflow(hidden)
                        .material(card)
                        .rounded(md)
                        .label(@t("search.copyBack"))
                        on Tap -> dispatch(ClipRestore(clip.seq))
                    }
                    .columns(3)
                    .rowGap(8)
                    .gap(8)
                }
            }
        } else {
            Text(@t("search.apps")).textStyle(overline).fg(labelSecondary)
            if len($state.searchApps) == 0 {
                Text(@t("search.noApps")).textStyle(footnote).fg(labelSecondary)
            } else {
                List($state.searchApps) { app in
                    Stack {
                        AppTile { label: app.label, icon: app.icon, iconTop: app.iconTop, iconBottom: app.iconBottom, iconArt: app.iconArt }
                    }
                    .key(app.id)
                    .align(center)
                    on Tap -> dispatch(SearchLaunch(app.id))
                }
                .columns(6)
                .rowGap(12)
                .gap(8)
            }
        }
    }
    .material(overlay)
    .rounded(xl)
    .gap(8)
    .padding(12)
}
