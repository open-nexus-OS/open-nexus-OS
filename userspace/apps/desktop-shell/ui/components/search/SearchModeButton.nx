//
// One round category button beside the search field (TASK-0067B; design
// artifacts: launcher-lock §M): the overlay surface like the field, the 17 px
// glyph centred; the chosen category keeps a persistent `fill` layer and an
// `accent` glyph (the design's selected glass button). `inert` draws the button
// dimmed (a category that does not exist yet must not look like one that
// does). The press handler is the use site's.

Component SearchModeButton {
    props: {
        icon: Str,
        label: Str,
        selected: Bool,
        inert: Bool,
    }
    if $props.inert {
        Circle { size: 44
            Icon { symbol: $props.icon, size: 17 }
                .fg(labelSecondary)
        }
        .material(overlay)
        .opacity(140)
        .label($props.label)
    } else {
        if $props.selected {
            Circle { size: 44
                Circle { size: 44
                    Icon { symbol: $props.icon, size: 17 }
                        .fg(accent)
                }
                .bg(fill)
            }
            .material(overlay)
            .label($props.label)
        } else {
            Circle { size: 44
                Icon { symbol: $props.icon, size: 17 }
                    .fg(label)
            }
            .material(overlay)
            .label($props.label)
        }
    }
}
