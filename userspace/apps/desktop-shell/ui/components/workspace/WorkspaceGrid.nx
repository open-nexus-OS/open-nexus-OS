//
// The TOUCH workspace icon field (design artifacts: launcher, icon field): a centred
// SIX-column grid — `repeat(6,1fr)`, rows 24 / columns 16 apart, top-aligned — of md (56)
// icons, `FieldTile`: running slot, halo label; each cell fills its track so the icon sits
// centred in it. The touch padding comes from the HOST page's icon-field wrapper, which also
// keeps PanelHost out of it — the overlay fills the parent's CONTENT box, so the padding must
// live there, not here. Registry-driven: every tile dispatches `Activate(app.id)` from the
// AppRecord, never a hardcoded list.

Component WorkspaceGrid {
    Stack {
        if $state.loading {
            Text(@t("common.loading")).fg(labelSecondary).shadow(halo)
        } else {
            List($state.apps) { app in
                Stack {
                    FieldTile { label: app.label, icon: app.icon, iconTop: app.iconTop, iconBottom: app.iconBottom, iconArt: app.iconArt, running: app.running }
                }
                .key(app.id)
                .align(center)
                .grow(1)
                on Tap -> dispatch(Activate(app.id))
            }
            .columns(6)
            .rowGap(24)
            .gap(16)
        }
    }
    .grow(1)
    .overflow(hidden)
}
