//
// The TOUCH workspace icon field (design_handoff_launcher §3.2): a centred
// SIX-column grid — `repeat(6,1fr)`, rows 24 / columns 16 apart (the 1fr
// tracks breathe on top), top-aligned — md (56) icons with label. The §3.2
// padding 28 comes from the HOST page's middle stack (`.padding(7)`), which
// also anchors PanelHost — the overlay fills the parent's CONTENT box, so
// the padding must live there, not here. Registry-driven: every tile
// dispatches `Launch(app.id)` from the AppRecord, never a hardcoded list.

Component WorkspaceGrid {
    Stack {
        if $state.loading {
            Text(@t("common.loading")).fg(onSurfaceVariant)
        } else {
            List($state.apps) { app in
                Stack {
                    AppTile { label: app.label, icon: app.icon, iconTop: app.iconTop, iconBottom: app.iconBottom, iconArt: app.iconArt, running: app.running }
                }
                .key(app.id)
                .align(center)
                on Tap -> dispatch(Activate(app.id))
            }
            .columns(6)
            .rowGap(6)
            .gap(4)
        }
    }
    .grow(1)
}
