//
// The DESKTOP workspace icon field (design artifacts: launcher, icon field): a
// top-left column of md (56) icons — `FieldTile`: running slot, halo label —
// the classic desktop icon field, NO scrolling (the field wraps, it never
// scrolls). Column-WRAP into further columns is a recorded delta until the
// engine grows column wrapping; with the current registry (≤ ~8 launchable
// apps) one column holds everything. Row gap 24, padding 20.

Component WorkspaceColumn {
    Stack {
        if $state.loading {
            Text(@t("common.loading")).fg(labelSecondary).shadow(halo)
        } else {
            List($state.apps) { app in
                Stack {
                    FieldTile { label: app.label, icon: app.icon, iconTop: app.iconTop, iconBottom: app.iconBottom, iconArt: app.iconArt, running: app.running }
                }
                .key(app.id)
                on Tap -> dispatch(Activate(app.id))
            }
            .gap(24)
            .align(start)
        }
    }
    .grow(1)
    .padding(20)
    .overflow(hidden)
}
