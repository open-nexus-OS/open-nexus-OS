//
// The 36px top bar (design_handoff_panels §2) — three zones: left · Dynamic
// Island centred · right. The ONLY openers of the six drop-down panels.
//
// This exists as ONE component because the bar used to be written twice, once
// per `ShellPage`, and two copies of a trigger matrix drift. Which pills exist
// hangs on two INDEPENDENT axes, exactly as the handoff states them:
//
//   device.profile == desktop   the explicit Ansichtsmodus flag (Control
//                               Center writes `ui.shell.mode`)
//   device.sizeClass            only consulted when NOT desktop — compact
//                               (<640) is phone, everything else is tablet
//
//   desktop  left: Zeit·Datum → Kalender · Mitteilungs-Pill → Mitteilungen
//            right: WLAN · Ton · Batterie · Control Center (four panels)
//   tablet   left: Zeit → Kalender · Glocke → Mitteilungen
//            right: ONE status pill → Control Center
//   phone    left: Zeit+Glocke in one pill → Mitteilungen
//            right: as tablet
//
// In touch modes there are no WLAN/Ton/Batterie panels at all — their contents
// live in the Control Center — so the bar must not offer triggers for them.
//
// Every pill is 28px in a 36px bar and carries `.hitSlop(2)`: the BAR is the
// touch target, not the pill. The handlers sit here, on the wrapping `Stack`,
// because a pill is a shape and which panel it opens is this bar's decision.

Component TopBar {
    Stack {
        if device.profile == desktop {
            Stack {
                Stack {
                    ClockPill { wide: true }
                }
                .hitSlop(2)
                on Tap -> dispatch(SetPanel("calendar"))
                Stack {
                    NotifPill { wide: true }
                }
                .hitSlop(2)
                on Tap -> dispatch(SetPanel("notifications"))
            }
            .direction(row)
            .align(center)
            .gap(1)
        } else if device.sizeClass == "compact" {
            Stack {
                Stack {
                    PhoneClockBellPill { }
                }
                .hitSlop(2)
                on Tap -> dispatch(SetPanel("notifications"))
            }
            .direction(row)
            .align(center)
            .gap(1)
        } else {
            Stack {
                Stack {
                    ClockPill { wide: false }
                }
                .hitSlop(2)
                on Tap -> dispatch(SetPanel("calendar"))
                Stack {
                    NotifPill { wide: false }
                }
                .hitSlop(2)
                on Tap -> dispatch(SetPanel("notifications"))
            }
            .direction(row)
            .align(center)
            .gap(1)
        }
        Spacer
        Island { }
        Spacer
        if device.profile == desktop {
            Stack {
                Stack {
                    GlyphPill { icon: "wifi" }
                }
                .hitSlop(2)
                on Tap -> dispatch(SetPanel("wifi"))
                Stack {
                    GlyphPill { icon: "speaker.wave" }
                }
                .hitSlop(2)
                on Tap -> dispatch(SetPanel("sound"))
                Stack {
                    BatteryPill { }
                }
                .hitSlop(2)
                on Tap -> dispatch(SetPanel("battery"))
                Stack {
                    GlyphPill { icon: "slider.horizontal.3" }
                }
                .hitSlop(2)
                on Tap -> dispatch(SetPanel("control"))
            }
            .direction(row)
            .align(center)
            .gap(1)
        } else {
            Stack {
                StatusPill { }
            }
            .hitSlop(2)
            on Tap -> dispatch(SetPanel("control"))
        }
    }
    .direction(row)
    .height(36)
    .align(center)
    .paddingX(3)
}
