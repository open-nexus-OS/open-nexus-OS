//
// Phone mode merges time and bell into ONE pill (design artifacts: TopBar,
// phone) that opens Mitteilungen — under 640px there is no room for two
// triggers on the left, and the calendar is reachable from the Control Center
// instead.
//
// The clock therefore stops being a calendar opener in this mode. That is the
// design's call, and it is why this is its own component rather than
// `ClockPill` with a flag: it opens a different panel.

Component PhoneClockBellPill {
    props: {
        selected: Bool,
    }
    TopBarPill { selected: $props.selected, gap: 8 } {
        content {
            Text($state.clock).textStyle(footnote).fontWeight(semibold).figures(tabular).fg(label).shadow(halo)
            BellGlyph { unread: !$state.notifCleared }
        }
    }
}
