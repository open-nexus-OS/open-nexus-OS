//
// A single-glyph top-bar pill (design artifacts: TopBar) — the desktop mode's
// Control Center opener and the search (the search is the repo's, TASK-0067B:
// the reference bar has no magnifier, it stays because it works). One
// component with an `icon` prop rather than near-identical files: they differ
// only in the glyph and in what their use site opens. The WLAN and Ton pills
// show live state and use `WifiGlyph` / `SoundGlyph` instead.

Component GlyphPill {
    props: {
        icon: Str,
        selected: Bool,
    }
    TopBarPill { selected: $props.selected, gap: 0 } {
        content {
            Icon { symbol: $props.icon, size: 13 }
                .fg(label)
        }
    }
}
