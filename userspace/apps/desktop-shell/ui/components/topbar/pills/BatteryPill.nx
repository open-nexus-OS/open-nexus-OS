//
// The battery pill (design artifacts: TopBar, desktop): glyph plus the
// percentage — the one status the design spells out in the bar rather than
// leaving to an icon, because "how much is left" is a number, not a shape.

Component BatteryPill {
    props: {
        selected: Bool,
    }
    TopBarPill { selected: $props.selected, gap: 0 } {
        content {
            BatteryGlyph { }
        }
    }
}
