//
// The clock pill (design artifacts: TopBar) — the Kalender opener. Desktop
// shows time · date, the touch modes only the time: the same trigger, trimmed
// to the room the mode has. The time and the "·" are footnote semibold, the
// date caption in `labelSecondary`; every label carries the wallpaper halo.
//
// `$state.date` is the clock tick's long form ("Freitag, 23. Oktober"), which
// the launcher shares; the design's short form ("Fr, 23. Okt.") needs a second
// argument on the host's `Tick` (app-host `probe/clock.rs`) — open.

Component ClockPill {
    props: {
        wide: Bool,
        selected: Bool,
    }
    if $props.wide {
        TopBarPill { selected: $props.selected, gap: 6 } {
            content {
                Text($state.clock).textStyle(footnote).fontWeight(semibold).figures(tabular).fg(label).shadow(halo)
                Text(@t("shell.dot")).textStyle(footnote).fontWeight(semibold).fg(labelSecondary).shadow(halo)
                Text($state.date).textStyle(caption).fg(labelSecondary).shadow(halo)
            }
        }
    } else {
        TopBarPill { selected: $props.selected, gap: 6 } {
            content {
                Text($state.clock).textStyle(footnote).fontWeight(semibold).figures(tabular).fg(label).shadow(halo)
            }
        }
    }
}
