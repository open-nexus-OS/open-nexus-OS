//
// The combined status pill (design artifacts: TopBar, tablet and phone): WLAN
// · Lautsprecher · Batterie with its percentage in ONE pill (8 apart, the
// battery group 4) that opens the Control Center. This is the touch modes'
// entire right zone — there are no separate WLAN/Ton/Batterie panels there,
// so there is nothing for separate pills to open. The glyphs mirror live
// state (`WifiGlyph`, `SoundGlyph`).

Component StatusPill {
    props: {
        selected: Bool,
    }
    TopBarPill { selected: $props.selected, gap: 8 } {
        content {
            WifiGlyph { }
            SoundGlyph { }
            BatteryGlyph { }
        }
    }
}
