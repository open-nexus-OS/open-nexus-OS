//
// The LANDSCAPE touch dock (`vw ≥ 1024`). The design artifacts have no
// landscape dock of their own: the tablet dock is the layout at every touch
// width from 640 up, so this is `DockRegular`. It stays a name only because
// `ShellPage` still picks a dock per width class; once that picks
// `DockRegular` for `wide` as well, this file goes.

Component DockWide {
    DockRegular { }
}
