//
// The TABLET touch dock (design artifacts: TaskbarDock `TabletDock`) — the
// layout at every touch width from 640 up (portrait and landscape alike):
// floating 12 above the edge, the launcher circle and the dock pill side by
// side and CENTRED (8 apart, the pill stretched to the circle's 72), a bare
// nav row below (30×30 ghost circles, 24 apart). The pill is the dock's own
// glass — `dock` material, radius 24, shadow4 — holding the app icons (gap
// 4, each with its running dot) and, while something plays, a 1×32 divider
// and the small player. App icons never blur.

Component DockRegular {
    Stack {
        Stack {
            Stack {
                LauncherButton { }
            }
            .label(@t("bar.launcher"))
            on Tap -> dispatch(SetPanel("launcher"))
            Stack {
                List($state.apps) { app in
                    Stack {
                        DockTile { label: app.label, icon: app.icon, iconTop: app.iconTop, iconBottom: app.iconBottom, iconArt: app.iconArt, running: app.running, marker: true }
                    }
                    .key(app.id)
                    .label(app.label)
                    on Tap -> dispatch(Activate(app.id))
                }
                .direction(row)
                .align(center)
                .gap(4)
                if $state.nowPlaying {
                    Stack {
                        Stack {
                            Stack { }
                                .width(1)
                                .height(32)
                                .bg(separator)
                        }
                        .paddingX(4)
                        MiniPlayer { compact: true }
                    }
                    .direction(row)
                    .align(center)
                    .gap(4)
                } else {
                    Stack { }
                        .overlay()
                }
            }
            .direction(row)
            .align(center)
            .gap(4)
            .paddingX(12)
            .paddingY(8)
            .material(dock)
            .shadow(shadow4)
            .rounded(xl)
        }
        .direction(row)
        .gap(8)
        DockNav { }
    }
    .align(center)
    .gap(8)
    .paddingX(24)
    .paddingBottom(12)
}

// The bare nav row under the tablet dock: back · home · overview.
Component DockNav {
    Stack {
        Circle { size: 30
            Icon { symbol: "arrow.left", size: 16 }
                .fg(label)
        }
        .label(@t("common.back"))
        on Tap -> navigate("/")
        Circle { size: 30
            Icon { symbol: "house", size: 16 }
                .fg(label)
        }
        .label(@t("bar.home"))
        on Tap -> navigate("/")
        Circle { size: 30
            Icon { symbol: "square", size: 14 }
                .fg(label)
        }
        .label(@t("bar.overview"))
        on Tap -> navigate("/")
    }
    .direction(row)
    .align(center)
    .gap(24)
}
