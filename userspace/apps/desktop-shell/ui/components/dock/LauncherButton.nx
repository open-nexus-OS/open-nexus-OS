//
// The round floating launcher button (design_handoff_launcher §8.2:
// landscape dock, 42×42 panel glass, bare glyph). Tap handler attaches at
// the use site (→ `SetPanel("launcher")`).

Component LauncherButton {
    Stack {
        Icon { symbol: "square.grid" }
            .fg(onSurface)
    }
    .width(42)
    .height(42)
    .material(panel)
    .rounded(full)
    .align(center)
    .justify(center)
}
