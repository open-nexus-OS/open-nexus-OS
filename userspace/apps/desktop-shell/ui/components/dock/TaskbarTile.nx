//
// One desktop-taskbar app button (design artifacts: TaskbarDock): 48×50,
// radius 12, padding 4 4 2 — the BUTTON is the tile plus its run bar, so the
// host's hover wash covers both. Inside: `AppIcon xs` — 40×40, radius 12,
// shadow2 — and 2 below it the run bar, 20×2, `label` @ .70, transparent
// while the app has no window (the slot keeps its height, so a state flip
// never shifts the row: "the taskbar is a window list").
//
// The icon is the bundle's baked artwork when it ships one, else the
// manifest's gradient tile, else the plain card tile — fallbacks for apps
// without artwork, on the same radius and shadow. (Every artwork gets the
// native look: the registry row carries no icon variant, so a freestanding
// icon such as Stash's folder cannot drop its shadow yet.) Tap handlers
// attach at the use site.

Component TaskbarTile {
    props: {
        label: Str,
        icon: Str,
        iconTop: Str,
        iconBottom: Str,
        iconArt: Str,
        running: Bool,
    }
    Stack {
        if $props.iconArt != "" {
            Stack {
                Image { source: $props.iconArt, size: 40 }
            }
            .width(40)
            .height(40)
            .rounded(md)
            .shadow(shadow2)
        } else { if $props.iconTop != "" {
            Stack {
                Icon { symbol: $props.icon, size: 20 }
                    .fg(onAccent)
            }
            .width(40)
            .height(40)
            .bgGradient($props.iconTop, $props.iconBottom)
            .rounded(md)
            .shadow(shadow2)
            .align(center)
            .justify(center)
        } else {
            Stack {
                Icon { symbol: $props.icon, size: 20 }
                    .fg(label)
            }
            .width(40)
            .height(40)
            .material(card)
            .border(hairline)
            .borderColor(glassEdge)
            .rounded(md)
            .shadow(shadow2)
            .align(center)
            .justify(center)
        } }
        if $props.running {
            Stack { }
                .width(20)
                .height(2)
                .bg(label)
                .rounded(full)
                .opacity(179)
        } else {
            Stack { }
                .width(20)
                .height(2)
        }
    }
    .align(center)
    .gap(2)
    .paddingTop(4)
    .paddingX(4)
    .paddingBottom(2)
    .rounded(md)
}
