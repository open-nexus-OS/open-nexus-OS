//
// One dock app icon (design_handoff_launcher dock pill entry, `AppIcon sm`,
// LAUNCHER-SPEC §2/§8): tile 48, radius 13, no label — per-app artwork
// sprite, gradient tile, or the uniform glass tile. `running` renders the
// 4×4 dot under the tile (§7: app runs in the background, tap brings it
// forward); the marker slot keeps its height either way. Tap handlers
// attach at the use site.

Component DockTile {
    props: {
        label: Str,
        icon: Str,
        iconTop: Str,
        iconBottom: Str,
        iconArt: Str,
        running: Bool,
    }
    Stack {
        if $props.iconArt != "" {
            Image { source: $props.iconArt, size: 48 }
        } else { if $props.iconTop != "" {
            Stack {
                Icon { symbol: $props.icon, size: 24 }
                    .fg(onAccent)
            }
            .width(48)
            .height(48)
            .bgGradient($props.iconTop, $props.iconBottom)
            .rounded(13)
            .align(center)
            .justify(center)
        } else {
            Stack {
                Icon { symbol: $props.icon, size: 24 }
                    .fg(onSurface)
            }
            .width(48)
            .height(48)
            .material(card)
            .rounded(13)
            .align(center)
            .justify(center)
        } }
        if $props.running {
            Stack { }
                .width(4)
                .height(4)
                .bg(onSurface)
                .rounded(2)
                .opacity(179)
        } else {
            Stack { }
                .width(4)
                .height(4)
        }
    }
    .align(center)
    .gap(0)
}
