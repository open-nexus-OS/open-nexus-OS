//
// One touch-dock app icon (design artifacts: TaskbarDock, `AppIcon sm`): 48×48,
// radius 12, shadow2, no label — the bundle's baked artwork, else the
// manifest's gradient tile, else the plain card tile (fallbacks for apps
// without artwork, same radius and shadow; the registry row carries no icon
// variant, so a freestanding icon keeps the native shadow). With `marker` the
// 4×4 running dot sits 2 below (`label` @ .70, transparent while the app has
// no window — the slot keeps its height either way); the phone dock passes
// `marker: false` and has no dot at all. The radius is the icon's, so the
// host's hover wash takes its shape. Tap handlers attach at the use site.

Component DockTile {
    props: {
        label: Str,
        icon: Str,
        iconTop: Str,
        iconBottom: Str,
        iconArt: Str,
        running: Bool,
        marker: Bool,
    }
    Stack {
        if $props.iconArt != "" {
            Stack {
                Image { source: $props.iconArt, size: 48 }
            }
            .width(48)
            .height(48)
            .rounded(md)
            .shadow(shadow2)
        } else { if $props.iconTop != "" {
            Stack {
                Icon { symbol: $props.icon, size: 24 }
                    .fg(onAccent)
            }
            .width(48)
            .height(48)
            .bgGradient($props.iconTop, $props.iconBottom)
            .rounded(md)
            .shadow(shadow2)
            .align(center)
            .justify(center)
        } else {
            Stack {
                Icon { symbol: $props.icon, size: 24 }
                    .fg(label)
            }
            .width(48)
            .height(48)
            .material(card)
            .rounded(md)
            .shadow(shadow2)
            .align(center)
            .justify(center)
        } }
        if $props.marker {
            if $props.running {
                Stack { }
                    .width(4)
                    .height(4)
                    .bg(label)
                    .rounded(full)
                    .opacity(179)
            } else {
                Stack { }
                    .width(4)
                    .height(4)
            }
        } else {
            Stack { }
                .overlay()
        }
    }
    .align(center)
    .gap(2)
    .rounded(md)
}
