//
// The PHONE touch dock (design_handoff_launcher §8.3, `vw < 640`): a
// full-width dock row — every app in `flex:1`, evenly spread — and a bare
// nav row below with back · launcher glyph · home · overview (the launcher
// glyph moves into the nav here; no room for its own circle). No mini
// player, no running dot (§7: too little room; state lives in the
// overview).

Component DockCompact {
    Stack {
        Stack {
            Stack {
                List($state.apps) { app in
                    Stack {
                        DockTile { label: app.label, icon: app.icon, iconTop: app.iconTop, iconBottom: app.iconBottom, iconArt: app.iconArt, running: app.running }
                    }
                    .key(app.id)
                    .grow(1)
                    .align(center)
                    on Tap -> dispatch(Activate(app.id))
                }
                .direction(row)
                .grow(1)
            }
            .direction(row)
            .align(center)
            .paddingX(3)
            .paddingY(2)
            .material(panel)
            .rounded(full)
            Stack {
                Spacer
                Stack {
                    Icon { symbol: "chevron.left", size: 16 }
                        .fg(onSurface)
                }
                .padding(2)
                on Tap -> navigate("/")
                Spacer
                Stack {
                    Icon { symbol: "square.grid", size: 20 }
                        .fg(onSurface)
                }
                .padding(2)
                on Tap -> dispatch(SetPanel("launcher"))
                Spacer
                Stack {
                    Icon { symbol: "house", size: 16 }
                        .fg(onSurface)
                }
                .padding(2)
                on Tap -> navigate("/")
                Spacer
                Stack {
                    Icon { symbol: "square", size: 14 }
                        .fg(onSurface)
                }
                .padding(2)
                on Tap -> navigate("/")
                Spacer
            }
            .direction(row)
            .align(center)
        }
        .paddingX(4)
        .paddingY(3)
        .gap(2)
    }
}
