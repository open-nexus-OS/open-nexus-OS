//
// The PHONE touch dock (design artifacts: TaskbarDock `PhoneDock`, `vw <
// 640`): one full-width dock pill — `dock` material, radius 24, shadow4,
// padding 8 12 — with every app in an equal share (no running dot, no
// player: too little room; state lives in the overview), and a bare nav row
// below with back · launcher glyph · home · overview spread space-around
// (the launcher glyph moves into the nav here; no room for its own circle).
// Padding 0 16 12.

Component DockCompact {
    Stack {
        Stack {
            List($state.apps) { app in
                Stack {
                    DockTile { label: app.label, icon: app.icon, iconTop: app.iconTop, iconBottom: app.iconBottom, iconArt: app.iconArt, running: app.running, marker: false }
                }
                .key(app.id)
                .grow(1)
                .align(center)
                .label(app.label)
                on Tap -> dispatch(Activate(app.id))
            }
            .direction(row)
            .align(center)
            .gap(8)
            .grow(1)
        }
        .direction(row)
        .align(center)
        .paddingX(12)
        .paddingY(8)
        .material(dock)
        .shadow(shadow4)
        .rounded(xl)
        // space-around: half a share at either end, a full share between.
        Stack {
            Stack { }
                .grow(1)
            Circle { size: 30
                Icon { symbol: "arrow.left", size: 16 }
                    .fg(label)
            }
            .label(@t("common.back"))
            on Tap -> navigate("/")
            Stack { }
                .grow(2)
            Circle { size: 30
                Icon { symbol: "square.grid", size: 20 }
                    .fg(label)
            }
            .label(@t("bar.launcher"))
            on Tap -> dispatch(SetPanel("launcher"))
            Stack { }
                .grow(2)
            Circle { size: 30
                Icon { symbol: "house", size: 16 }
                    .fg(label)
            }
            .label(@t("bar.home"))
            on Tap -> navigate("/")
            Stack { }
                .grow(2)
            Circle { size: 30
                Icon { symbol: "square", size: 14 }
                    .fg(label)
            }
            .label(@t("bar.overview"))
            on Tap -> navigate("/")
            Stack { }
                .grow(1)
        }
        .direction(row)
        .align(center)
    }
    .gap(8)
    .paddingX(16)
    .paddingBottom(12)
}
