//
// One page of the paged grid (design artifacts: launcher, Grid). The page itself is one viewport
// wide — a paged scroller's child without a width of its own is (the snap math is page k = k ×
// viewport width): the xl grids keep their width and sit in its middle, the phone's md grid
// fills it (four equal columns at any phone width). The design MEASURES `cols = ⌊width / 144⌋`
// and `rows = ⌊(height − 32 + 20) / 154⌋`; the DSL has no container measurement, so each size
// class carries the numbers that formula gives for the surface it ships on:
//   desktop, landscape touch (1280 × 800 → column 1232 wide, 562 high)  → 8 × 3 = 24 per page
//   tablet portrait (834 × 1194 → 786 wide)                              → 5 × 5 = 25 per page
//   phone (md cells 84 × 112, row gap 16 — the artifact's 4 columns)      → 4 × 5 = 20 per page
// `PagerDots` and `PagerDotSlot` count the same pages (24 · 25 · 20).

Component LauncherPage {
    props: {
        page: Int,
    }
    Stack {
        if device.profile == desktop || device.sizeClass == "wide" {
            Stack {
                PageCells { page: $props.page, per: 24, columns: 8, width: 1232, md: false, rowGap: 20 }
            }
            .align(center)
        } else { if device.sizeClass == "regular" {
            Stack {
                PageCells { page: $props.page, per: 25, columns: 5, width: 786, md: false, rowGap: 20 }
            }
            .align(center)
        } else {
            PageCells { page: $props.page, per: 20, columns: 4, width: 0, md: true, rowGap: 16 }
        } }
    }
}
