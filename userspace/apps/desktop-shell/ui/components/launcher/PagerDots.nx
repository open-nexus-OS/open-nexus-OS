//
// The page indicator (design artifacts: PageControl md): a centred row of dots under the paged
// grid — 8 px dots, the active page a 20×8 capsule, 8 px apart, 8 px under the grid, each dot's
// hit area 20 high. It is HIDDEN while there is a single page. One `PagerDotSlot` per page —
// each its own node of the row (several `if`s inside one branch arm would stack in a column),
// each carrying its own spacing (an absent page is a zero-wide slot, so no gap is left
// behind). The row never gives up its height to an overfull launcher (`.shrink(0)`); the grid
// above gives way. `per` is the page size of the surface — LauncherPage's numbers.

Component PagerDots {
    if device.profile == desktop || device.sizeClass == "wide" {
        PagerRow { per: 24 }
    } else { if device.sizeClass == "regular" {
        PagerRow { per: 25 }
    } else {
        PagerRow { per: 20 }
    } }
}
