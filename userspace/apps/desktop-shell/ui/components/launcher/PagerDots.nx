//
// The page indicator (design artifacts: launcher §11): a centred row of dots under the paged
// grid, 8 px apart, one `PagerDotSlot` per page — each its own node of the row (several `if`s
// inside one branch arm would stack in a column), each carrying its own spacing (an absent page
// is a zero-wide slot, so no gap is left behind). The row never gives up its height to an
// overfull launcher (`.shrink(0)`); the grid above gives way.

Component PagerDots {
    Stack {
        PagerDotSlot { page: 0 }
        PagerDotSlot { page: 1 }
        PagerDotSlot { page: 2 }
        PagerDotSlot { page: 3 }
    }
    .direction(row)
    .justify(center)
    .align(center)
    .gap(0)
    .paddingY(12)
    .shrink(0)
}
