//
// The COMPACT launcher (design artifacts: launcher, compact, desktop default): 720×520 fixed,
// radius 24, padding 24, panel glass (the operator's decision: glass in the compact and in the
// full launcher), shadow3 — the desktop behind it stays sharp (no scrim; LauncherHost owns the
// backdrop). Head = search + the round expand and close buttons, the section row ("ALLE APPS" ·
// count), a 4-column md grid that SCROLLS vertically (or the empty state), and the identity
// footer. The rows sit 16 · 12 · 0 apart (the grid's own padding and the footer's top padding
// add the rest). Grows out of the taskbar (slideUp).

Component LauncherWindow {
    Stack {
        Stack {
            Stack {
                SearchBar { value: $state.query, placeholder: @t("launcher.search") }
                    .autofocus(true)
                on Change -> dispatch(QueryChanged)
            }
            .grow(1)
            Stack {
                ActButton { icon: "maximize" }
            }
            on Tap -> dispatch(SetPanel("launcher-big"))
            Stack {
                ActButton { icon: "xmark" }
            }
            on Tap -> dispatch(SetPanel(""))
        }
        .direction(row)
        .align(center)
        .gap(8)
        .paddingBottom(16)
        LauncherSection { }
        Stack {
            if len($state.apps) == 0 && !$state.loading {
                LauncherEmpty { large: false }
            } else {
                LauncherGrid { }
            }
        }
        .grow(1)
        .scroll(vertical)
        LauncherFooter { }
    }
    .width(720)
    .height(520)
    .padding(24)
    .gap(0)
    .material(panel)
    .rounded(xl)
    .shadow(shadow3)
    .transition(slideUp)
}
