//
// One dot of the page indicator (design artifacts: PageControl md): the ACTIVE page a 20×8
// capsule at 92 % of `label`, every other page an 8×8 dot at 30 %, its hit area 20 high; a tap
// glides to its page (`SetPage(k)` → the store's scrollToPage effect).

Component PagerDot {
    props: {
        page: Int,
    }
    if $state.page == $props.page {
        Stack { }
            .width(20)
            .height(8)
            .rounded(full)
            .bg(label)
            .opacity(235)
    } else {
        Stack { }
            .width(8)
            .height(8)
            .rounded(full)
            .bg(label)
            .opacity(77)
            .hitSlop(6)
            .label(@t("launcher.pageDot"))
        on Tap -> dispatch(SetPage($props.page))
    }
}
