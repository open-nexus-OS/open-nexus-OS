//
// One dot of the page indicator (design artifacts: launcher §11): the ACTIVE page an 18×7
// pill, every other page a 7×7 dot, radius 4, that glides to its page on a tap
// (`SetPage(k)` → the store's scrollToPage effect).

Component PagerDot {
    props: {
        page: Int,
    }
    if $state.page == $props.page {
        Stack { }
            .width(18)
            .height(7)
            .rounded(4)
            .bg(label)
            .opacity(230)
    } else {
        Stack { }
            .width(7)
            .height(7)
            .rounded(4)
            .bg(label)
            .opacity(71)
            .hitSlop(8)
        on Tap -> dispatch(SetPage($props.page))
    }
}
