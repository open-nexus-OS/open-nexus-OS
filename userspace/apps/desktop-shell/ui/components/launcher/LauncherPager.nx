//
// The paged app grid (design artifacts: launcher, PagedView + PageControl): a horizontal
// `.scroll(paged)` strip of page cells — the HOST's paged track (TASK-0354 P12): a drag follows
// the pointer, past either end on a rubber band (also with a single page) that glides back; a
// release past 16 % of the width or a flick turns a page, the wheel turns past one detent; each
// turn fires `PageNext`/`PagePrev` so `$state.page` follows, and every turn and return is a
// 500 ms glide; a dot tap glides via `svc.shell.scrollToPage`. An icon's `Tap` fires on the
// release, never after a drag (a swipe across an icon does not open it). The strip's children are SIX `LauncherPage`
// nodes — one node per page, because several `if`s in one branch arm would stack in a column
// and put page 2 under page 1 instead of beside it; a page without apps is an empty, zero-wide
// cell. The strip takes all the height between the search row and the page indicator, so its
// viewport — where a drag grabs the track — is the whole area, and each page starts its rows at
// the top (the operator, 2026-11-19); the indicator sits at the bottom and hides itself with a
// single page.

Component LauncherPager {
    Stack {
        Stack {
            LauncherPage { page: 0 }
            LauncherPage { page: 1 }
            LauncherPage { page: 2 }
            LauncherPage { page: 3 }
            LauncherPage { page: 4 }
            LauncherPage { page: 5 }
        }
        .direction(row)
        .grow(1)
        .scroll(paged)
        on PageNext -> dispatch(PageNext)
        on PagePrev -> dispatch(PagePrev)
        PagerDots { }
    }
    .grow(1)
    .gap(0)
}
