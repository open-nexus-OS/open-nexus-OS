//
// The paged app grid (design artifacts: launcher, PagedView + PageControl): a horizontal
// `.scroll(paged)` strip of page cells — the HOST snaps the offset to whole pages (glide ease),
// the wheel turns ±1 page and fires `PageNext`/`PagePrev` so `$state.page` tracks the snap; a
// dot tap glides via `svc.shell.scrollToPage`. The strip's children are SIX `LauncherPage`
// nodes — one node per page, because several `if`s in one branch arm would stack in a column
// and put page 2 under page 1 instead of beside it; a page without apps is an empty, zero-wide
// cell. The strip hugs its tallest page and two spacers centre it vertically between the search
// row and the page indicator (the design centres the rows of a page); the indicator sits at the
// bottom and hides itself with a single page.

Component LauncherPager {
    Stack {
        Spacer
        Stack {
            LauncherPage { page: 0 }
            LauncherPage { page: 1 }
            LauncherPage { page: 2 }
            LauncherPage { page: 3 }
            LauncherPage { page: 4 }
            LauncherPage { page: 5 }
        }
        .direction(row)
        .scroll(paged)
        on PageNext -> dispatch(PageNext)
        on PagePrev -> dispatch(PagePrev)
        Spacer
        PagerDots { }
    }
    .grow(1)
    .gap(0)
}
