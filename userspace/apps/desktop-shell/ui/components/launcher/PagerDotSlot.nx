//
// One page's place in the page indicator: the page's `PagerDot` with 4 px on each side while
// the page has content (`per` apps a page), an empty, zero-wide slot otherwise. The spacing
// lives in the slot, not in the row's gap, so an absent page takes no room and the dots stay
// centred.

Component PagerDotSlot {
    props: {
        page: Int,
        per: Int,
    }
    if len($state.apps) > $props.per * $props.page {
        Stack {
            PagerDot { page: $props.page }
        }
        .paddingX(4)
    } else {
        Stack { }
    }
}
