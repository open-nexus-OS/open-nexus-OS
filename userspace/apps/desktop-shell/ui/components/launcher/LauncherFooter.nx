//
// The compact launcher's identity footer (design artifacts: launcher, compact): a 1 px
// separator across the top, then 16 px of padding and the row — avatar (34, initials from the
// name) and name (subheadline medium) on the left, the round settings and power buttons on the
// right, 6 px apart. Compact mode only; the full-screen launcher has no footer. Power closes
// the launcher (session actions land with the session product). The avatar wears the `online` presence dot: the
// signed-in user is, by definition, online.

Component LauncherFooter {
    Stack {
        Stack { }
            .height(1)
            .bg(separator)
        Stack {
            Avatar { name: @t("launcher.userName"), size: 34, status: "online" }
            Text(@t("launcher.userName")).textStyle(subheadline).fontWeight(medium).fg(label)
            Spacer
            Stack {
                Stack {
                    ActButton { icon: "gearshape" }
                }
                on Tap -> dispatch(Launch("settings"))
                Stack {
                    ActButton { icon: "power" }
                }
                on Tap -> dispatch(SetPanel(""))
            }
            .direction(row)
            .gap(6)
        }
        .direction(row)
        .align(center)
        .gap(8)
        .paddingTop(16)
    }
}
