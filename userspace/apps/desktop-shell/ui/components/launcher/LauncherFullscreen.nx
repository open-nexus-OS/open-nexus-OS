//
// The FULLSCREEN launcher (design artifacts: launcher, full screen): the touch shell's only
// launcher state and the desktop expand state ("launcher-big"). Thick glass (`.material(dock)`)
// over the wallpaper — the operator's decision: glass in the compact and in the full launcher.
// The column is padded 12 top · 24 sides · 16 bottom inside the work band (the design's 48 ·
// 24 · 72 measured from the screen edges, less the 36 px bar and the 56 px taskbar): the
// centred greeting, the search row (search · shrink · close), then the PAGED xl grid (horizontal
// pages, page dots, wheel turns pages; NO vertical scrolling) — or the empty state when the
// search has no hits. No footer here: that is the compact launcher's.

Component LauncherFullscreen {
    Stack {
        LauncherGreeting { }
        LauncherSearchRow { }
        if len($state.apps) == 0 && !$state.loading {
            LauncherEmpty { large: true }
        } else {
            LauncherPager { }
        }
    }
    .grow(1)
    .gap(16)
    .paddingTop(12)
    .paddingBottom(16)
    .paddingX(24)
    .material(dock)
    .transition(slideUp)
}
