//
// The shell's overlay layer (TASK-0074 / ADR-0068): ONE component for both
// `ShellPage`s, mounted LAST on the page root so its layers cover the bar and
// the dock too. A plain full-bleed `.overlay()` with no handler of its own —
// it blocks nothing — carrying the kinded layers the kit provides:
//
//   WinAlert  (modal)      — "Ausschalten?" from the Control-Center power button
//   WinToast  (transient)  — the system toast the confirm answers with: there
//                            is no power service yet, and the shell says so
//                            instead of pretending (4 s, left edge).
//   SearchOverlay (modal)  — the top-bar magnifier's search: field, Apps /
//                            Files / Clipboard, results (TASK-0067B).
//   CaptureOverlay (modal) — the screenshot UI over the frozen frame (Print,
//                            TASK-0068), and its toast: the saved file's name,
//                            or the honest "could not save".
//
// Each layer is emitted by exactly one store field (`powerPrompt`, `toast`)
// and leaves only through the kit's dispatched events — the runtime never
// hides an overlay by itself.

Component ShellOverlays {
    Stack {
        if $state.powerPrompt {
            WinAlert {
                id: "power",
                title: @t("power.askTitle"),
                message: @t("power.askBody"),
                cancelLabel: @t("power.cancel"),
                confirmLabel: @t("power.confirm"),
                destructive: true,
            }
        } else {
            Stack { }
        }
        if $state.searchOpen {
            SearchOverlay { }
        } else {
            Stack { }
        }
        if $state.capOpen {
            CaptureOverlay { }
        } else {
            Stack { }
        }
        if $state.toast == "capture" && $state.capToast == "saved" {
            WinToast {
                id: "capture",
                icon: "camera",
                title: @t("capture.savedTitle"),
                subtitle: $state.capSaved,
            }
        } else {
            if $state.toast == "capture" && $state.capToast == "failed" {
                WinToast {
                    id: "capture",
                    icon: "camera",
                    title: @t("capture.failedTitle"),
                    subtitle: @t("capture.failedBody"),
                }
            } else {
                Stack { }
            }
        }
        if $state.toast == "power" {
            WinToast {
                id: "power",
                icon: "power",
                title: @t("power.toastTitle"),
                subtitle: @t("power.toastBody"),
            }
        } else {
            Stack { }
        }
    }
    .overlay()
}
