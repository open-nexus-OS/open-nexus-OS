//
// Control-Center header (design_handoff_panels §3, row 1): three 30px glyph
// buttons and the user avatar, pushed right.
//
// Ausschalten asks through the kit's `WinAlert` (TASK-0074: `PowerAsk` opens
// the shell's modal; `ShellOverlays` mounts it). Edit · Einstellungen are
// drawn but inert — there is no edit mode and no settings deep link yet. They
// stay in the layout because the header's balance is part of the design and
// a button that visibly does nothing is more honest than a gap that silently
// means "unfinished".

Component CcHeader {
    Stack {
        Spacer
        HeaderIconButton { icon: "pencil" }
        Stack {
            HeaderIconButton { icon: "power" }
        }
        on Tap -> dispatch(PowerAsk)
        HeaderIconButton { icon: "gearshape" }
        Circle { size: 30
            Text(@t("control.userInitial")).textSize(xs).fontWeight(bold).fg(onGlass)
        }
        .material(subtle)
    }
    .direction(row)
    .align(center)
    .gap(1)
}
