//
// Brightness card (design_handoff_panels §3, row 3): the caption row over a
// slider paired with the Erscheinungsbild button.
//
// The slider is LIVE: a tap along the track writes `brightness` (TASK-0077B
// P2b — the bind carries the rule that turns the point into a percent). The
// prediction this comment used to carry held — the value-carrying interaction
// landed without touching a line of the markup below. What is still missing is
// a backlight service to send the value to, and a DRAG: the surface delivers
// taps, not held moves, so the value jumps to where you touch.

Component CcBrightnessCard {
    Stack {
        SectionRow { icon: "desktopcomputer", label: @t("control.brightness") }
        Stack {
            Slider { value: $state.brightness, icon: "sun.max" }
                .label(@t("control.brightness"))
            AppearanceButton { }
        }
        .direction(row)
        .align(center)
        .gap(2)
    }
    .gap(2)
    .paddingX(4)
    .paddingY(3)
    .rounded(20)
    .material(card)
}
