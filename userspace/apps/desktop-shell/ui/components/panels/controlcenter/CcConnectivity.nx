//
// The 2×2 tile grid (design artifacts: panels §3, row 2): WLAN · Bluetooth on the
// left, Flugmodus · Ansichtsmodus on the right, in two `card` columns of 142 =
// (328 − 2×16 − 12) / 2 with a 12 px gap. The columns are stated, not grown:
// `.grow(1)` splits only the FREE space over an auto basis, so the column
// holding the longer label came out wider and the narrower tile's slice fell
// outside its hit box (taps reached the panel's no-op absorber).
//
// The Ansichtsmodus tile is the shell's layout switch and the one tile here
// that is REAL. It is ALWAYS on: it names which of two modes you are in, so it
// changes tint, glyph and label instead of dimming. Its state comes from
// `device.profile`, never a store — see `controlcenter.store.nx`. The glyph is
// the monitor / tablet pair the theme's symbol map has (the design's laptop
// glyph is not mapped yet).

Component CcConnectivity {
    Stack {
        Stack {
            Stack {
                ToggleTile {
                    icon: "wifi",
                    label: @t("control.wifi"),
                    subOn: @t("control.wifiNet"),
                    subOff: @t("control.off"),
                    tint: "accent",
                    active: $state.wifiOn,
                }
            }
            .direction(row)
            on Tap -> dispatch(ToggleWifi)
            Stack {
                ToggleTile {
                    icon: "bluetooth",
                    label: @t("control.bluetooth"),
                    subOn: @t("control.on"),
                    subOff: @t("control.off"),
                    tint: "accent",
                    active: $state.bluetoothOn,
                }
            }
            .direction(row)
            on Tap -> dispatch(ToggleBluetooth)
        }
        .gap(8)
        .width(142)
        .padding(12)
        .rounded(16)
        .material(card)
        Stack {
            Stack {
                ToggleTile {
                    icon: "airplane",
                    label: @t("control.airplane"),
                    subOn: @t("control.on"),
                    subOff: @t("control.off"),
                    tint: "modeAirplane",
                    active: $state.airplaneOn,
                }
            }
            .direction(row)
            on Tap -> dispatch(ToggleAirplane)
            if device.profile == desktop {
                Stack {
                    ToggleTile {
                        icon: "laptopcomputer",
                        label: @t("control.desktop"),
                        subOn: @t("control.viewMode"),
                        subOff: @t("control.viewMode"),
                        tint: "modeDesktop",
                        active: true,
                    }
                }
                .direction(row)
                on Tap -> dispatch(SetMode("tablet"))
            } else {
                Stack {
                    ToggleTile {
                        icon: "ipad",
                        label: @t("control.tablet"),
                        subOn: @t("control.viewMode"),
                        subOff: @t("control.viewMode"),
                        tint: "modeTablet",
                        active: true,
                    }
                }
                .direction(row)
                on Tap -> dispatch(SetMode("desktop"))
            }
        }
        .gap(8)
        .width(142)
        .padding(12)
        .rounded(16)
        .material(card)
    }
    .direction(row)
    .gap(12)
}
