//
// Volume card (design artifacts: panels §3, row 4). Structurally the brightness
// card with a different pair — and the Sound panel repeats it verbatim, which
// is the point of it being a component: one volume control, one appearance in
// three places.
//
// The slider is LIVE both ways: a tap along the track writes `volume`
// (TASK-0077B P2b), and mute drives it to 0 / un-mute back to 50 — the button
// beside it reads the same field, so the two cannot contradict.

Component CcSoundCard {
    props: {
        label: Str,
    }
    Stack {
        SectionRow { icon: "speaker.wave", label: $props.label }
        Stack {
            Slider { value: $state.volume, icon: "speaker" }
                .label(@t("control.volume"))
            MuteButton { }
        }
        .direction(row)
        .align(center)
        .gap(12)
    }
    .gap(8)
    .paddingX(16)
    .paddingY(12)
    .rounded(16)
    .material(card)
}
