//
// Kalender (design artifacts: panels §5): 288 wide, radius xl 24, anchored top
// left, padding 12. The panel STAYS GLASS (`panel` material); its content is
// `calendar/CalendarBody` — month header with navigation, a Monday-first week
// grid, and up to three coming appointments.

Component CalendarPanel {
    Stack {
        CalendarBody { }
    }
    .width(288)
    .padding(12)
    .rounded(xl)
    .material(panel)
    .transition(slideDown)
}
