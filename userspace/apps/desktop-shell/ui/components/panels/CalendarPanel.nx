//
// Kalender (design_handoff_panels §5): 288 wide, radius 24, anchored top left.
// Month header with navigation, a Monday-first week grid, and up to three
// coming appointments.
//
// DEMO DATA — the shell has no calendar service and the DSL has no clock
// arithmetic, so the three months are authored (see `CalMonthNow`) and
// `CalStore` pages between them. Everything the user can do here works; what
// it shows is fixed.

Component CalendarPanel {
    Stack {
        CalHeader { }
        CalWeekHeader { }
        if $state.calMonth == 0 {
            CalMonthPrev { }
        } else if $state.calMonth == 2 {
            CalMonthNext { }
        } else {
            CalMonthNow { }
        }
        GroupLabel { label: @t("cal.upcoming") }
        CalUpcoming { }
    }
    .width(288)
    .gap(2)
    .padding(3)
    .rounded(24)
    .material(panel)
    .shadow(xxl)
    .transition(slideDown)
}
