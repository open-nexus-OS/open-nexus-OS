//
// A tier's header in the notification centre (design artifacts: panels §4): its icon and its
// overline title ("Wichtig", "Lautlos").

Component NotifSubHeader {
    props: {
        icon: Str,
        title: Str,
    }
    Stack {
        Icon { symbol: $props.icon, size: 13 }
            .fg(labelSecondary)
        Text($props.title).textStyle(overline).fg(labelSecondary)
    }
    .direction(row)
    .align(center)
    .gap(8)
    .paddingX(2)
    .paddingTop(4)
}
