//
// The stacked mail card (design artifacts: panels §4): a badged front card with a
// second card showing behind it, so "several" reads without listing them.
//
// The design overlaps the two (the back card is full size, inset 8 px and
// 7 px lower). There is no transform or negative margin, so the peek is a real
// band under the front card: 8 inset per side, 7 px high, rounded only at the
// bottom (`.corners`), on a `card` layer with the front card's shadow falling
// across it — it reads as the lower edge of a card behind.

Component NotifStack {
    Stack {
        NotifCard {
            kind: "mail",
            appId: "chat",
            app: @t("notif.mail"),
            time: @t("notif.t5min"),
            title: @t("notif.mailTitle"),
            body: @t("notif.mailBody"),
            badge: @t("notif.mailCount"),
            act1: "",
            act2: "",
        }
        Stack {
            Stack { }
                .height(7)
                .corners(0, 0, 7, 7)
                .material(card)
        }
        .paddingX(8)
    }
    .gap(0)
}
