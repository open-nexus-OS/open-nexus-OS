//
// The stacked mail card (design_handoff_panels §4): a badged front card with a
// second card showing behind it, so "several" reads without listing them.
//
// The handoff overlaps the two — the back card is full size, inset 8px per
// side and translated 7px DOWN, so only that sliver of it shows. There is no
// transform here and no negative margin, so the sliver is a real box below the
// front card. It has to be tall enough to carry a card's corner radius: at the
// handoff's 7px the radius clamps to 3.5 and the thing reads as a pill bar
// rather than the bottom edge of a card, which is exactly how it looked. 10px
// with a 10px radius reads as an edge; dimming it and letting the front card's
// shadow fall across it puts it behind.
//
// `.overlay()` is deliberately not used to get a true overlap: it lifts a
// child OUT of flow and paints it LAST, i.e. in FRONT of the card it is
// supposed to sit behind.

Component NotifStack {
    Stack {
        NotifCard {
            appId: "chat",
            app: @t("notif.mail"),
            time: @t("notif.t5min"),
            title: @t("notif.mailTitle"),
            body: @t("notif.mailBody"),
            badge: @t("notif.mailCount"),
        }
        Stack {
            Stack { }
                .height(10)
                .rounded(10)
                .material(card)
                .opacity(190)
        }
        .paddingX(2)
    }
    .gap(0)
}
