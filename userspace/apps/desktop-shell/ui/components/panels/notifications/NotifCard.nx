//
// One notification card (design artifacts: panels NCard): a 40 px app icon (a
// baked size, radius 12, shadow2) and a text column — app name · relative time
// · title · one-line body — on a `card` of radius 16 with shadow1. An optional
// action row (`act1` / `act2` non-empty) sits under the text, inset by the icon
// and the gap (4 + a 40 px spacer + 8 = the design's 52 px): two secondary buttons that both dismiss the card
// (`Dismiss(kind)`).
//
// `badge` non-empty pins a counter to the icon's top-right through a contained
// `.overlay()`: the layer fills the icon box and ordinary flex puts the badge in
// its corner. The design's 4 px overhang past the icon is not reachable (no
// offset / negative margin), so the badge sits just inside.
//
// The body is one line; a longer one is cut with an ellipsis. The card itself
// is not interactive (no hover layer) — only its buttons are.
//
// Times are RELATIVE words, never clock times: a wall-clock stamp on a card the
// shell cannot refresh would age visibly.

Component NotifAction {
    props: {
        text: Str,
    }
    Stack {
        Text($props.text).textStyle(footnote).fontWeight(medium).fg(label)
    }
    .grow(1)
    .height(30)
    .align(center)
    .justify(center)
    .rounded(full)
    .bg(fill)
    .border(hairline)
    .borderColor(separator)
}

Component NotifCard {
    props: {
        kind: Str,
        appId: Str,
        app: Str,
        time: Str,
        title: Str,
        body: Str,
        badge: Str,
        act1: Str,
        act2: Str,
    }
    Stack {
        Stack {
            if $props.badge != "" {
                Stack {
                    Image { source: $props.appId, size: 40 }
                    Stack {
                        Stack {
                            Spacer
                            CountBadge { count: $props.badge }
                        }
                        .direction(row)
                        Spacer
                    }
                    .overlay()
                }
                .width(40)
                .height(40)
                .shrink(0)
            } else {
                Stack {
                    Image { source: $props.appId, size: 40 }
                }
                .width(40)
                .height(40)
                .shrink(0)
            }
            Stack {
                Stack {
                    Text($props.app).textStyle(caption).fontWeight(semibold).fg(label)
                    Spacer
                    Text($props.time).textStyle(caption2).fontWeight(normal).fg(labelSecondary)
                }
                .direction(row)
                .align(center)
                .gap(8)
                .paddingBottom(2)
                Text($props.title).textStyle(footnote).fontWeight(semibold).fg(label)
                Text($props.body).textStyle(caption).fontWeight(normal).fg(labelSecondary)
            }
            .gap(0)
            .grow(1)
            .minWidth(0)
            .direction(column)
        }
        .direction(row)
        .align(start)
        .gap(12)
        if $props.act1 != "" {
            Stack {
                Stack { }
                    .width(40)
                    .shrink(0)
                Stack {
                    NotifAction { text: $props.act1 }
                }
                .direction(row)
                .grow(1)
                on Tap -> dispatch(Dismiss($props.kind))
                Stack {
                    NotifAction { text: $props.act2 }
                }
                .direction(row)
                .grow(1)
                on Tap -> dispatch(Dismiss($props.kind))
            }
            .direction(row)
            .gap(8)
            .paddingTop(8)
            .paddingLeading(4)
        } else {
            Stack { }
        }
    }
    .gap(0)
    .padding(12)
    .rounded(16)
    .material(card)
    .shadow(shadow1)
}
