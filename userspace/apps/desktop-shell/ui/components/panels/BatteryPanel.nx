//
// Batterie/Energie panel (design artifacts: panels §6): 300 wide, radius xl 24, top
// right, DESKTOP mode only. Charge readout, energy profile, standby inhibit.
//
// Charge and power source are literals, not store fields: nothing measures
// them, and a field would dress a constant up as a reading. The profile and
// "Kein Standby" ARE state — they are choices made here — and they live in
// `SystemStore` as demo state until a power service exists.
//
// Exactly three profiles, per the design. A fourth would be an invention.

Component BatteryPanel {
    Stack {
        Stack {
            SectionTitle { label: @t("panels.battery") }
            Spacer
            Text(@t("control.batteryPct")).textStyle(subheadline).fontWeight(bold).fg(label)
        }
        .direction(row)
        .align(center)
        .paddingX(2)
        .paddingBottom(4)
        Stack {
            Icon { symbol: "battery.0", size: 14 }
                .fg(success)
            Stack {
                Meter { percent: 78 }
            }
            .grow(1)
            Text(@t("battery.source")).textStyle(caption).fg(labelSecondary)
        }
        .direction(row)
        .align(center)
        .gap(8)
        .paddingX(16)
        .paddingY(12)
        .rounded(16)
        .material(card)
        GroupLabel { label: @t("battery.profile") }
        Stack {
            Stack {
                RadioRow { label: @t("battery.saver"), sub: @t("battery.saverSub"), icon: "leaf", bars: 0, locked: false, active: $state.powerProfile == "saver" }
            }
            .direction(row)
            on Tap -> dispatch(PickProfile("saver"))
            Stack {
                RadioRow { label: @t("battery.balanced"), sub: @t("battery.balancedSub"), icon: "scale", bars: 0, locked: false, active: $state.powerProfile == "balanced" }
            }
            .direction(row)
            on Tap -> dispatch(PickProfile("balanced"))
            Stack {
                RadioRow { label: @t("battery.performance"), sub: @t("battery.performanceSub"), icon: "bolt", bars: 0, locked: false, active: $state.powerProfile == "performance" }
            }
            .direction(row)
            on Tap -> dispatch(PickProfile("performance"))
        }
        .padding(4)
        .rounded(16)
        .material(card)
        Stack {
            Stack {
                ToggleTile {
                    icon: "clock",
                    label: @t("battery.noStandby"),
                    subOn: @t("battery.noStandbyOn"),
                    subOff: @t("battery.noStandbyOff"),
                    tint: "modeAirplane",
                    active: $state.noStandby,
                }
            }
            .direction(row)
            on Tap -> dispatch(ToggleNoStandby)
        }
        .padding(12)
        .rounded(16)
        .material(card)
    }
    .width(300)
    .gap(8)
    .paddingX(16)
    .paddingTop(8)
    .paddingBottom(16)
    .rounded(xl)
    .material(panel)
    .transition(slideDown)
}
