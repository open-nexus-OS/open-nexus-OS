//
// Control Center (design artifacts: panels §3): 328 wide, radius xl 24, anchored top
// right. The touch modes' one hub — in tablet/phone the WiFi, Ton and Batterie
// panels do not exist and their contents fold in here, which is why this is
// the only panel present in every mode.
//
// Two things here are REAL and everything else is drawn state: the
// Ansichtsmodus tile writes `ui.shell.mode` and the Erscheinungsbild button
// writes `ui.theme.mode`. Both go through `svc.settings.set` in
// `ControlStore`, and both read their current value from `device.*` so a
// re-mount cannot leave them showing the wrong side of the switch.
//
// Section order and spacing are the design's (padding 8/16/16, 12 between the
// blocks). The panel STAYS GLASS (operator decision): `panel` material — regular
// blur, glass edge, shadow4 and the lit top edge come from the recipe — and the
// cards on it are `card` layers. The now-playing card shows only while a
// media session plays (none exists yet, so it is absent — no demo claim).

Component ControlCenterPanel {
    Stack {
        CcHeader { }
        CcConnectivity { }
        CcBrightnessCard { }
        CcSoundCard { label: @t("control.sound") }
        if $state.nowPlaying {
            CcNowPlayingCard { }
        } else {
            Stack { }
        }
        CcBatteryCard { }
        if $state.applyError != 0 {
            Text(@t("control.applyFailed")).textStyle(caption).fg(danger)
        } else {
            Stack { }
        }
    }
    .width(328)
    .gap(12)
    .paddingX(16)
    .paddingTop(8)
    .paddingBottom(16)
    .rounded(xl)
    .material(panel)
    .transition(slideUp)
}
