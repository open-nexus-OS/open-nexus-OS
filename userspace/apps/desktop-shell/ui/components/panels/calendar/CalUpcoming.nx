//
// The coming appointments (design artifacts: panels §5, "Anstehend"): at most
// three cards, each a 3×32 spine in the event's tint role and a title / when
// column. DEMO DATA, like the month grids — no calendar service exists.

Component CalEventRow {
    props: {
        title: Str,
        when: Str,
        tint: Str,
    }
    Stack {
        Stack { }
            .width(3)
            .height(32)
            .rounded(full)
            .bg($props.tint)
        Stack {
            Text($props.title).textStyle(footnote).fontWeight(semibold).fg(label)
            Text($props.when).textStyle(caption).fontWeight(normal).fg(labelSecondary)
        }
        .gap(2)
        .grow(1)
        .minWidth(0)
    }
    .direction(row)
    .align(center)
    .gap(12)
    .paddingX(12)
    .paddingY(8)
    .rounded(12)
    .material(card)
}

Component CalUpcoming {
    Stack {
        CalEventRow { title: @t("cal.ev1"), when: @t("cal.ev1When"), tint: "danger" }
        CalEventRow { title: @t("cal.ev2"), when: @t("cal.ev2When"), tint: "accent" }
        CalEventRow { title: @t("cal.ev3"), when: @t("cal.ev3When"), tint: "modeTablet" }
    }
    .gap(8)
}
