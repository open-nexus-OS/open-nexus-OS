//
// The month BEFORE the demo month. No today marker and no appointments: the
// demo data lives in the current month, and inventing events here would
// make paging look like it queried something.
//
// AUTHORED, not computed. The DSL has no date arithmetic and a reducer cannot
// build a list, so a month grid cannot be derived from a clock — it has to be
// written down. `CalStore.calMonth` selects between three such months; see
// `calendar.store.nx` for why three is the honest number.
//
// Monday-first weeks with leading and trailing blanks, so every row is seven
// cells and the columns hold against the weekday header.

Component CalMonthPrev {
    Stack {
        Stack {
            CalCell { label: "1", today: false, event: false }
            CalCell { label: "2", today: false, event: false }
            CalCell { label: "3", today: false, event: false }
            CalCell { label: "4", today: false, event: false }
            CalCell { label: "5", today: false, event: false }
            CalCell { label: "6", today: false, event: false }
            CalCell { label: "7", today: false, event: false }
        }
        .direction(row)
        Stack {
            CalCell { label: "8", today: false, event: false }
            CalCell { label: "9", today: false, event: false }
            CalCell { label: "10", today: false, event: false }
            CalCell { label: "11", today: false, event: false }
            CalCell { label: "12", today: false, event: false }
            CalCell { label: "13", today: false, event: false }
            CalCell { label: "14", today: false, event: false }
        }
        .direction(row)
        Stack {
            CalCell { label: "15", today: false, event: false }
            CalCell { label: "16", today: false, event: false }
            CalCell { label: "17", today: false, event: false }
            CalCell { label: "18", today: false, event: false }
            CalCell { label: "19", today: false, event: false }
            CalCell { label: "20", today: false, event: false }
            CalCell { label: "21", today: false, event: false }
        }
        .direction(row)
        Stack {
            CalCell { label: "22", today: false, event: false }
            CalCell { label: "23", today: false, event: false }
            CalCell { label: "24", today: false, event: false }
            CalCell { label: "25", today: false, event: false }
            CalCell { label: "26", today: false, event: false }
            CalCell { label: "27", today: false, event: false }
            CalCell { label: "28", today: false, event: false }
        }
        .direction(row)
        Stack {
            CalCell { label: "29", today: false, event: false }
            CalCell { label: "30", today: false, event: false }
            CalCell { label: "", today: false, event: false }
            CalCell { label: "", today: false, event: false }
            CalCell { label: "", today: false, event: false }
            CalCell { label: "", today: false, event: false }
            CalCell { label: "", today: false, event: false }
        }
        .direction(row)
    }
    .gap(0)
}
