// One day cell (design artifacts: panels §5, CalendarView): the number circle
// (`CalDay`) with a 4 px dot row beneath it. Selection: today is selected by
// default and a tap only moves the highlight (`CalStore.calSel`); a day of the
// neighbouring month (`out`) is inert. The dot's height is reserved even
// without a dot, so months with and without appointments are equally tall; the
// dot takes the event's tint role (`tint`).

Component CalDot {
    props: {
        tint: Str,
        dim: Bool,
    }
    if $props.tint != "" {
        if $props.dim {
            Circle { size: 4 }
                .bg($props.tint)
                .opacity(115)
        } else {
            Circle { size: 4 }
                .bg($props.tint)
        }
    } else {
        Stack { }
            .height(4)
    }
}

Component CalCell {
    props: {
        label: Str,
        day: Int,
        today: Bool,
        out: Bool,
        tint: Str,
    }
    if $props.out {
        Stack {
            CalDay { label: $props.label, selected: false, today: false, out: true }
            CalDot { tint: $props.tint, dim: true }
        }
        .grow(1)
        .align(center)
        .gap(2)
        .paddingBottom(2)
    } else {
        Stack {
            CalDay { label: $props.label, selected: $state.calSel == $props.day && $state.calSelMonth == $state.calMonth, today: $props.today, out: false }
            CalDot { tint: $props.tint, dim: false }
        }
        .grow(1)
        .align(center)
        .gap(2)
        .paddingBottom(2)
        on Tap -> dispatch(CalSelect($props.day))
    }
}
