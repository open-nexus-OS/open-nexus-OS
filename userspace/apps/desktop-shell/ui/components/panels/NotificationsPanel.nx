//
// Mitteilungszentrale (design artifacts: panels §4): 330 wide, radius xl 24,
// anchored top left, padding 12. The panel STAYS GLASS (`panel` material); its
// content is `notifications/NotificationsBody` — title row with "Alle löschen",
// the "Wichtig" tier (stacked mail card, Nachrichten, Kalender) and the
// collapsible "Lautlos" tier (Wetter, Plaza), or the empty state.
//
// DEMO CONTENT — no notification service feeds the shell yet; the dismissals
// are real. See `notifications.store.nx`.

Component NotificationsPanel {
    Stack {
        NotificationsBody { sheet: false }
    }
    .width(330)
    .padding(12)
    .rounded(xl)
    .material(panel)
    .transition(slideDown)
}
