//
// Mitteilungszentrale (design_handoff_panels §4): 330 wide, radius 26,
// anchored top left. Header with "Alle löschen", the stacked mail card, then
// individual cards.
//
// DEMO CONTENT — no notification service feeds the shell yet. The cards are
// authored markup and "Alle löschen" flips one flag to the empty state, which
// is the whole interaction. When `svc.notif` lands, the `if` below becomes a
// `List` over real notifications and this file barely changes: that is why the
// card is already its own component taking props rather than inline markup.

Component NotificationsPanel {
    Stack {
        Stack {
            SectionTitle { label: @t("panels.notifications") }
            Spacer
            Stack {
                Text(@t("notif.clearAll")).textSize(xs).fg(onGlassMuted)
            }
            .paddingX(2)
            .paddingY(1)
            .rounded(8)
            .hitSlop(2)
            on Tap -> dispatch(ClearAll)
        }
        .direction(row)
        .align(center)
        .paddingX(1)
        if $state.notifCleared {
            Stack {
                Text(@t("notif.empty")).textSize(xs).fg(onGlassMuted)
            }
            .align(center)
            .justify(center)
            .paddingY(6)
        } else {
            Stack {
                NotifStack { }
                NotifCard {
                    appId: "chat",
                    app: @t("notif.messages"),
                    time: @t("notif.t12min"),
                    title: @t("notif.msgTitle"),
                    body: @t("notif.msgBody"),
                    badge: "",
                }
                NotifCard {
                    appId: "settings",
                    app: @t("notif.calendar"),
                    time: @t("notif.t1h"),
                    title: @t("notif.calTitle"),
                    body: @t("notif.calBody"),
                    badge: "",
                }
                NotifCard {
                    appId: "settings",
                    app: @t("notif.weather"),
                    time: @t("notif.t2h"),
                    title: @t("notif.wxTitle"),
                    body: @t("notif.wxBody"),
                    badge: "",
                }
            }
            .gap(2)
        }
    }
    .width(330)
    .gap(3)
    .padding(3)
    .rounded(26)
    .material(panel)
    .shadow(xxl)
    .transition(slideDown)
}
