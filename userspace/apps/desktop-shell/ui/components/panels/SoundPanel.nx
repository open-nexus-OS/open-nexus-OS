//
// Ton panel (design_handoff_panels §6): 300 wide, radius 30, top right,
// DESKTOP mode only. Output devices, input devices, and the SAME volume card
// the Control Center shows — `CcSoundCard` is reused verbatim rather than
// re-drawn, which is what makes "ein gemeinsamer Lautstärke-Zustand" true by
// construction instead of by discipline.
//
// The device lists are DEMO DATA: picking moves the check, no audio service is
// touched.

Component SoundPanel {
    Stack {
        Stack {
            SectionTitle { label: @t("panels.sound") }
        }
        .paddingX(1)
        GroupLabel { label: @t("sound.output") }
        Stack {
            Stack {
                RadioRow { label: @t("sound.out.speakers"), sub: @t("sound.builtin"), icon: "speaker.wave", bars: 0, locked: false, active: $state.outputDevice == "speakers" }
            }
            on Tap -> dispatch(PickOutput("speakers"))
            Stack {
                RadioRow { label: @t("sound.out.headphones"), sub: @t("sound.bluetooth"), icon: "speaker.wave", bars: 0, locked: false, active: $state.outputDevice == "headphones" }
            }
            on Tap -> dispatch(PickOutput("headphones"))
            Stack {
                RadioRow { label: @t("sound.out.display"), sub: @t("sound.external"), icon: "speaker.wave", bars: 0, locked: false, active: $state.outputDevice == "display" }
            }
            on Tap -> dispatch(PickOutput("display"))
        }
        .padding(1)
        .rounded(20)
        .material(card)
        GroupLabel { label: @t("sound.input") }
        Stack {
            Stack {
                RadioRow { label: @t("sound.in.internal"), sub: @t("sound.builtin"), icon: "mic", bars: 0, locked: false, active: $state.inputDevice == "micInternal" }
            }
            on Tap -> dispatch(PickInput("micInternal"))
            Stack {
                RadioRow { label: @t("sound.in.external"), sub: @t("sound.usb"), icon: "mic", bars: 0, locked: false, active: $state.inputDevice == "micExternal" }
            }
            on Tap -> dispatch(PickInput("micExternal"))
        }
        .padding(1)
        .rounded(20)
        .material(card)
        CcSoundCard { }
    }
    .width(300)
    .gap(2)
    .paddingX(4)
    .paddingTop(3)
    .paddingBottom(4)
    .rounded(30)
    .material(panel)
    .shadow(xxl)
    .transition(slideDown)
}
