//
// The Erscheinungsbild button (design artifacts: panels): a 36 px prominent circle
// beside the brightness slider that switches the theme. Light shows a sun on a
// flat `warning` fill, dark a moon on a flat `modeTablet` fill — the glyph names
// what a tap switches TO the other side of, the fill the current theme.
// Real: it writes `ui.theme.mode` through `ControlStore`.

Component AppearanceButton {
    if device.theme == dark {
        Circle { size: 36
            Icon { symbol: "moon", size: 15 }
                .fg(onAccent)
        }
        .bg(modeTablet)
        .shadow(shadow1)
        .hitSlop(8)
        .label(@t("control.appearance"))
        on Tap -> dispatch(SetTheme("light"))
    } else {
        Circle { size: 36
            Icon { symbol: "sun.max", size: 15 }
                .fg(onAccent)
        }
        .bg(warning)
        .shadow(shadow1)
        .hitSlop(8)
        .label(@t("control.appearance"))
        on Tap -> dispatch(SetTheme("dark"))
    }
}
