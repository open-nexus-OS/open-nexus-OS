//
// A panel's own heading (design artifacts: panels title row): "Mitteilungen",
// "WLAN", "Ton", "Batterie" — headline (15/20/600) in `label`. The largest
// type in any panel.

Component SectionTitle {
    props: {
        label: Str,
    }
    Text($props.label).textStyle(headline).fg(label)
}
