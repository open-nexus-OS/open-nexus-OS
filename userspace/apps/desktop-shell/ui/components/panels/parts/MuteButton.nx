//
// The mute button (design artifacts: panels): the 36 px circle beside every
// volume slider. Muted is the `danger` fill with a struck-through speaker (the
// danger fill only — no grey layer over it); not muted is a glass circle
// (`card` + shadow1).
//
// Muted IS `volume == 0` — one field in `ControlStore` backs Control Center,
// the Sound panel and the top bar, so the three can never disagree. Un-muting
// restores the volume from before muting (`preMuteVolume`, or 50).

Component MuteButton {
    if $state.volume == 0 {
        Circle { size: 36
            Icon { symbol: "speaker.slash", size: 15 }
                .fg(onAccent)
        }
        .bg(danger)
        .shadow(shadow1)
        .hitSlop(8)
        on Tap -> dispatch(ToggleMute)
    } else {
        Circle { size: 36
            Icon { symbol: "speaker.wave", size: 15 }
                .fg(label)
        }
        .material(card)
        .shadow(shadow1, edgeHighlight)
        .hitSlop(8)
        on Tap -> dispatch(ToggleMute)
    }
}
