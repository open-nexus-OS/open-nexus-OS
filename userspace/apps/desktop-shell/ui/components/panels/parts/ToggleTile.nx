//
// The toggle tile (design artifacts: panels tile): a 116×45 chip with a 26 px
// icon circle and a two-line text column — label plus a SUB-LABEL that states
// the tile's state in words (`subOn`/`subOff`, so no call site branches to word
// it). Control Center uses four, WLAN one ("Nur Kabel"), Batterie one ("Kein
// Standby"). The sub-label may truncate with an ellipsis at this width (accepted); the label
// may not: the icon↔label gap is 6 (the grid's icon-to-label step), not the artifact's 8, because
// the baked atlas advances are whole pixels and "Flugmodus" needs the 2 px the artifact's
// fractional advances save.
//
// ON is a flat tint wash of a colour ROLE: `tint` names it (`accent`,
// `modeAirplane`, `modeDesktop`, `modeTablet`) and `.bg($props.tint)` resolves it,
// so the tile re-themes. The ink is `onAccent` (white on every mode tint).
// OFF rests on `background` in the light theme and on `fill` in the dark one,
// with a glass edge and `shadow1` — the face is shared (`TileFace`), only the
// resting fill differs. Hover is the compositor's wash over the tile; it never
// repaints it.

Component TileFace {
    props: {
        icon: Str,
        label: Str,
        sub: Str,
    }
    Stack {
        Circle { size: 26
            Icon { symbol: $props.icon, size: 13 }
                .fg(labelSecondary)
        }
        .bg(fill)
        .shrink(0)
        Stack {
            Text($props.label).textStyle(caption).fontWeight(semibold).fg(label)
            Text($props.sub).textStyle(caption2).fontWeight(normal).fg(labelSecondary)
        }
        .gap(0)
        .grow(1)
        .minWidth(0)
        .direction(column)
    }
    .direction(row)
    .align(center)
    .gap(6)
}

Component ToggleTile {
    props: {
        icon: Str,
        label: Str,
        subOn: Str,
        subOff: Str,
        tint: Str,
        active: Bool,
    }
    if $props.active {
        Stack {
            Circle { size: 26
                Icon { symbol: $props.icon, size: 13 }
                    .fg(onAccent)
            }
            .tint(onAccent, border)
            .shrink(0)
            Stack {
                Text($props.label).textStyle(caption).fontWeight(semibold).fg(onAccent)
                Text($props.subOn).textStyle(caption2).fontWeight(normal).fg(onAccent).opacity(191)
            }
            .gap(0)
            .grow(1)
            .minWidth(0)
            .direction(column)
        }
        .direction(row)
        .align(center)
        .gap(6)
        .paddingX(12)
        .paddingY(8)
        .rounded(12)
        .bg($props.tint)
        .shadow(shadow1, edgeHighlight)
    } else if device.theme == dark {
        Stack {
            TileFace { icon: $props.icon, label: $props.label, sub: $props.subOff }
        }
        .paddingX(12)
        .paddingY(8)
        .rounded(12)
        .bg(fill)
        .border(hairline)
        .borderColor(glassEdge)
        .shadow(shadow1, edgeHighlight)
    } else {
        Stack {
            TileFace { icon: $props.icon, label: $props.label, sub: $props.subOff }
        }
        .paddingX(12)
        .paddingY(8)
        .rounded(12)
        .bg(background)
        .border(hairline)
        .borderColor(glassEdge)
        .shadow(shadow1, edgeHighlight)
    }
}
