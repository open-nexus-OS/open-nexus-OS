//
// The label ABOVE a card (design artifacts: panels group label): "Verfügbare
// Netzwerke", "Ausgabe", "Energieprofil", "Anstehend". Caption in
// `labelSecondary`, inset 4 px from the card's edge so it reads as a caption
// for the group rather than a row inside it; 4 px of extra space above (on
// top of the panel's gap) separate it from the block before.

Component GroupLabel {
    props: {
        label: Str,
    }
    Stack {
        Text($props.label).textStyle(caption).fg(labelSecondary)
    }
    .paddingX(4)
    .paddingTop(4)
}
