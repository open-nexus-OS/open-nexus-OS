//
// The counter badge (design artifacts: panels badge) on the stacked mail card: a
// `danger` capsule, at least 18×18, with a bold white count in caption2.

Component CountBadge {
    props: {
        count: Str,
    }
    Stack {
        Text($props.count).textStyle(caption2).fontWeight(bold).fg(onAccent)
    }
    .minWidth(18)
    .height(18)
    .paddingX(4)
    .align(center)
    .justify(center)
    .rounded(full)
    .bg(danger)
    .shadow(shadow1)
}
