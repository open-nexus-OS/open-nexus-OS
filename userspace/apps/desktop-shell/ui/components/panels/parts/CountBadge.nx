//
// The counter badge (design_handoff_panels `.n-badge`) on the stacked mail
// card: a red capsule with a white count. The vertical `#ff5b52 → #ff3b30`
// gradient is the handoff's literal — a badge is a fixed system colour in
// every theme, so it does not go through a role.

Component CountBadge {
    props: {
        count: Str,
    }
    Stack {
        Text($props.count).textSize(xs).fontWeight(bold).leading(flat).fg(onInfo)
    }
    .minWidth(19)
    .height(19)
    .paddingX(1)
    .align(center)
    .justify(center)
    .rounded(10)
    .bgGradient("#ff5b52", "#ff3b30")
    .shadow(sm)
}
