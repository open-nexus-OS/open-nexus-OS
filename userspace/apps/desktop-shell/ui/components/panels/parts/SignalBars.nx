//
// WiFi signal strength (design artifacts: panels bars): three 3 px bars rising
// 7 · 10 · 13, bottom-aligned; the bars above the level are unlit (`fill`)
// rather than hidden — the silhouette stays the same at every strength, so a
// list of networks does not jitter as levels differ.
//
// Drawn from `Stack` primitives because the icon set has no level variants.

Component SignalBars {
    props: {
        level: Int,
    }
    Stack {
        Stack { }
            .width(3)
            .height(7)
            .rounded(1)
            .bg(label)
        if $props.level > 1 {
            Stack { }
                .width(3)
                .height(10)
                .rounded(1)
                .bg(label)
        } else {
            Stack { }
                .width(3)
                .height(10)
                .rounded(1)
                .bg(fill)
        }
        if $props.level > 2 {
            Stack { }
                .width(3)
                .height(13)
                .rounded(1)
                .bg(label)
        } else {
            Stack { }
                .width(3)
                .height(13)
                .rounded(1)
                .bg(fill)
        }
    }
    .direction(row)
    .align(end)
    .gap(4)
    .height(13)
}
