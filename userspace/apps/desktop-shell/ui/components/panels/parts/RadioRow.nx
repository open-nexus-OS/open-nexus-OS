//
// A radio row (design artifacts: panels list item, v3 ListItem translation): one
// choice in a card, 40 px high, padding 8/16, gap 12. Leading is the signal
// bars (WLAN) or a 16 px glyph; the title is body 14 medium, the optional
// subtitle footnote in `labelSecondary`; the selected row shows a 16 px accent
// checkmark and nothing else (no row fill) — the unselected rows reserve the
// slot, so titles never shift. A network without a lock reserves the lock's
// slot too, which keeps the bars and titles aligned.

Component RadioRow {
    props: {
        label: Str,
        sub: Str,
        icon: Str,
        bars: Int,
        locked: Bool,
        active: Bool,
    }
    Stack {
        Stack {
            if $props.bars > 0 {
                SignalBars { level: $props.bars }
            } else {
                Icon { symbol: $props.icon, size: 16 }
                    .fg(label)
            }
            if $props.locked {
                Icon { symbol: "lock", size: 11 }
                    .fg(labelSecondary)
            } else {
                if $props.bars > 0 {
                    Stack { }
                        .width(11)
                } else {
                    Stack { }
                }
            }
        }
        .direction(row)
        .align(center)
        .gap(4)
        .shrink(0)
        Stack {
            Text($props.label).textStyle(body).fontWeight(medium).fg(label)
            if $props.sub != "" {
                Text($props.sub).textStyle(footnote).fg(labelSecondary)
            } else {
                Stack { }
            }
        }
        .gap(0)
        .grow(1)
        .minWidth(0)
        .direction(column)
        if $props.active {
            Icon { symbol: "checkmark", size: 16 }
                .fg(accent)
        } else {
            Stack { }
                .width(16)
        }
    }
    .direction(row)
    .align(center)
    .gap(12)
    .minHeight(40)
    .paddingX(16)
    .paddingY(8)
    .rounded(12)
    .hitSlop(4)
}
