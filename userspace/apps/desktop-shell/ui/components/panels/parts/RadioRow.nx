//
// The radio row (design_handoff_panels `.rrow`) — one choice in a
// single-selection list: WiFi networks, audio devices, energy profiles. Only
// the ACTIVE row shows the blue check; the others reserve nothing for it, the
// row simply ends.
//
// The leading slot is either a glyph or WiFi signal bars, so `bars` (0 = use
// `icon`, 1..3 = a bar level) picks between them instead of a slot. That keeps
// the whole list one component; a slot here would make every call site in
// three panels carry a body just to choose between two shapes.
//
// The active tint is the handoff's `rgba(59,130,246,.18)` as a literal. It is
// list-selection blue in both themes — deliberately not the user's accent,
// because a selected network must not restyle itself when someone picks a
// green accent in Settings.

Component RadioRow {
    props: {
        label: Str,
        sub: Str,
        icon: Str,
        bars: Int,
        locked: Bool,
        active: Bool,
    }
    Stack {
        Stack {
            if $props.bars > 0 {
                SignalBars { level: $props.bars }
            } else {
                Icon { symbol: $props.icon, size: 14 }
                    .fg(onGlass)
            }
            if $props.locked {
                Icon { symbol: "lock", size: 11 }
                    .fg(onGlassMuted)
            } else {
                Stack { }
            }
        }
        .direction(row)
        .align(center)
        .gap(1)
        .shrink(0)
        Stack {
            if $props.active {
                Text($props.label).textSize(sm).fontWeight(semibold).leading(tight).fg(onGlass)
            } else {
                Text($props.label).textSize(sm).leading(tight).fg(onGlass)
            }
            if $props.sub != "" {
                Text($props.sub).textSize(xs).leading(tight).fg(onGlassMuted)
            } else {
                Stack { }
            }
        }
        .gap(0)
        .grow(1)
        .minWidth(0)
        .direction(column)
        if $props.active {
            Icon { symbol: "checkmark", size: 14 }
                .fg(info)
        } else {
            Stack { }
        }
    }
    .direction(row)
    .align(center)
    .gap(2)
    .padding(2)
    .rounded(11)
    .hitSlop(1)
}
