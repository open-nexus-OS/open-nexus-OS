//
// The launcher store (TASK-0080B): the installed-app list comes from the
// REAL registry surface (`svc.bundlemgr.enumerate`, bundlemgrd ENUMERATE) —
// filtering happens AT the service (the shell sends the query; the registry
// matches), so search-as-you-type is the canonical async recipe: every
// keystroke re-dispatches Refresh and stale responses are dropped by the
// per-(event,case) generation rule. Launching goes through the launch
// authority (`svc.ability.launch`, abilitymgr fail-closed) — the shell only
// ASKS; abilitymgr decides.

Store LauncherStore {
    apps: List<AppEntry> = [],
    query: Str = "",
    loading: Bool = false,
    lastError: Int = 0,
    launching: Str = "",
    clock: Str = "--:--",
    date: Str = "",
    // The fullscreen pager's ACTIVE page (design_handoff_launcher §11).
    // Wheel turns arrive as host-fired PageNext/PagePrev triggers (the host
    // only fires when a turn actually happened, so ±1 stays in range); a dot
    // tap SETS the page and the effect glides the viewport there.
    page: Int = 0,
}

// RFC-0076: host-driven minute tick (tz-converted wall time; "--:--" until
// walltime anchors — never a fake time).
Event ClockEvent {
    Tick(Str, Str),
}

reduce ClockEvent {
    Tick(time, date) => {
        state.clock = time;
        state.date = date;
    },
}

Event LauncherEvent {
    Refresh,
    Loaded(List<AppEntry>),
    LoadFailed(Int),
    QueryChanged,
    Launch(Str),
    LaunchDone(Bool),
    LaunchFailed(Int),
    Activate(Str),
    ActivateDone(Bool),
    WindowsMoved,
    PageNext,
    PagePrev,
    SetPage(Int),
    PageSynced(Bool),
    PageSyncFailed(Int),
}

reduce LauncherEvent {
    Refresh => state.loading = true,
    Loaded(apps) => {
        state.apps = apps;
        state.loading = false;
        state.lastError = 0;
    },
    LoadFailed(code) => {
        state.lastError = code;
        state.loading = false;
    },
    QueryChanged => state.loading = true,
    Launch(id) => state.launching = id,
    LaunchDone(ok) => state.launching = "",
    LaunchFailed(code) => {
        state.launching = "";
        state.lastError = code;
    },
    Activate(id) => state.launching = id,
    ActivateDone(ok) => state.launching = "",
    WindowsMoved => state.lastError = 0,
    PageNext => state.page = state.page + 1,
    PagePrev => state.page = state.page - 1,
    SetPage(i) => state.page = i,
    PageSynced(ok) => state.page = state.page,
    PageSyncFailed(code) => state.lastError = code,
}

@effect on Refresh {
    match svc.bundlemgr.enumerate(state.query, timeoutMs: 250) {
        Ok(apps) => dispatch(Loaded(apps)),
        Err(e) => dispatch(LoadFailed(e)),
    }
}

@effect on QueryChanged {
    match svc.bundlemgr.enumerate(state.query, timeoutMs: 250) {
        Ok(apps) => dispatch(Loaded(apps)),
        Err(e) => dispatch(LoadFailed(e)),
    }
}

@effect on Launch(id) {
    match svc.ability.launch(id, timeoutMs: 500) {
        Ok(ok) => dispatch(LaunchDone(ok)),
        Err(e) => dispatch(LaunchFailed(e)),
    }
}

// RFC-0086: the compositor's window set moved — re-read the registry so the
// merged running/minimized/focused flags reach the tiles. A SEPARATE event
// from `Refresh` on purpose: `Refresh` is dispatched by NOTHING, which is
// exactly what makes it the ROOT effect that loads the app list at mount
// (docs/dev/dsl/state.md). Dispatching it from a handler would silently turn
// the initial load off.
@effect on WindowsMoved {
    match svc.bundlemgr.enumerate(state.query, timeoutMs: 250) {
        Ok(apps) => dispatch(Loaded(apps)),
        Err(e) => dispatch(LoadFailed(e)),
    }
}

// Taskbar/dock tile tap (RFC-0086): bring the app forward. The app-host
// decides HOW — restore/raise via windowd when a window of this app is
// running, else a normal launch — so the shell never duplicates that state
// machine.
@effect on Activate(id) {
    match svc.shell.activate(id, timeoutMs: 200) {
        Ok(ok) => dispatch(ActivateDone(ok)),
        Err(e) => dispatch(LaunchFailed(e)),
    }
}

// Dot tap: the reducer already set `state.page`; this glides the paged
// viewport there (in-process app-host verb — NO PageNext/PagePrev fires for
// an effect-driven move, so the page cannot double-count).
@effect on SetPage(i) {
    match svc.shell.scrollToPage(i, timeoutMs: 50) {
        Ok(ok) => dispatch(PageSynced(ok)),
        Err(e) => dispatch(PageSyncFailed(e)),
    }
}
