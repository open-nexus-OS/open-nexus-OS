//
// The notification centre's state: which demo cards are dismissed, and whether
// the "Lautlos" tier is expanded.
//
// DEMO DATA — there is no notification service feeding the shell yet, so the
// five cards are authored markup and each carries one dismissed flag (a reducer
// cannot filter or shrink a list). `ClearAll` sets every flag; a card's action
// buttons dismiss that card. When `svc.notif` lands, the flags become a real
// collection and the panel's `if`s become a `List`.
//
// The silent tier is expanded in the desktop panel (`silentOpen`) and collapsed
// in the touch sheet (`sheetSilentOpen`) — two fields, because the panel and
// the sheet are never on screen together but each remembers its own state.

Store NotifStore {
    mailGone: Bool = false,
    msgGone: Bool = false,
    calGone: Bool = false,
    wxGone: Bool = false,
    plazaGone: Bool = false,
    // True once nothing is left — the top bar's bell reads it (unread dot, count).
    notifCleared: Bool = false,
    silentOpen: Bool = true,
    sheetSilentOpen: Bool = false,
}

Event NotifEvent {
    ClearAll,
    Dismiss(Str),
    ToggleSilent,
    ToggleSheetSilent,
}

reduce NotifEvent {
    ClearAll => {
        state.mailGone = true;
        state.msgGone = true;
        state.calGone = true;
        state.wxGone = true;
        state.plazaGone = true;
        state.notifCleared = true;
    },
    Dismiss(card) => {
        if card == "mail" {
            state.mailGone = true;
        } else if card == "msg" {
            state.msgGone = true;
        } else if card == "cal" {
            state.calGone = true;
        } else if card == "wx" {
            state.wxGone = true;
        } else if card == "plaza" {
            state.plazaGone = true;
        }
        if state.mailGone && state.msgGone && state.calGone && state.wxGone && state.plazaGone {
            state.notifCleared = true;
        }
    },
    ToggleSilent => {
        if state.silentOpen {
            state.silentOpen = false;
        } else {
            state.silentOpen = true;
        }
    },
    ToggleSheetSilent => {
        if state.sheetSilentOpen {
            state.sheetSilentOpen = false;
        } else {
            state.sheetSilentOpen = true;
        }
    },
}
